{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ooxp.local/schema/v1/request.json",
  "title": "ooxp 领域请求",
  "type": "object",
  "required": ["schemaVersion", "action"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "action": { "enum": ["inspect", "create", "apply", "exportMedia", "exportChartData"] }
  },
  "allOf": [
    {
      "if": {
        "properties": { "action": { "const": "inspect" } },
        "required": ["action"]
      },
      "then": { "$ref": "#/$defs/inspectRequest" }
    },
    {
      "if": {
        "properties": { "action": { "const": "create" } },
        "required": ["action"]
      },
      "then": { "$ref": "#/$defs/createRequest" }
    },
    {
      "if": {
        "properties": { "action": { "const": "apply" } },
        "required": ["action"]
      },
      "then": { "$ref": "#/$defs/applyRequest" }
    },
    {
      "if": {
        "properties": { "action": { "const": "exportMedia" } },
        "required": ["action"]
      },
      "then": { "$ref": "#/$defs/exportMediaRequest" }
    },
    {
      "if": {
        "properties": { "action": { "const": "exportChartData" } },
        "required": ["action"]
      },
      "then": { "$ref": "#/$defs/exportChartDataRequest" }
    }
  ],
  "$defs": {
    "format": { "enum": ["xlsx", "docx", "pptx"] },
    "inspectRequest": {
      "type": "object",
      "required": ["schemaVersion", "action", "path"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "action": { "const": "inspect" },
        "path": { "type": "string", "minLength": 1 },
        "format": { "$ref": "#/$defs/format" },
        "scope": { "$ref": "#/$defs/inspectScope" },
        "locale": { "type": "string" }
      }
    },
    "inspectScope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sheet": { "type": "string", "minLength": 1 },
        "range": { "type": "string", "minLength": 1 },
        "maxCells": { "type": "integer", "minimum": 1, "maximum": 20000 },
        "from": { "type": "integer", "minimum": 1 },
        "maxParas": { "type": "integer", "minimum": 1, "maximum": 5000 },
        "headerFooter": { "type": "boolean" },
        "pictures": { "type": "boolean" },
        "textBoxes": { "type": "boolean" },
        "textBoxContent": { "type": "boolean" },
        "notes": { "type": "boolean" },
        "comments": { "type": "boolean" },
        "charts": { "type": "boolean" },
        "smartArt": { "type": "boolean" },
        "slide": { "type": "integer", "minimum": 1 },
        "maxShapes": { "type": "integer", "minimum": 1, "maximum": 5000 }
      },
      "dependentRequired": {
        "range": ["sheet"],
        "sheet": ["range"],
        "from": ["maxParas"],
        "maxParas": ["from"],
        "maxShapes": ["slide"],
        "textBoxContent": ["textBoxes"]
      }
    },
    "createRequest": {
      "type": "object",
      "comment": "path 省略时，落盘路径由调用方另给，命令行用 --output。xlsx 用 workbook，docx 用 document，pptx 用 presentation，三者不能同时出现。",
      "required": ["schemaVersion", "action"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "action": { "const": "create" },
        "path": { "type": "string", "minLength": 1 },
        "format": { "$ref": "#/$defs/format" },
        "workbook": { "$ref": "#/$defs/xlsxWorkbook" },
        "document": { "$ref": "#/$defs/docxDocument" },
        "presentation": { "$ref": "#/$defs/pptxPresentation" },
        "locale": { "type": "string" }
      },
      "oneOf": [
        { "required": ["workbook"] },
        { "required": ["document"] },
        { "required": ["presentation"] }
      ]
    },
    "xlsxWorkbook": {
      "type": "object",
      "required": ["sheets"],
      "additionalProperties": false,
      "properties": {
        "sheets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/xlsxSheetCreate" }
        }
      }
    },
    "xlsxSheetCreate": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 31 },
        "cells": {
          "type": "array",
          "items": { "$ref": "#/$defs/xlsxCellCreate" }
        },
        "pictures": {
          "type": "array",
          "items": { "$ref": "#/$defs/xlsxPictureCreate" }
        },
        "charts": {
          "type": "array",
          "items": { "$ref": "#/$defs/xlsxChartCreate" }
        }
      }
    },
    "xlsxPictureCreate": {
      "type": "object",
      "required": ["file", "from"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "anchor": { "enum": ["oneCell", "twoCell"] },
        "cx": { "type": "integer", "minimum": 1 },
        "cy": { "type": "integer", "minimum": 1 },
        "fromOffX": { "type": "integer", "minimum": 0 },
        "fromOffY": { "type": "integer", "minimum": 0 },
        "toOffX": { "type": "integer", "minimum": 0 },
        "toOffY": { "type": "integer", "minimum": 0 }
      }
    },
    "xlsxChartCreate": {
      "type": "object",
      "required": ["type", "series", "from", "dataFrom"],
      "additionalProperties": false,
      "properties": {
        "type": { "$ref": "#/$defs/insertChartType" },
        "title": { "type": "string" },
        "series": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              { "$ref": "#/$defs/chartSeriesData" },
              { "required": ["values"] }
            ]
          }
        },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "anchor": { "enum": ["oneCell", "twoCell"] },
        "cx": { "type": "integer", "minimum": 1 },
        "cy": { "type": "integer", "minimum": 1 },
        "fromOffX": { "type": "integer", "minimum": 0 },
        "fromOffY": { "type": "integer", "minimum": 0 },
        "toOffX": { "type": "integer", "minimum": 0 },
        "toOffY": { "type": "integer", "minimum": 0 },
        "dataFrom": { "type": "string", "minLength": 1 }
      }
    },
    "xlsxCellCreate": {
      "type": "object",
      "required": ["ref"],
      "additionalProperties": false,
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "value": {
          "type": ["number", "string", "boolean", "null"]
        },
        "formula": {
          "type": "string",
          "pattern": "^="
        }
      },
      "not": {
        "required": ["value", "formula"]
      }
    },
    "docxDocument": {
      "type": "object",
      "required": ["paragraphs"],
      "additionalProperties": false,
      "properties": {
        "paragraphs": {
          "type": "array",
          "items": { "$ref": "#/$defs/docxParaCreate" }
        },
        "headers": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/docxHfCreate" }
        },
        "footers": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/docxHfCreate" }
        }
      }
    },
    "docxHfCreate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["default", "even", "first"] },
        "paragraphs": {
          "type": "array",
          "items": { "$ref": "#/$defs/docxHfParaCreate" }
        }
      }
    },
    "docxHfParaCreate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" },
        "pictures": {
          "type": "array",
          "items": { "$ref": "#/$defs/docxPictureCreate" }
        },
        "smartArts": {
          "type": "array",
          "items": { "$ref": "#/$defs/docxSmartArtCreate" }
        }
      }
    },
    "docxParaCreate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" },
        "style": {
          "type": "string",
          "enum": ["Normal", "Heading1", "Heading2", "Heading3"]
        },
        "textBoxes": {
          "type": "array",
          "items": { "$ref": "#/$defs/docxTextBoxCreate" }
        },
        "pictures": {
          "type": "array",
          "items": { "$ref": "#/$defs/docxPictureCreate" }
        },
        "smartArts": {
          "type": "array",
          "items": { "$ref": "#/$defs/docxSmartArtCreate" }
        }
      }
    },
    "docxPictureCreate": {
      "type": "object",
      "required": ["file"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "cx": { "type": "integer", "minimum": 1 },
        "cy": { "type": "integer", "minimum": 1 },
        "kind": { "enum": ["inline", "anchor"] },
        "wrap": { "enum": ["square", "tight", "through", "topAndBottom", "none"] },
        "alignH": { "enum": ["left", "center", "right"] },
        "alignV": { "enum": ["top", "center", "bottom"] },
        "offsetX": { "type": "integer" },
        "offsetY": { "type": "integer" }
      }
    },
    "docxTextBoxCreate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" },
        "cx": { "type": "integer", "minimum": 1 },
        "cy": { "type": "integer", "minimum": 1 }
      }
    },
    "smartArtLayout": { "enum": ["list", "org"] },
    "smartArtRole": { "enum": ["node", "asst"] },
    "smartArtColors": {
      "enum": ["accent1", "accent2", "accent3", "accent4", "accent5", "accent6"]
    },
    "smartArtStyle": { "enum": ["simple", "subtle", "intense"] },
    "docxSmartArtCreate": {
      "type": "object",
      "required": ["layout"],
      "additionalProperties": false,
      "properties": {
        "layout": { "$ref": "#/$defs/smartArtLayout" },
        "points": {
          "type": "array",
          "items": { "$ref": "#/$defs/smartArtPointInput" }
        },
        "kind": { "enum": ["inline", "anchor"] },
        "wrap": {
          "type": ["string", "null"],
          "enum": ["square", "tight", "through", "topAndBottom", "none", null]
        },
        "cx": { "type": "integer", "minimum": 1 },
        "cy": { "type": "integer", "minimum": 1 }
      }
    },
    "smartArtPointInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" },
        "parent": { "type": ["integer", "null"], "minimum": 0 },
        "role": { "$ref": "#/$defs/smartArtRole" }
      }
    },
    "pptxPresentation": {
      "type": "object",
      "required": ["slides"],
      "additionalProperties": false,
      "properties": {
        "slides": {
          "type": "array",
          "items": { "$ref": "#/$defs/pptxSlideCreate" }
        }
      }
    },
    "pptxSlideCreate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shapes": {
          "type": "array",
          "items": { "$ref": "#/$defs/pptxShapeCreate" }
        },
        "pictures": {
          "type": "array",
          "items": { "$ref": "#/$defs/pptxPictureCreate" }
        },
        "charts": {
          "type": "array",
          "items": { "$ref": "#/$defs/pptxChartCreate" }
        },
        "smartArts": {
          "type": "array",
          "items": { "$ref": "#/$defs/pptxSmartArtCreate" }
        }
      }
    },
    "pptxSmartArtCreate": {
      "type": "object",
      "required": ["layout"],
      "additionalProperties": false,
      "properties": {
        "layout": { "$ref": "#/$defs/smartArtLayout" },
        "points": {
          "type": "array",
          "items": { "$ref": "#/$defs/smartArtPointInput" }
        },
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "cx": { "type": "integer", "minimum": 1 },
        "cy": { "type": "integer", "minimum": 1 }
      }
    },
    "pptxChartCreate": {
      "type": "object",
      "required": ["type", "series"],
      "additionalProperties": false,
      "properties": {
        "type": { "$ref": "#/$defs/insertChartType" },
        "title": { "type": "string" },
        "series": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              { "$ref": "#/$defs/chartSeriesData" },
              { "required": ["values"] }
            ]
          }
        },
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "cx": { "type": "integer", "minimum": 1 },
        "cy": { "type": "integer", "minimum": 1 }
      }
    },
    "pptxPictureCreate": {
      "type": "object",
      "required": ["file"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string", "minLength": 1 },
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "cx": { "type": "integer", "minimum": 1 },
        "cy": { "type": "integer", "minimum": 1 }
      }
    },
    "pptxShapeCreate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" }
      }
    },
    "exportMediaRequest": {
      "type": "object",
      "comment": "output 省略时，落盘路径由调用方另给，命令行用 --output。不得默认写成源 path。",
      "required": ["schemaVersion", "action", "path", "id"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "action": { "const": "exportMedia" },
        "path": { "type": "string", "minLength": 1 },
        "format": { "$ref": "#/$defs/format" },
        "id": { "type": "string", "minLength": 1 },
        "output": { "type": "string", "minLength": 1 },
        "locale": { "type": "string" }
      }
    },
    "applyRequest": {
      "type": "object",
      "required": ["schemaVersion", "action", "path", "ops"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "action": { "const": "apply" },
        "path": { "type": "string", "minLength": 1 },
        "format": { "$ref": "#/$defs/format" },
        "output": { "type": "string", "minLength": 1 },
        "locale": { "type": "string" },
        "ops": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/setCellOp" },
              { "$ref": "#/$defs/setHeaderFooterTextOp" },
              { "$ref": "#/$defs/setParaTextOp" },
              { "$ref": "#/$defs/setHeaderFooterDistanceOp" },
              { "$ref": "#/$defs/setHeaderFooterLinkOp" },
              { "$ref": "#/$defs/insertHeaderFooterOp" },
              { "$ref": "#/$defs/setTitlePageOp" },
              { "$ref": "#/$defs/setEvenAndOddHeadersOp" },
              { "$ref": "#/$defs/replacePictureOp" },
              { "$ref": "#/$defs/insertPictureOp" },
              { "$ref": "#/$defs/deletePictureOp" },
              { "$ref": "#/$defs/setPictureSizeOp" },
              { "$ref": "#/$defs/setPictureWrapOp" },
              { "$ref": "#/$defs/setPictureAnchorOp" },
              { "$ref": "#/$defs/setPicturePosOp" },
              { "$ref": "#/$defs/insertTextBoxOp" },
              { "$ref": "#/$defs/deleteTextBoxOp" },
              { "$ref": "#/$defs/setTextBoxSizeOp" },
              { "$ref": "#/$defs/setTextBoxWrapOp" },
              { "$ref": "#/$defs/setTextBoxFillOp" },
              { "$ref": "#/$defs/setTextBoxLineOp" },
              { "$ref": "#/$defs/setTextBoxDirectionOp" },
              { "$ref": "#/$defs/insertParaOp" },
              { "$ref": "#/$defs/deleteParaOp" },
              { "$ref": "#/$defs/setTextBoxLinkOp" },
              { "$ref": "#/$defs/insertFootnoteOp" },
              { "$ref": "#/$defs/insertEndnoteOp" },
              { "$ref": "#/$defs/deleteFootnoteOp" },
              { "$ref": "#/$defs/deleteEndnoteOp" },
              { "$ref": "#/$defs/setNoteNumberingOp" },
              { "$ref": "#/$defs/insertCommentOp" },
              { "$ref": "#/$defs/deleteCommentOp" },
              { "$ref": "#/$defs/replyCommentOp" },
              { "$ref": "#/$defs/setCommentTextOp" },
              { "$ref": "#/$defs/setCommentMetaOp" },
              { "$ref": "#/$defs/setCommentDoneOp" },
              { "$ref": "#/$defs/insertChartOp" },
              { "$ref": "#/$defs/insertChartSheetOp" },
              { "$ref": "#/$defs/deleteChartSheetOp" },
              { "$ref": "#/$defs/deleteChartOp" },
              { "$ref": "#/$defs/setChartTitleOp" },
              { "$ref": "#/$defs/setChartSeriesOp" },
              { "$ref": "#/$defs/addChartSeriesOp" },
              { "$ref": "#/$defs/deleteChartSeriesOp" },
              { "$ref": "#/$defs/setChartTypeOp" },
              { "$ref": "#/$defs/setChartAxisTitleOp" },
              { "$ref": "#/$defs/setChartLegendOp" },
              { "$ref": "#/$defs/setChartDataLabelsOp" },
              { "$ref": "#/$defs/setChartSizeOp" },
              { "$ref": "#/$defs/setChartPosOp" },
              { "$ref": "#/$defs/setChartWrapOp" },
              { "$ref": "#/$defs/setChartAnchorOp" },
              { "$ref": "#/$defs/insertSmartArtOp" },
              { "$ref": "#/$defs/deleteSmartArtOp" },
              { "$ref": "#/$defs/setSmartArtTextOp" },
              { "$ref": "#/$defs/addSmartArtPointOp" },
              { "$ref": "#/$defs/deleteSmartArtPointOp" },
              { "$ref": "#/$defs/setSmartArtSizeOp" },
              { "$ref": "#/$defs/setSmartArtPosOp" },
              { "$ref": "#/$defs/setSmartArtWrapOp" },
              { "$ref": "#/$defs/setSmartArtColorsOp" },
              { "$ref": "#/$defs/setSmartArtStyleOp" },
              { "$ref": "#/$defs/setSmartArtLayoutOp" },
              { "$ref": "#/$defs/setNotesTextOp" },
              { "$ref": "#/$defs/setShapeTextOp" }
            ]
          }
        }
      }
    },
    "setCellOp": {
      "type": "object",
      "required": ["op", "id"],
      "additionalProperties": false,
      "properties": {
        "op": { "const": "setCell" },
        "id": { "type": "string", "minLength": 1 },
        "value": {
          "type": ["number", "string", "boolean", "null"]
        },
        "formula": {
          "type": "string",
          "pattern": "^="
        }
      },
      "oneOf": [
        { "required": ["value"] },
        { "required": ["formula"] }
      ]
    },
    "setHeaderFooterTextOp": {
      "type": "object",
      "required": ["op", "id", "text"],
      "additionalProperties": false,
      "properties": {
        "op": { "const": "setHeaderFooterText" },
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string" }
      }
    },
    "setParaTextOp": {
      "type": "object",
      "required": ["op", "id", "text"],
      "additionalProperties": false,
      "properties": {
        "op": { "const": "setParaText" },
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string" }
      }
    },
    "setHeaderFooterDistanceOp": {
      "type": "object",
      "required": ["op", "id"],
      "additionalProperties": false,
      "properties": {
        "op": { "const": "setHeaderFooterDistance" },
        "id": { "type": "string", "minLength": 1 },
        "headerDistance": { "type": "integer", "minimum": 0 },
        "footerDistance": { "type": "integer", "minimum": 0 }
      },
      "anyOf": [
        { "required": ["headerDistance"] },
        { "required": ["footerDistance"] }
      ]
    },
    "setHeaderFooterLinkOp": {
      "type": "object",
      "required": ["op", "id", "kind", "type", "linked"],
      "additionalProperties": false,
      "properties": {
        "op": { "const": "setHeaderFooterLink" },
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["header", "footer"] },
        "type": { "enum": ["default", "even", "first"] },
        "linked": { "type": "boolean" }
      }
    },
    "insertHeaderFooterOp": {
      "type": "object",
      "required": ["op", "id", "kind", "type"],
      "additionalProperties": false,
      "properties": {
        "op": { "const": "insertHeaderFooter" },
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["header", "footer"] },
        "type": { "enum": ["default", "even", "first"] }
      }
    },
    "setTitlePageOp": {
      "type": "object",
      "required": ["op", "id", "titlePage"],
      "additionalProperties": false,
      "properties": {
        "op": { "const": "setTitlePage" },
        "id": { "type": "string", "minLength": 1 },
        "titlePage": { "type": "boolean" }
      }
    },
    "setEvenAndOddHeadersOp": {
      "type": "object",
      "required": ["op", "id", "evenAndOdd"],
      "additionalProperties": false,
      "properties": {
        "op": { "const": "setEvenAndOddHeaders" },
        "id": { "type": "string", "minLength": 1 },
        "evenAndOdd": { "type": "boolean" }
      }
    },
    "replacePictureOp": {
      "type": "object",
      "required": ["op", "id", "file"],
      "additionalProperties": false,
      "properties": {
        "op": { "const": "replacePicture" },
        "id": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "minLength": 1 }
      }
    },
    "insertPictureOp": {
      "type": "object",
      "required": ["op", "id", "file"],
      "additionalProperties": false,
      "properties": {
        "op": { "const": "insertPicture" },
        "id": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "minLength": 1 },
        "cx": { "type": "integer", "minimum": 1 },
        "cy": { "type": "integer", "minimum": 1 },
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "anchor": { "enum": ["oneCell", "twoCell"] },
        "fromOffX": { "type": "integer", "minimum": 0 },
        "fromOffY": { "type": "integer", "minimum": 0 },
        "toOffX": { "type": "integer", "minimum": 0 },
        "toOffY": { "type": "integer", "minimum": 0 }
      }
    },
    "deletePictureOp": {
      "type": "object",
      "required": ["op", "id"],
      "additionalProperties": false,
      "properties": {
        "op": { "const": "deletePicture" },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "setPictureSizeOp": {
      "type": "object",
      "required": ["op", "id"],
      "additionalProperties": false,
      "properties": {
        "op": { "const": "setPictureSize" },
        "id": { "type": "string", "minLength": 1 },
        "cx": { "type": "integer", "minimum": 1 },
        "cy": { "type": "integer", "minimum": 1 }
      },
      "anyOf": [
        { "required": ["cx"] },
