{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ooxp.local/schema/v1/request.json",
  "title": "ooxp 领域请求",
  "type": "object",
  "required": ["schemaVersion", "action"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "action": { "enum": ["inspect", "create", "apply"] }
  },
  "allOf": [
    {
      "if": {
        "properties": { "action": { "const": "inspect" } },
        "required": ["action"]
      },
      "then": { "$ref": "#/$defs/inspectRequest" }
    },
    {
      "if": {
        "properties": { "action": { "const": "create" } },
        "required": ["action"]
      },
      "then": { "$ref": "#/$defs/createRequest" }
    },
    {
      "if": {
        "properties": { "action": { "const": "apply" } },
        "required": ["action"]
      },
      "then": { "$ref": "#/$defs/applyRequest" }
    }
  ],
  "$defs": {
    "format": { "enum": ["xlsx", "docx", "pptx"] },
    "inspectRequest": {
      "type": "object",
      "required": ["schemaVersion", "action", "path"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "action": { "const": "inspect" },
        "path": { "type": "string", "minLength": 1 },
        "format": { "$ref": "#/$defs/format" },
        "scope": { "$ref": "#/$defs/xlsxScope" }
      }
    },
    "xlsxScope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sheet": { "type": "string", "minLength": 1 },
        "range": { "type": "string", "minLength": 1 },
        "maxCells": { "type": "integer", "minimum": 1, "maximum": 20000 }
      },
      "dependentRequired": {
        "range": ["sheet"],
        "sheet": ["range"]
      }
    },
    "createRequest": {
      "type": "object",
      "required": ["schemaVersion", "action", "path", "workbook"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "action": { "const": "create" },
        "path": { "type": "string", "minLength": 1 },
        "format": { "$ref": "#/$defs/format" },
        "workbook": { "$ref": "#/$defs/xlsxWorkbook" }
      }
    },
    "xlsxWorkbook": {
      "type": "object",
      "required": ["sheets"],
      "additionalProperties": false,
      "properties": {
        "sheets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/xlsxSheetCreate" }
        }
      }
    },
    "xlsxSheetCreate": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 31 },
        "cells": {
          "type": "array",
          "items": { "$ref": "#/$defs/xlsxCellCreate" }
        }
      }
    },
    "xlsxCellCreate": {
      "type": "object",
      "required": ["ref"],
      "additionalProperties": false,
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "value": {
          "type": ["number", "string", "boolean", "null"]
        },
        "formula": {
          "type": "string",
          "pattern": "^="
        }
      },
      "not": {
        "required": ["value", "formula"]
      }
    },
    "applyRequest": {
      "type": "object",
      "required": ["schemaVersion", "action", "path", "ops"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "action": { "const": "apply" },
        "path": { "type": "string", "minLength": 1 },
        "format": { "$ref": "#/$defs/format" },
        "output": { "type": "string", "minLength": 1 },
        "ops": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/setCellOp" }
        }
      }
    },
    "setCellOp": {
      "type": "object",
      "required": ["op", "id"],
      "additionalProperties": false,
      "properties": {
        "op": { "const": "setCell" },
        "id": { "type": "string", "minLength": 1 },
        "value": {
          "type": ["number", "string", "boolean", "null"]
        },
        "formula": {
          "type": "string",
          "pattern": "^="
        }
      },
      "oneOf": [
        { "required": ["value"] },
        { "required": ["formula"] }
      ]
    }
  }
}
