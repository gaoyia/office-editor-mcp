      "anyOf": [
        { "required": ["x"] },
        { "required": ["y"] }
      ]
    },
    "setSmartArtWrapOp": {
      "type": "object",
      "required": ["op", "id", "kind"],
      "additionalProperties": false,
      "properties": {
        "op": { "const": "setSmartArtWrap" },
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["inline", "anchor"] },
        "wrap": {
          "type": ["string", "null"],
          "enum": ["square", "tight", "through", "topAndBottom", "none", null]
        },
        "alignH": { "enum": ["left", "center", "right"] },
        "alignV": { "enum": ["top", "center", "bottom"] },
        "offsetX": { "type": "integer" },
        "offsetY": { "type": "integer" }
      }
    },
    "setSmartArtColorsOp": {
      "type": "object",
      "required": ["op", "id", "colors"],
      "additionalProperties": false,
      "properties": {
        "op": { "const": "setSmartArtColors" },
        "id": { "type": "string", "minLength": 1 },
        "colors": { "$ref": "#/$defs/smartArtColors" }
      }
    },
    "setSmartArtStyleOp": {
      "type": "object",
      "required": ["op", "id", "style"],
      "additionalProperties": false,
      "properties": {
        "op": { "const": "setSmartArtStyle" },
        "id": { "type": "string", "minLength": 1 },
        "style": { "$ref": "#/$defs/smartArtStyle" }
      }
    },
    "setSmartArtLayoutOp": {
      "type": "object",
      "required": ["op", "id", "layout"],
      "additionalProperties": false,
      "properties": {
        "op": { "const": "setSmartArtLayout" },
        "id": { "type": "string", "minLength": 1 },
        "layout": { "$ref": "#/$defs/smartArtLayout" }
      }
    },
    "exportChartDataRequest": {
      "type": "object",
      "comment": "output 省略时，落盘路径由调用方另给，命令行用 --output。不得默认写成源 path。",
      "required": ["schemaVersion", "action", "path", "id"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "action": { "const": "exportChartData" },
        "path": { "type": "string", "minLength": 1 },
        "format": { "$ref": "#/$defs/format" },
        "id": { "type": "string", "minLength": 1 },
        "output": { "type": "string", "minLength": 1 },
        "locale": { "type": "string" }
      }
    },
    "setNotesTextOp": {
      "type": "object",
      "required": ["op", "id", "text"],
      "additionalProperties": false,
      "properties": {
        "op": { "const": "setNotesText" },
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string" }
      }
    },
    "setShapeTextOp": {
      "type": "object",
      "required": ["op", "id", "text"],
      "additionalProperties": false,
      "properties": {
        "op": { "const": "setShapeText" },
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string" }
      }
    }
  }
}
