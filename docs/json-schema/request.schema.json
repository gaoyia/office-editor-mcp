{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ooxp.local/schema/v1/request.json",
  "title": "ooxp 领域请求",
  "type": "object",
  "required": ["schemaVersion", "action"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "action": { "enum": ["inspect", "create", "apply"] }
  },
  "allOf": [
    {
      "if": {
        "properties": { "action": { "const": "inspect" } },
        "required": ["action"]
      },
      "then": { "$ref": "#/$defs/inspectRequest" }
    },
    {
      "if": {
        "properties": { "action": { "const": "create" } },
        "required": ["action"]
      },
      "then": { "$ref": "#/$defs/createRequest" }
    },
    {
      "if": {
        "properties": { "action": { "const": "apply" } },
        "required": ["action"]
      },
      "then": { "$ref": "#/$defs/applyRequest" }
    }
  ],
  "$defs": {
    "format": { "enum": ["xlsx", "docx", "pptx"] },
    "inspectRequest": {
      "type": "object",
      "required": ["schemaVersion", "action", "path"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "action": { "const": "inspect" },
        "path": { "type": "string", "minLength": 1 },
        "format": { "$ref": "#/$defs/format" },
        "scope": { "$ref": "#/$defs/inspectScope" },
        "locale": { "type": "string" }
      }
    },
    "inspectScope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sheet": { "type": "string", "minLength": 1 },
        "range": { "type": "string", "minLength": 1 },
        "maxCells": { "type": "integer", "minimum": 1, "maximum": 20000 },
        "from": { "type": "integer", "minimum": 1 },
        "maxParas": { "type": "integer", "minimum": 1, "maximum": 5000 },
        "slide": { "type": "integer", "minimum": 1 },
        "maxShapes": { "type": "integer", "minimum": 1, "maximum": 5000 }
      },
      "dependentRequired": {
        "range": ["sheet"],
        "sheet": ["range"],
        "from": ["maxParas"],
        "maxParas": ["from"],
        "maxShapes": ["slide"]
      }
    },
    "createRequest": {
      "type": "object",
      "comment": "path 省略时，落盘路径由调用方另给，命令行用 --output。xlsx 用 workbook，docx 用 document，pptx 用 presentation，三者不能同时出现。",
      "required": ["schemaVersion", "action"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "action": { "const": "create" },
        "path": { "type": "string", "minLength": 1 },
        "format": { "$ref": "#/$defs/format" },
        "workbook": { "$ref": "#/$defs/xlsxWorkbook" },
        "document": { "$ref": "#/$defs/docxDocument" },
        "presentation": { "$ref": "#/$defs/pptxPresentation" },
        "locale": { "type": "string" }
      },
      "oneOf": [
        { "required": ["workbook"] },
        { "required": ["document"] },
        { "required": ["presentation"] }
      ]
    },
    "xlsxWorkbook": {
      "type": "object",
      "required": ["sheets"],
      "additionalProperties": false,
      "properties": {
        "sheets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/xlsxSheetCreate" }
        }
      }
    },
    "xlsxSheetCreate": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 31 },
        "cells": {
          "type": "array",
          "items": { "$ref": "#/$defs/xlsxCellCreate" }
        }
      }
    },
    "xlsxCellCreate": {
      "type": "object",
      "required": ["ref"],
      "additionalProperties": false,
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "value": {
          "type": ["number", "string", "boolean", "null"]
        },
        "formula": {
          "type": "string",
          "pattern": "^="
        }
      },
      "not": {
        "required": ["value", "formula"]
      }
    },
    "docxDocument": {
      "type": "object",
      "required": ["paragraphs"],
      "additionalProperties": false,
      "properties": {
        "paragraphs": {
          "type": "array",
          "items": { "$ref": "#/$defs/docxParaCreate" }
        }
      }
    },
    "docxParaCreate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" },
        "style": {
          "type": "string",
          "enum": ["Normal", "Heading1", "Heading2", "Heading3"]
        }
      }
    },
    "pptxPresentation": {
      "type": "object",
      "required": ["slides"],
      "additionalProperties": false,
      "properties": {
        "slides": {
          "type": "array",
          "items": { "$ref": "#/$defs/pptxSlideCreate" }
        }
      }
    },
    "pptxSlideCreate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shapes": {
          "type": "array",
          "items": { "$ref": "#/$defs/pptxShapeCreate" }
        }
      }
    },
    "pptxShapeCreate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" }
      }
    },
    "applyRequest": {
      "type": "object",
      "required": ["schemaVersion", "action", "path", "ops"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "action": { "const": "apply" },
        "path": { "type": "string", "minLength": 1 },
        "format": { "$ref": "#/$defs/format" },
        "output": { "type": "string", "minLength": 1 },
        "locale": { "type": "string" },
        "ops": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/setCellOp" },
              { "$ref": "#/$defs/setParaTextOp" },
              { "$ref": "#/$defs/setShapeTextOp" }
            ]
          }
        }
      }
    },
    "setCellOp": {
      "type": "object",
      "required": ["op", "id"],
      "additionalProperties": false,
      "properties": {
        "op": { "const": "setCell" },
        "id": { "type": "string", "minLength": 1 },
        "value": {
          "type": ["number", "string", "boolean", "null"]
        },
        "formula": {
          "type": "string",
          "pattern": "^="
        }
      },
      "oneOf": [
        { "required": ["value"] },
        { "required": ["formula"] }
      ]
    },
    "setParaTextOp": {
      "type": "object",
      "required": ["op", "id", "text"],
      "additionalProperties": false,
      "properties": {
        "op": { "const": "setParaText" },
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string" }
      }
    },
    "setShapeTextOp": {
      "type": "object",
      "required": ["op", "id", "text"],
      "additionalProperties": false,
      "properties": {
        "op": { "const": "setShapeText" },
        "id": { "type": "string", "minLength": 1 },
        "text": { "type": "string" }
      }
    }
  }
}
