{
  "$comment": "编辑用分块，由 build.py 拼进 request.schema.json。",
  "formats": {
    "insertSheetTableOp": [
      "xlsx"
    ],
    "setSheetTableOp": [
      "xlsx"
    ],
    "deleteSheetTableOp": [
      "xlsx"
    ],
    "insertPivotTableOp": [
      "xlsx"
    ],
    "setPivotTableOp": [
      "xlsx"
    ],
    "deletePivotTableOp": [
      "xlsx"
    ]
  },
  "$defs": {
    "insertSheetTableOp": {
      "description": "往工作表追加一张 SpreadsheetML 表（ECMA-376 §18.5.1.2）。",
      "limits": "单元格数据仍在 sheetData 里。不实现结构化引用求值，不渲染表样式。",
      "type": "object",
      "required": [
        "op",
        "id",
        "ref"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "insertSheetTable"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "setSheetTableOp": {
      "description": "改已有表格。",
      "limits": "只改给了的字段。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setSheetTable"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "deleteSheetTableOp": {
      "description": "删掉一张表格。",
      "limits": "单元格数据留下。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "deleteSheetTable"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "pivotSource": {
      "type": "object",
      "required": [
        "ref"
      ],
      "additionalProperties": false,
      "properties": {
        "sheet": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "insertPivotTableOp": {
      "description": "往工作表追加一张 SpreadsheetML 透视表（ECMA-376 §18.10）。",
      "limits": "库按源格子抄缓存记录，并标 refreshOnLoad=\"1\"。不在库里聚合，也不把合计写进 sheetData。打开后由 Excel 刷新。",
      "type": "object",
      "required": [
        "op",
        "id",
        "source",
        "location",
        "values"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "insertPivotTable"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/pivotSource"
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cols": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "setPivotTableOp": {
      "description": "改已有透视表。",
      "limits": "只改给了的字段。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setPivotTable"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/pivotSource"
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cols": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "deletePivotTableOp": {
      "description": "删掉一张透视表。",
      "limits": "源格子留下。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "deletePivotTable"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
