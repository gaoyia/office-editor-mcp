{
  "$comment": "编辑用分块，由 build.py 拼进 request.schema.json。",
  "formats": {
    "insertSheetTableOp": [
      "xlsx"
    ],
    "setSheetTableOp": [
      "xlsx"
    ],
    "deleteSheetTableOp": [
      "xlsx"
    ],
    "insertPivotTableOp": [
      "xlsx"
    ],
    "setPivotTableOp": [
      "xlsx"
    ],
    "deletePivotTableOp": [
      "xlsx"
    ]
  },
  "$defs": {
    "pivotValue": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "field"
          ],
          "properties": {
            "field": {
              "type": "string",
              "minLength": 1
            },
            "function": {
              "enum": [
                "sum",
                "count",
                "average"
              ]
            },
            "showAs": {
              "enum": [
                "percent"
              ]
            }
          }
        }
      ]
    },
    "insertSheetTableOp": {
      "description": "往工作表追加一张 SpreadsheetML 表（ECMA-376 §18.5.1.2）。",
      "descriptionEn": "Append one SpreadsheetML table to the worksheet (ECMA-376 §18.5.1.2).",
      "limits": "单元格数据仍在 sheetData 里。不实现结构化引用求值，不渲染表样式。",
      "limitsEn": "Cell data stays in sheetData. Structured-reference evaluation is not implemented, and table styles are not rendered.",
      "type": "object",
      "required": [
        "op",
        "id",
        "ref"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "insertSheetTable"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "setSheetTableOp": {
      "description": "改已有表格。",
      "descriptionEn": "Change an existing table.",
      "limits": "只改给了的字段。",
      "limitsEn": "Only the fields that were given are changed.",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setSheetTable"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "deleteSheetTableOp": {
      "description": "删掉一张表格。",
      "descriptionEn": "Delete a table.",
      "limits": "单元格数据留下。",
      "limitsEn": "Cell data stays.",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "deleteSheetTable"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "pivotSource": {
      "type": "object",
      "required": [
        "ref"
      ],
      "additionalProperties": false,
      "properties": {
        "sheet": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "insertPivotTableOp": {
      "description": "往工作表追加一张 SpreadsheetML 透视表（ECMA-376 §18.10）。",
      "descriptionEn": "Append one SpreadsheetML pivot table to the worksheet (ECMA-376 §18.10).",
      "limits": "库抄缓存并标 refreshOnLoad。多个行字段、多个列字段（一个行字段和一个值）、一个列字段加多个行字段或值、筛选、计数、平均值和合计占比会写入 sheetData。列字段再同时加多个行字段或多个值仍留给 Excel。",
      "limitsEn": "The library copies the cache and sets refreshOnLoad. Multiple row fields, multiple column fields with one row field and one value, one column field with several row fields or values, filters, count, average, and percent of total are written into sheetData. Column fields combined with both several row fields and several values are left for Excel.",
      "type": "object",
      "required": [
        "op",
        "id",
        "source",
        "location",
        "values"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "insertPivotTable"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/pivotSource"
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cols": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/pivotValue"
          }
        }
      }
    },
    "setPivotTableOp": {
      "description": "改已有透视表。",
      "descriptionEn": "Change an existing pivot table.",
      "limits": "只改给了的字段。",
      "limitsEn": "Only the fields that were given are changed.",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setPivotTable"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/pivotSource"
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cols": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "filters": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/pivotValue"
          }
        }
      }
    },
    "deletePivotTableOp": {
      "description": "删掉一张透视表。",
      "descriptionEn": "Delete a pivot table.",
      "limits": "源格子留下。",
      "limitsEn": "Source cells stay.",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "deletePivotTable"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
