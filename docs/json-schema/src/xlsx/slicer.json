{
  "$comment": "编辑用分块，由 build.py 拼进 request.schema.json。",
  "formats": {
    "insertSlicerOp": [
      "xlsx"
    ],
    "deleteSlicerOp": [
      "xlsx"
    ],
    "setSlicerSizeOp": [
      "xlsx"
    ],
    "setSlicerViewOp": [
      "xlsx"
    ],
    "setSlicerFilterOp": [
      "xlsx"
    ]
  },
  "$defs": {
    "insertSlicerOp": {
      "description": "把切片器或时间线视图写到目标工作表。",
      "descriptionEn": "Write a slicer or timeline view onto the target worksheet.",
      "limits": "不在库里执行筛选，不刷新透视合计。",
      "limitsEn": "This library does not run the filter and does not refresh pivot totals.",
      "type": "object",
      "required": [
        "op",
        "id",
        "source",
        "field",
        "from"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "insertSlicer"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "slicer",
            "timeline"
          ]
        },
        "level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "anchor": {
          "type": "string",
          "enum": [
            "oneCell",
            "twoCell"
          ]
        },
        "cx": {
          "type": "integer",
          "minimum": 1
        },
        "cy": {
          "type": "integer",
          "minimum": 1
        },
        "fromOffX": {
          "type": "integer",
          "minimum": 0
        },
        "fromOffY": {
          "type": "integer",
          "minimum": 0
        },
        "toOffX": {
          "type": "integer",
          "minimum": 0
        },
        "toOffY": {
          "type": "integer",
          "minimum": 0
        },
        "caption": {
          "type": "string",
          "minLength": 1
        },
        "rowHeight": {
          "type": "integer",
          "minimum": 1
        },
        "columnCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "showCaption": {
          "type": "boolean"
        },
        "startItem": {
          "type": "integer",
          "minimum": 0
        },
        "lockedPosition": {
          "type": "boolean"
        },
        "style": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "showHeader": {
          "type": "boolean"
        },
        "showSelectionLabel": {
          "type": "boolean"
        },
        "showTimeLevel": {
          "type": "boolean"
        },
        "showHorizontalScrollbar": {
          "type": "boolean"
        },
        "selectionLevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "scrollPosition": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "deleteSlicerOp": {
      "description": "删掉一个切片器。",
      "descriptionEn": "Delete a slicer.",
      "limits": "找不到报 IdNotFound。id 不是切片器 id 报 InvalidId。摘 drawing 锚点、slicers 或 timelines 部件里对应视图。 该 cache 已无视图则摘 slicerCache 或 timelineCache、workbook 关系，以及 @name 与 cache 名相同的那条定义名。 slicers 部件删光则去掉该部件与工作表 slicerList 条目。timelines 部件删光则去掉该部件与工作表 timelineRefs 条目。",
      "limitsEn": "A missing id returns IdNotFound. An id that is not a slicer id returns InvalidId. Remove the drawing anchor and the matching view in the slicers or timelines part. If that cache has no views left, remove the slicerCache or timelineCache, the workbook relationship, and the defined name whose @name matches the cache name. When the slicers part is empty, remove that part and the worksheet slicerList entry. When the timelines part is empty, remove that part and the worksheet timelineRefs entry.",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "deleteSlicer"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "setSlicerSizeOp": {
      "description": "字段与 setPictureSize 的 xlsx 一侧相同。",
      "descriptionEn": "Same fields as the xlsx side of setPictureSize.",
      "limits": "id 必须是切片器 id（含时间线）。oneCell / absolute 改外层 xdr:ext。twoCell 不认 cx / cy（出现报 InvalidField），必须给 to。不按列宽行高去换算 EMU。留下 AlternateContent 与 xdr:clientData。对图 id 发此 op、对切片器 id 发 setPictureSize 仍报 InvalidId。docx / pptx 上发此 op 报 InvalidField。",
      "limitsEn": "id must be a slicer id (including a timeline). oneCell / absolute updates the outer xdr:ext. twoCell does not accept cx / cy (those return InvalidField) and requires to. EMU is not converted from column width or row height. AlternateContent and xdr:clientData stay. This op on a picture id, or setPictureSize on a slicer id, still returns InvalidId. This op on docx / pptx returns InvalidField.",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setSlicerSize"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "cx": {
          "type": "integer",
          "minimum": 1
        },
        "cy": {
          "type": "integer",
          "minimum": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "toOffX": {
          "type": "integer",
          "minimum": 0
        },
        "toOffY": {
          "type": "integer",
          "minimum": 0
        }
      },
      "anyOf": [
        {
          "required": [
            "cx"
          ]
        },
        {
          "required": [
            "cy"
          ]
        },
        {
          "required": [
            "to"
          ]
        }
      ]
    },
    "setSlicerViewOp": {
      "description": "改 slicer 或 timeline 视图部件上的标题、行高、列数、显示开关与样式名。",
      "descriptionEn": "Change the caption, row height, column count, display switches, and style name on a slicer or timeline view part.",
      "limits": "不改 drawing 锚点，不改 cache，不执行筛选。",
      "limitsEn": "Do not change the drawing anchor, do not change the cache, and do not run the filter.",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "minProperties": 3,
      "properties": {
        "op": {
          "const": "setSlicerView"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "caption": {
          "type": "string",
          "minLength": 1
        },
        "rowHeight": {
          "type": "integer",
          "minimum": 1
        },
        "columnCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "showCaption": {
          "type": "boolean"
        },
        "startItem": {
          "type": "integer",
          "minimum": 0
        },
        "lockedPosition": {
          "type": "boolean"
        },
        "style": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "showHeader": {
          "type": "boolean"
        },
        "showSelectionLabel": {
          "type": "boolean"
        },
        "showTimeLevel": {
          "type": "boolean"
        },
        "showHorizontalScrollbar": {
          "type": "boolean"
        },
        "level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "selectionLevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "scrollPosition": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "setSlicerFilterOp": {
      "description": "改切片器 cache 已勾选项，或时间线 cache 的筛选区间。",
      "descriptionEn": "Change the checked items on a slicer cache, or the filter range on a timeline cache.",
      "limits": "不改 drawing，不改视图 @caption。不隐藏行。不重写透视缓存合计。不在库里执行筛选。",
      "limitsEn": "Do not change the drawing, and do not change the view @caption. Do not hide rows. Do not rewrite pivot-cache totals. This library does not run the filter.",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "selected"
          ],
          "not": {
            "required": [
              "filter"
            ]
          }
        },
        {
          "required": [
            "filter"
          ],
          "not": {
            "required": [
              "selected"
            ]
          }
        }
      ],
      "properties": {
        "op": {
          "const": "setSlicerFilter"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "selected": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "filter": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "filterType",
                "startDate",
                "endDate"
              ],
              "properties": {
                "filterType": {
                  "type": "string",
                  "minLength": 1
                },
                "startDate": {
                  "type": "string",
                  "minLength": 1
                },
                "endDate": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        }
      }
    }
  }
}
