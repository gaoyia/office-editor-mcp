{
  "$comment": "编辑用分块，由 build.py 拼进 request.schema.json。",
  "$defs": {
    "xlsxWorkbook": {
      "description": "新建工作簿时的正文，只在 create 里使用。",
      "descriptionEn": "Body of a new workbook. Use it only with create.",
      "limits": "不要把它当成 apply 的补丁。",
      "limitsEn": "Do not send it as an apply patch.",
      "type": "object",
      "required": [
        "sheets"
      ],
      "additionalProperties": false,
      "properties": {
        "sheets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/xlsxSheetCreate"
          }
        },
        "props": {
          "$ref": "#/$defs/createProps"
        },
        "definedNames": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/xlsxCreateDefinedName"
          }
        },
        "connections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/xlsxCreateConnection"
          }
        },
        "externalLinks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/xlsxCreateExternalLink"
          }
        },
        "customViews": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/xlsxCreateCustomView"
          }
        },
        "cellStyles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/xlsxCreateCellStyle"
          }
        },
        "workbookProtection": {
          "$ref": "#/$defs/xlsxCreateWorkbookProtection"
        },
        "theme": {
          "$ref": "#/$defs/docxThemeCreate"
        }
      }
    },
    "xlsxSheetCreate": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 31
        },
        "kind": {
          "enum": [
            "worksheet",
            "chartsheet"
          ]
        },
        "type": {
          "$ref": "#/$defs/insertChartType"
        },
        "ofPieType": {
          "enum": [
            "pie",
            "bar"
          ]
        },
        "stockKind": {
          "$ref": "#/$defs/stockKind"
        },
        "surfaceKind": {
          "$ref": "#/$defs/surfaceKind"
        },
        "layoutId": {
          "$ref": "#/$defs/chartexLayoutId"
        },
        "title": {
          "type": "string"
        },
        "series": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/chartSeriesData"
              },
              {
                "required": [
                  "values"
                ]
              }
            ]
          }
        },
        "dataFrom": {
          "description": "dataFrom 是单个单元格地址，例如 A1。不要写范围（A1:E19），不要写表名（Sheet!A1）。它不是「图表去引用哪一块已有单元格」。series 里的分类和数值会按这个格子当左上角，写进工作表，挡住的格子会被盖掉。分类写在这一列的下一行起；每个系列的名字写在这一行、向右逐列；数值写在名字下面。气泡图每个系列占两列。已经手写了表格时，把 dataFrom 指到空区域，不要指到那张表的表头。",
          "type": "string",
          "minLength": 1
        },
        "dataSheet": {
          "type": "string",
          "minLength": 1
        },
        "cx": {
          "type": "integer",
          "minimum": 1
        },
        "cy": {
          "type": "integer",
          "minimum": 1
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/xlsxCellCreate"
          }
        },
        "pictures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/xlsxPictureCreate"
          }
        },
        "charts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/xlsxChartCreate"
          }
        },
        "headerFooters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/xlsxHeaderFooterCreate"
          }
        },
        "comments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/xlsxCommentCreate"
          }
        },
        "hyperlinks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/xlsxHyperlinkCreate"
          }
        },
        "textBoxes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/xlsxTextBoxCreate"
          }
        },
        "maths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/xlsxMathCreate"
          }
        },
        "shapes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/xlsxShapeCreate"
          }
        },
        "connectors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/xlsxConnectorCreate"
          }
        },
        "smartArts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/xlsxSmartArtCreate"
          }
        },
        "model3ds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/xlsxModel3dCreate"
          }
        },
        "inks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/xlsxInkCreate"
          }
        },
        "cols": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/xlsxCreateCol"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/xlsxCreateRow"
          }
        },
        "merges": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dataValidations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/xlsxCreateDataValidation"
          }
        },
        "conditionalFormats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/xlsxCreateConditionalFormat"
          }
        },
        "tables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/xlsxCreateTable"
          }
        },
        "pivots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/xlsxCreatePivot"
          }
        },
        "print": {
          "$ref": "#/$defs/xlsxCreatePrint"
        },
        "view": {
          "$ref": "#/$defs/xlsxCreateView"
        },
        "autoFilter": {
          "$ref": "#/$defs/xlsxCreateAutoFilter"
        },
        "sortState": {
          "$ref": "#/$defs/xlsxCreateSortState"
        },
        "groupRows": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "groupCols": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "outline": {
          "$ref": "#/$defs/xlsxCreateOutline"
        },
        "sheetProtection": {
          "$ref": "#/$defs/xlsxCreateSheetProtection"
        },
        "protectedRanges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/xlsxCreateProtectedRange"
          }
        },
        "sparklines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/xlsxCreateSparkline"
          }
        },
        "oleObjects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/xlsxCreateOle"
          }
        },
        "slicers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/xlsxCreateSlicer"
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/xlsxCreateGroup"
          }
        }
      }
    },
    "xlsxHeaderFooterCreate": {
      "type": "object",
      "required": [
        "kind",
        "side"
