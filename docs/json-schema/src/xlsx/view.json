{
  "$comment": "编辑用分块，由 build.py 拼进 request.schema.json。",
  "formats": {
    "setPrintSetupOp": [
      "xlsx"
    ],
    "setSheetViewOp": [
      "xlsx"
    ],
    "setAutoFilterOp": [
      "xlsx"
    ],
    "setSortStateOp": [
      "xlsx"
    ],
    "groupRowsOp": [
      "xlsx"
    ],
    "ungroupRowsOp": [
      "xlsx"
    ],
    "groupColsOp": [
      "xlsx"
    ],
    "ungroupColsOp": [
      "xlsx"
    ],
    "setOutlineOp": [
      "xlsx"
    ],
    "setRowHiddenOp": [
      "xlsx"
    ],
    "setColHiddenOp": [
      "xlsx"
    ],
    "setHeaderFooterTextOp": [
      "xlsx"
    ],
    "setSheetHiddenOp": [
      "xlsx"
    ]
  },
  "$defs": {
    "setPrintSetupOp": {
      "description": "改工作表或图表工作表的页边距、纸张、方向、缩放、打印网格线、打印区域与手工分页符。",
      "limits": "不改页眉页脚原文（仍走 setHeaderFooterText）。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setPrintSetup"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "left": {
          "type": "number",
          "minimum": 0
        },
        "right": {
          "type": "number",
          "minimum": 0
        },
        "top": {
          "type": "number",
          "minimum": 0
        },
        "bottom": {
          "type": "number",
          "minimum": 0
        },
        "header": {
          "type": "number",
          "minimum": 0
        },
        "footer": {
          "type": "number",
          "minimum": 0
        },
        "paperSize": {
          "type": "integer",
          "minimum": 1
        },
        "orientation": {
          "enum": [
            "portrait",
            "landscape"
          ]
        },
        "scale": {
          "type": "integer",
          "minimum": 10,
          "maximum": 400
        },
        "fitToPage": {
          "type": "boolean"
        },
        "fitToWidth": {
          "type": "integer",
          "minimum": 0
        },
        "fitToHeight": {
          "type": "integer",
          "minimum": 0
        },
        "gridLines": {
          "type": "boolean"
        },
        "headings": {
          "type": "boolean"
        },
        "hCenter": {
          "type": "boolean"
        },
        "vCenter": {
          "type": "boolean"
        },
        "printArea": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "rowBreaks": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "colBreaks": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "left"
          ]
        },
        {
          "required": [
            "right"
          ]
        },
        {
          "required": [
            "top"
          ]
        },
        {
          "required": [
            "bottom"
          ]
        },
        {
          "required": [
            "header"
          ]
        },
        {
          "required": [
            "footer"
          ]
        },
        {
          "required": [
            "paperSize"
          ]
        },
        {
          "required": [
            "orientation"
          ]
        },
        {
          "required": [
            "scale"
          ]
        },
        {
          "required": [
            "fitToPage"
          ]
        },
        {
          "required": [
            "fitToWidth"
          ]
        },
        {
          "required": [
            "fitToHeight"
          ]
        },
        {
          "required": [
            "gridLines"
          ]
        },
        {
          "required": [
            "headings"
          ]
        },
        {
          "required": [
            "hCenter"
          ]
        },
        {
          "required": [
            "vCenter"
          ]
        },
        {
          "required": [
            "printArea"
          ]
        },
        {
          "required": [
            "rowBreaks"
          ]
        },
        {
          "required": [
            "colBreaks"
          ]
        }
      ]
    },
    "setSheetViewOp": {
      "description": "改工作表或图表工作表默认视图的缩放、冻结窗格、拆分窗格与活动单元格。",
      "limits": "不改分页预览 / 页面布局。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setSheetView"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "zoom": {
          "type": "integer",
          "minimum": 10,
          "maximum": 400
        },
        "frozenRows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048575
        },
        "frozenCols": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16383
        },
        "splitRows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048575
        },
        "splitCols": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16383
        },
        "activeCell": {
          "type": "string",
          "minLength": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "zoom"
          ]
        },
        {
          "required": [
            "frozenRows"
          ]
        },
        {
          "required": [
            "frozenCols"
          ]
        },
        {
          "required": [
            "splitRows"
          ]
        },
        {
          "required": [
            "splitCols"
          ]
        },
        {
          "required": [
            "activeCell"
          ]
        }
      ]
    },
    "setAutoFilterOp": {
      "description": "改工作表级自动筛选范围。",
      "limits": "不改表格部件里的筛选，不写筛选条件，不隐藏行。",
      "type": "object",
      "required": [
        "op",
        "id",
        "ref"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setAutoFilter"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "setSortStateOp": {
      "description": "改工作表级排序条件。",
      "limits": "不重排 sheetData，不隐藏行，不求值。不改表格部件里的排序。",
      "type": "object",
      "required": [
        "op",
        "id",
        "ref"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setSortState"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "caseSensitive": {
          "type": "boolean"
        },
        "columnSort": {
          "type": "boolean"
        },
        "sortMethod": {
          "enum": [
            "none",
            "pinYin",
            "stroke"
          ]
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "ref"
            ],
            "additionalProperties": false,
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "descending": {
                "type": "boolean"
              },
              "sortBy": {
                "enum": [
                  "value",
                  "cellColor",
                  "fontColor",
                  "icon"
                ]
              },
              "customList": {
                "type": "string",
                "minLength": 1
              },
              "dxfId": {
                "type": "integer",
                "minimum": 0
              },
              "color": {
                "$ref": "#/$defs/cellColor"
              },
              "iconSet": {
                "type": "string",
                "minLength": 1
              },
              "iconId": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "groupRowsOp": {
      "description": "给指定行的大纲级加 1。",
      "limits": "不写隐藏、不写折叠、不改汇总方向。",
      "type": "object",
      "required": [
        "op",
        "id",
        "rows"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "groupRows"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "rows": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ungroupRowsOp": {
      "description": "给指定行的大纲级减 1。",
      "limits": "减到 0 则去掉 @outlineLevel。范围内本来就是 0 的行不动。同步 outlineLevelRow。字段与错误与 groupRows 相同，op 必须是 \"ungroupRows\"。不写隐藏、不写折叠。",
      "type": "object",
      "required": [
        "op",
        "id",
        "rows"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "ungroupRows"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "rows": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "groupColsOp": {
      "description": "给指定列的大纲级加 1。",
      "limits": "不写隐藏、不写折叠。",
      "type": "object",
      "required": [
        "op",
        "id",
        "col"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "groupCols"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "col": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ungroupColsOp": {
      "description": "给指定列的大纲级减 1。",
      "limits": "减到 0 则去掉 @outlineLevel。字段与错误与 groupCols 相同，op 必须是 \"ungroupCols\"。",
      "type": "object",
      "required": [
        "op",
        "id",
        "col"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "ungroupCols"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "col": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "setOutlineOp": {
      "description": "改汇总方向，或按点名的细节范围折叠 / 展开。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setOutline"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "summaryBelow": {
          "type": "boolean"
        },
        "summaryRight": {
          "type": "boolean"
        },
        "collapseRows": {
          "type": "string",
          "minLength": 1
        },
        "collapseCols": {
          "type": "string",
          "minLength": 1
        },
        "collapsed": {
          "type": "boolean"
        }
      },
      "anyOf": [
        {
          "required": [
            "summaryBelow"
          ]
        },
        {
          "required": [
            "summaryRight"
          ]
        },
        {
          "required": [
            "collapseRows",
            "collapsed"
          ]
        },
        {
          "required": [
            "collapseCols",
            "collapsed"
          ]
        }
      ]
    },
    "setRowHiddenOp": {
      "description": "写或去掉行的 @hidden。",
      "limits": "不改大纲级，不折叠汇总行。",
      "type": "object",
      "required": [
        "op",
        "id",
        "rows",
        "hidden"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setRowHidden"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "rows": {
          "type": "string",
          "minLength": 1
        },
        "hidden": {
          "type": "boolean"
        }
      }
    },
    "setColHiddenOp": {
      "description": "写或去掉列的 @hidden。",
      "limits": "不改大纲级。",
      "type": "object",
      "required": [
        "op",
        "id",
        "col",
        "hidden"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setColHidden"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "col": {
          "type": "string",
          "minLength": 1
        },
        "hidden": {
          "type": "boolean"
        }
      }
    },
    "setHeaderFooterTextOp": {
      "description": "改页眉页脚里的文字。",
      "limits": "找不到该表报 IdNotFound。id 不是页眉槽位 id 报 InvalidId。对图 id、工作表 id 或单元格 id 发此 op 报 InvalidId。 worksheet / chartsheet / dialogsheet 都可以改文本。对 macrosheet 本期只读页眉原文，不新开写入。没有 headerFooter 则按 CT_Worksheet 顺序新建。",
      "type": "object",
      "required": [
        "op",
        "id",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setHeaderFooterText"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        }
      }
    },
    "setSheetHiddenOp": {
      "description": "隐藏或显示工作表。",
      "limits": "找不到该表报 IdNotFound。id 不是工作表 id 报 InvalidId。对 dialogsheet / macrosheet 报 NotImplemented。 把最后一张可见表改成隐藏报 InvalidField。true 写 state=\"hidden\"（若原先是 veryHidden 也改成 hidden）。false 去掉 state。已经是目标可见性则空操作。 docx / pptx 上发此 op 报 InvalidField。",
      "type": "object",
      "required": [
        "op",
        "id",
        "hidden"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setSheetHidden"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "hidden": {
          "type": "boolean"
        }
      }
    }
  }
}
