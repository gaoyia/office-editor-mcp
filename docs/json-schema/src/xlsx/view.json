      },
      "anyOf": [
        {
          "required": [
            "summaryBelow"
          ]
        },
        {
          "required": [
            "summaryRight"
          ]
        },
        {
          "required": [
            "collapseRows",
            "collapsed"
          ]
        },
        {
          "required": [
            "collapseCols",
            "collapsed"
          ]
        }
      ]
    },
    "setRowHiddenOp": {
      "type": "object",
      "required": [
        "op",
