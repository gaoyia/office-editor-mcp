        "ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "caseSensitive": {
          "type": "boolean"
        },
        "columnSort": {
          "type": "boolean"
        },
        "sortMethod": {
          "enum": [
            "none",
            "pinYin",
            "stroke"
          ]
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "ref"
            ],
            "additionalProperties": false,
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "descending": {
                "type": "boolean"
              },
              "sortBy": {
                "enum": [
                  "value",
                  "cellColor",
                  "fontColor",
                  "icon"
                ]
              },
              "customList": {
                "type": "string",
                "minLength": 1
              },
              "dxfId": {
                "type": "integer",
                "minimum": 0
              },
              "color": {
                "$ref": "#/$defs/cellColor"
              },
              "iconSet": {
                "type": "string",
                "minLength": 1
              },
              "iconId": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
