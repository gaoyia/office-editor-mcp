    "setSheetViewOp": {
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setSheetView"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "zoom": {
          "type": "integer",
          "minimum": 10,
          "maximum": 400
        },
        "frozenRows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048575
        },
        "frozenCols": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16383
        },
        "splitRows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048575
        },
        "splitCols": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16383
        },
        "activeCell": {
          "type": "string",
          "minLength": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "zoom"
          ]
        },
        {
          "required": [
            "frozenRows"
          ]
        },
        {
          "required": [
            "frozenCols"
          ]
        },
        {
          "required": [
            "splitRows"
          ]
        },
        {
          "required": [
            "splitCols"
          ]
        },
        {
          "required": [
            "activeCell"
          ]
        }
      ]
    },
    "setAutoFilterOp": {
      "type": "object",
      "required": [
        "op",
        "id",
        "ref"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setAutoFilter"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "setSortStateOp": {
      "type": "object",
      "required": [
        "op",
        "id",
        "ref"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setSortState"
        },
        "id": {
          "type": "string",
          "minLength": 1
