{
  "$comment": "编辑用分块，由 build.py 拼进 request.schema.json。",
  "formats": {
    "setPrintSetupOp": [
      "xlsx"
    ],
    "setSheetViewOp": [
      "xlsx"
    ],
    "setAutoFilterOp": [
      "xlsx"
    ],
    "setSortStateOp": [
      "xlsx"
    ],
    "groupRowsOp": [
      "xlsx"
    ],
    "ungroupRowsOp": [
      "xlsx"
    ],
    "groupColsOp": [
      "xlsx"
    ],
    "ungroupColsOp": [
      "xlsx"
    ],
    "setOutlineOp": [
      "xlsx"
    ],
    "setRowHiddenOp": [
      "xlsx"
    ],
    "setColHiddenOp": [
      "xlsx"
    ],
    "setHeaderFooterTextOp": [
      "xlsx"
    ],
    "setSheetHiddenOp": [
      "xlsx"
    ],
    "setSheetBackgroundOp": [
      "xlsx"
    ],
    "deleteSheetBackgroundOp": [
      "xlsx"
    ]
  },
  "$defs": {
    "setPrintSetupOp": {
      "description": "改工作表或图表工作表的页边距、纸张、方向、缩放、打印网格线、打印区域与手工分页符。",
      "descriptionEn": "Change margins, paper, orientation, scaling, print gridlines, the print area, and manual page breaks on a worksheet or chart sheet.",
      "limits": "不改页眉页脚原文（仍走 setHeaderFooterText）。",
      "limitsEn": "Do not change header or footer text (that still goes through setHeaderFooterText).",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setPrintSetup"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "left": {
          "type": "number",
          "minimum": 0
        },
        "right": {
          "type": "number",
          "minimum": 0
        },
        "top": {
          "type": "number",
          "minimum": 0
        },
        "bottom": {
          "type": "number",
          "minimum": 0
        },
        "header": {
          "type": "number",
          "minimum": 0
        },
        "footer": {
          "type": "number",
          "minimum": 0
        },
        "paperSize": {
          "type": "integer",
          "minimum": 1
        },
        "orientation": {
          "enum": [
            "portrait",
            "landscape"
          ]
        },
        "scale": {
          "type": "integer",
          "minimum": 10,
          "maximum": 400
        },
        "fitToPage": {
          "type": "boolean"
        },
        "fitToWidth": {
          "type": "integer",
          "minimum": 0
        },
        "fitToHeight": {
          "type": "integer",
          "minimum": 0
        },
        "gridLines": {
          "type": "boolean"
        },
        "headings": {
          "type": "boolean"
        },
        "hCenter": {
          "type": "boolean"
        },
        "vCenter": {
          "type": "boolean"
        },
        "printArea": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "rowBreaks": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "colBreaks": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "left"
          ]
        },
        {
          "required": [
            "right"
          ]
        },
        {
          "required": [
            "top"
          ]
        },
        {
          "required": [
            "bottom"
          ]
        },
        {
          "required": [
            "header"
          ]
        },
        {
          "required": [
            "footer"
          ]
        },
        {
          "required": [
            "paperSize"
          ]
        },
        {
          "required": [
            "orientation"
          ]
        },
        {
          "required": [
            "scale"
          ]
        },
        {
          "required": [
            "fitToPage"
          ]
        },
        {
          "required": [
            "fitToWidth"
          ]
        },
        {
          "required": [
            "fitToHeight"
          ]
        },
        {
          "required": [
            "gridLines"
          ]
        },
        {
          "required": [
            "headings"
          ]
        },
        {
          "required": [
            "hCenter"
          ]
        },
        {
          "required": [
            "vCenter"
          ]
        },
        {
          "required": [
            "printArea"
          ]
        },
        {
          "required": [
            "rowBreaks"
          ]
        },
        {
          "required": [
            "colBreaks"
          ]
        }
      ]
    },
    "setSheetViewOp": {
      "description": "改工作表或图表工作表默认视图的缩放、冻结窗格、拆分窗格与活动单元格。",
      "descriptionEn": "Change zoom, frozen panes, split panes, and the active cell on the default view of a worksheet or chart sheet.",
      "limits": "不改分页预览 / 页面布局。",
      "limitsEn": "Do not change page-break preview or page layout view.",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setSheetView"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "zoom": {
          "type": "integer",
          "minimum": 10,
          "maximum": 400
        },
        "frozenRows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048575
        },
        "frozenCols": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16383
        },
        "splitRows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048575
        },
        "splitCols": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16383
        },
        "activeCell": {
          "type": "string",
          "minLength": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "zoom"
          ]
        },
        {
          "required": [
            "frozenRows"
          ]
        },
        {
          "required": [
            "frozenCols"
          ]
        },
        {
          "required": [
            "splitRows"
          ]
        },
        {
          "required": [
            "splitCols"
          ]
        },
        {
          "required": [
            "activeCell"
          ]
        }
      ]
    },
    "setAutoFilterOp": {
      "description": "改工作表级自动筛选范围。",
      "descriptionEn": "Change the worksheet-level auto-filter range.",
      "limits": "不改表格部件里的筛选，不写筛选条件，不隐藏行。",
      "limitsEn": "Do not change the filter inside a table part, do not write filter criteria, and do not hide rows.",
      "type": "object",
      "required": [
        "op",
        "id",
        "ref"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setAutoFilter"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "setSortStateOp": {
      "description": "改工作表级排序条件。",
      "descriptionEn": "Change worksheet-level sort conditions.",
      "limits": "不重排 sheetData，不隐藏行，不求值。不改表格部件里的排序。",
      "limitsEn": "Do not reorder sheetData, do not hide rows, and do not evaluate. Do not change the sort inside a table part.",
      "type": "object",
      "required": [
        "op",
        "id",
        "ref"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setSortState"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "caseSensitive": {
          "type": "boolean"
        },
        "columnSort": {
          "type": "boolean"
        },
        "sortMethod": {
          "enum": [
            "none",
            "pinYin",
            "stroke"
          ]
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "ref"
            ],
            "additionalProperties": false,
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "descending": {
                "type": "boolean"
              },
              "sortBy": {
                "enum": [
                  "value",
                  "cellColor",
                  "fontColor",
                  "icon"
                ]
              },
              "customList": {
                "type": "string",
                "minLength": 1
              },
              "dxfId": {
                "type": "integer",
                "minimum": 0
              },
              "color": {
                "$ref": "#/$defs/cellColor"
              },
              "iconSet": {
                "type": "string",
                "minLength": 1
              },
              "iconId": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "groupRowsOp": {
      "description": "给指定行的大纲级加 1。",
      "descriptionEn": "Increase the outline level of the specified rows by 1.",
      "limits": "不写隐藏、不写折叠、不改汇总方向。",
      "limitsEn": "Do not write hidden, do not write collapsed, and do not change the summary direction.",
      "type": "object",
      "required": [
        "op",
        "id",
        "rows"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "groupRows"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "rows": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ungroupRowsOp": {
      "description": "给指定行的大纲级减 1。",
      "descriptionEn": "Decrease the outline level of the specified rows by 1.",
      "limits": "减到 0 则去掉 @outlineLevel。范围内本来就是 0 的行不动。同步 outlineLevelRow。字段与错误与 groupRows 相同，op 必须是 \"ungroupRows\"。不写隐藏、不写折叠。",
      "limitsEn": "At 0, remove @outlineLevel. Rows in the range that are already 0 stay unchanged. Keep outlineLevelRow in sync. Fields and errors match groupRows, and op must be \"ungroupRows\". Do not write hidden or collapsed.",
      "type": "object",
      "required": [
        "op",
        "id",
        "rows"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "ungroupRows"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "rows": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "groupColsOp": {
      "description": "给指定列的大纲级加 1。",
      "descriptionEn": "Increase the outline level of the specified columns by 1.",
      "limits": "不写隐藏、不写折叠。",
      "limitsEn": "Do not write hidden or collapsed.",
      "type": "object",
      "required": [
        "op",
        "id",
        "col"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "groupCols"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "col": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ungroupColsOp": {
      "description": "给指定列的大纲级减 1。",
      "descriptionEn": "Decrease the outline level of the specified columns by 1.",
      "limits": "减到 0 则去掉 @outlineLevel。字段与错误与 groupCols 相同，op 必须是 \"ungroupCols\"。",
      "limitsEn": "At 0, remove @outlineLevel. Fields and errors match groupCols, and op must be \"ungroupCols\".",
      "type": "object",
      "required": [
        "op",
        "id",
        "col"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "ungroupCols"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "col": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "setOutlineOp": {
      "description": "改汇总方向，或按点名的细节范围折叠 / 展开。",
      "descriptionEn": "Change the summary direction, or collapse or expand the named detail range.",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setOutline"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "summaryBelow": {
          "type": "boolean"
        },
        "summaryRight": {
          "type": "boolean"
        },
        "collapseRows": {
          "type": "string",
          "minLength": 1
        },
        "collapseCols": {
          "type": "string",
          "minLength": 1
        },
        "collapsed": {
          "type": "boolean"
        }
      },
      "anyOf": [
        {
          "required": [
            "summaryBelow"
          ]
        },
        {
          "required": [
            "summaryRight"
          ]
        },
        {
          "required": [
            "collapseRows",
            "collapsed"
          ]
        },
        {
          "required": [
            "collapseCols",
            "collapsed"
          ]
        }
      ]
    },
    "setRowHiddenOp": {
      "description": "写或去掉行的 @hidden。",
      "descriptionEn": "Write or remove @hidden on rows.",
      "limits": "不改大纲级，不折叠汇总行。",
      "limitsEn": "Do not change the outline level, and do not collapse summary rows.",
      "type": "object",
      "required": [
        "op",
        "id",
        "rows",
        "hidden"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setRowHidden"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "rows": {
          "type": "string",
          "minLength": 1
        },
        "hidden": {
          "type": "boolean"
        }
      }
    },
    "setColHiddenOp": {
      "description": "写或去掉列的 @hidden。",
      "descriptionEn": "Write or remove @hidden on columns.",
      "limits": "不改大纲级。",
      "limitsEn": "Do not change the outline level.",
      "type": "object",
      "required": [
        "op",
        "id",
        "col",
        "hidden"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setColHidden"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "col": {
          "type": "string",
          "minLength": 1
        },
        "hidden": {
          "type": "boolean"
        }
      }
    },
    "setHeaderFooterTextOp": {
      "description": "改页眉页脚里的文字。",
      "descriptionEn": "Change the text in a header or footer.",
      "limits": "找不到该表报 IdNotFound。id 不是页眉槽位 id 报 InvalidId。对图 id、工作表 id 或单元格 id 发此 op 报 InvalidId。 worksheet / chartsheet / dialogsheet 都可以改文本。对 macrosheet 本期只读页眉原文，不新开写入。没有 headerFooter 则按 CT_Worksheet 顺序新建。",
      "limitsEn": "A missing sheet returns IdNotFound. An id that is not a header/footer slot id returns InvalidId. This op on a picture id, sheet id, or cell id returns InvalidId. worksheet / chartsheet / dialogsheet can all change the text. For a macrosheet this phase only reads the existing header/footer text and does not open a new write. If headerFooter is missing, create it in CT_Worksheet order.",
      "type": "object",
      "required": [
        "op",
        "id",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setHeaderFooterText"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        }
      }
    },
    "setSheetHiddenOp": {
      "description": "隐藏或显示工作表。",
      "descriptionEn": "Hide or show a sheet.",
      "limits": "找不到该表报 IdNotFound。id 不是工作表 id 报 InvalidId。对 dialogsheet / macrosheet 报 NotImplemented。 把最后一张可见表改成隐藏报 InvalidField。true 写 state=\"hidden\"（若原先是 veryHidden 也改成 hidden）。false 去掉 state。已经是目标可见性则空操作。 docx / pptx 上发此 op 报 InvalidField。",
      "limitsEn": "A missing sheet returns IdNotFound. An id that is not a sheet id returns InvalidId. dialogsheet / macrosheet returns NotImplemented. Hiding the last visible sheet returns InvalidField. true writes state=\"hidden\" (veryHidden is also changed to hidden). false removes state. If visibility is already the target, this is a no-op. This op on docx / pptx returns InvalidField.",
      "type": "object",
      "required": [
        "op",
        "id",
        "hidden"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setSheetHidden"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "hidden": {
          "type": "boolean"
        }
      }
    },
    "setSheetBackgroundOp": {
      "description": "设置或替换工作表背景图。",
      "descriptionEn": "Set or replace a worksheet background.",
      "limits": "id 必须是 sheet:工作表名。已有背景则换掉媒体，没有则新建 picture。对 chartsheet / dialogsheet / macrosheet 报 InvalidField。单元格 id、图 id 或页眉图 id 报 InvalidId。docx / pptx 上发此 op 报 InvalidField。",
      "limitsEn": "id must be sheet:name. An existing background replaces the media part; otherwise a picture element is created. chartsheet / dialogsheet / macrosheet returns InvalidField. A cell id, picture id, or header-picture id returns InvalidId. This op on docx / pptx returns InvalidField.",
      "type": "object",
      "required": [
        "op",
        "id",
        "file"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setSheetBackground"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "deleteSheetBackgroundOp": {
      "description": "删除工作表背景图。",
      "descriptionEn": "Delete a worksheet background.",
      "limits": "id 必须是 sheet:工作表名/background。没有背景报 IdNotFound。对 chartsheet / dialogsheet / macrosheet 报 InvalidField。docx / pptx 上发此 op 报 InvalidField。",
      "limitsEn": "id must be sheet:name/background. A sheet with no background returns IdNotFound. chartsheet / dialogsheet / macrosheet returns InvalidField. This op on docx / pptx returns InvalidField.",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "deleteSheetBackground"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
