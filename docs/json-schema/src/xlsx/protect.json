{
  "$comment": "编辑用分块，由 build.py 拼进 request.schema.json。",
  "formats": {
    "insertProtectedRangeOp": [
      "xlsx"
    ],
    "setProtectedRangeOp": [
      "xlsx"
    ],
    "deleteProtectedRangeOp": [
      "xlsx"
    ]
  },
  "$defs": {
    "insertProtectedRangeOp": {
      "description": "往工作表追加一条允许编辑区域（ECMA-376 §18.3.1.71）。",
      "descriptionEn": "Append one allowed-edit range to the worksheet (ECMA-376 §18.3.1.71).",
      "limits": "区域在工作表保护打开且单元格锁定时生效。不标重算。",
      "limitsEn": "The range takes effect when worksheet protection is on and the cells are locked. Do not mark the file for recalculation.",
      "type": "object",
      "required": [
        "op",
        "id",
        "name",
        "sqref"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "insertProtectedRange"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "sqref": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "password": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "setProtectedRangeOp": {
      "description": "改已有允许编辑区域。",
      "descriptionEn": "Change an existing allowed-edit range.",
      "limits": "只改给了的字段。",
      "limitsEn": "Only the fields that were given are changed.",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setProtectedRange"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "sqref": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "password": {
          "type": "string",
          "minLength": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "name"
          ]
        },
        {
          "required": [
            "sqref"
          ]
        },
        {
          "required": [
            "password"
          ]
        }
      ]
    },
    "deleteProtectedRangeOp": {
      "description": "删掉一条允许编辑区域。",
      "descriptionEn": "Delete one allowed-edit range.",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "deleteProtectedRange"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "password": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
