        },
        {
          "required": [
            "toOffX"
          ]
        },
        {
          "required": [
            "toOffY"
          ]
        },
        {
          "required": [
            "posX"
          ]
        },
        {
          "required": [
            "posY"
          ]
        },
        {
          "required": [
            "editAs"
          ]
        },
        {
          "required": [
            "cx"
