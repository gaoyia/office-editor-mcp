  "$defs": {
    "setPictureAnchorOp": {
      "description": "改图片在工作表上的锚点。",
      "limits": "anchor、位置字段、editAs、cx / cy 至少给一类，否则报 InvalidField。找不到该图报 IdNotFound。id 不是 xlsx 图 id 报 InvalidId。 docx / pptx 上发此 op 报 InvalidField。pptx 改画布坐标请用 setPicturePos。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setPictureAnchor"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "anchor": {
          "enum": [
            "oneCell",
            "twoCell",
            "absolute",
            "relSize"
          ]
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "fromOffX": {
          "type": "integer",
          "minimum": 0
        },
        "fromOffY": {
          "type": "integer",
          "minimum": 0
        },
        "toOffX": {
          "type": "integer",
          "minimum": 0
        },
        "toOffY": {
          "type": "integer",
          "minimum": 0
        },
        "posX": {
          "type": "integer"
        },
        "posY": {
          "type": "integer"
        },
        "fromX": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fromY": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "toX": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "toY": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "editAs": {
          "enum": [
            "twoCell",
            "oneCell",
            "absolute"
          ]
        },
        "cx": {
          "type": "integer",
          "minimum": 1
        },
        "cy": {
          "type": "integer",
          "minimum": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "anchor"
          ]
        },
        {
          "required": [
            "from"
          ]
        },
        {
          "required": [
            "to"
          ]
        },
        {
          "required": [
            "fromOffX"
          ]
        },
