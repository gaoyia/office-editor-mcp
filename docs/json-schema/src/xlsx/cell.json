          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "toRow": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "height": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "maximum": 409
        }
      }
    },
