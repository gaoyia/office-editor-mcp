{
  "$comment": "编辑用分块，由 build.py 拼进 request.schema.json。",
  "formats": {
    "setCellOp": [
      "xlsx"
    ],
    "setCellStyleOp": [
      "xlsx"
    ],
    "setColWidthOp": [
      "xlsx"
    ],
    "setRowHeightOp": [
      "xlsx"
    ],
    "mergeRangeOp": [
      "xlsx"
    ],
    "unmergeRangeOp": [
      "xlsx"
    ],
    "insertCellStyleOp": [
      "xlsx"
    ],
    "deleteCellStyleOp": [
      "xlsx"
    ],
    "setCellNamedStyleOp": [
      "xlsx"
    ]
  },
  "$defs": {
    "setCellOp": {
      "description": "改一个单元格的值或公式。",
      "limits": "value 和 formula 二选一，不能同时出现。arrayRef 与 sharedRef 不能同时出现，shared 与 array 也不能同时为真。不改超链接，不改迷你图。共享公式、数组公式、数据表的填法不同，不要把从属格当成主格来写。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setCell"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "number",
            "string",
            "boolean",
            "null"
          ]
        },
        "formula": {
          "type": "string",
          "pattern": "^="
        },
        "shared": {
          "type": "boolean"
        },
        "sharedRef": {
          "type": "string",
          "minLength": 1
        },
        "array": {
          "type": "boolean"
        },
        "arrayRef": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "value"
          ]
        },
        {
          "required": [
            "formula"
          ]
        }
      ]
    },
    "cellColor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rgb": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
        },
        "theme": {
          "type": "integer",
          "minimum": 0
        },
        "indexed": {
          "type": "integer",
          "minimum": 0
        },
        "tint": {
          "type": "number"
        }
      }
    },
    "cellBorderSide": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "style": {
          "type": "string",
          "minLength": 1
        },
        "color": {
          "$ref": "#/$defs/cellColor"
        }
      }
    },
    "setCellStyleOp": {
      "description": "写单元格的数字格式、字体、填充、边框与对齐。",
      "limits": "不改值、不改公式。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setCellStyle"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "numFmt": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "font": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "sz": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 409
            },
            "bold": {
              "type": "boolean"
            },
            "italic": {
              "type": "boolean"
            },
            "underline": {
              "type": [
                "boolean",
                "string",
                "null"
              ]
            },
            "color": {
              "$ref": "#/$defs/cellColor"
            }
          }
        },
        "fill": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "pattern": {
              "type": "string",
              "minLength": 1
            },
            "fg": {
              "$ref": "#/$defs/cellColor"
            },
            "bg": {
              "$ref": "#/$defs/cellColor"
            }
          }
        },
        "border": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "style": {
              "type": "string",
              "minLength": 1
            },
            "color": {
              "$ref": "#/$defs/cellColor"
            },
            "left": {
              "$ref": "#/$defs/cellBorderSide"
            },
            "right": {
              "$ref": "#/$defs/cellBorderSide"
            },
            "top": {
              "$ref": "#/$defs/cellBorderSide"
            },
            "bottom": {
              "$ref": "#/$defs/cellBorderSide"
            },
            "diagonal": {
              "$ref": "#/$defs/cellBorderSide"
            },
            "diagonalUp": {
              "type": "boolean"
            },
            "diagonalDown": {
              "type": "boolean"
            }
          }
        },
        "align": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "horizontal": {
              "type": "string",
              "minLength": 1
            },
            "vertical": {
              "type": "string",
              "minLength": 1
            },
            "wrap": {
              "type": "boolean"
            },
            "indent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 250
            },
            "rotation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 180
            },
            "shrink": {
              "type": "boolean"
            }
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "numFmt"
          ]
        },
        {
          "required": [
            "font"
          ]
        },
        {
          "required": [
            "fill"
          ]
        },
        {
          "required": [
            "border"
          ]
        },
        {
          "required": [
            "align"
          ]
        }
      ]
    },
    "setColWidthOp": {
      "description": "写工作表列宽。",
      "limits": "JSON 的 width 是 Excel 列宽字符数（与 COM ColumnWidth 同一套），不是像素。写入 col/@width 时按 ECMA-376 §18.3.1.13 的公式转换；MDW 固定用该节示例的 Calibri 11 点 7 像素，不读实际字体、不算最适列宽。",
      "type": "object",
      "required": [
        "op",
        "id",
        "col"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setColWidth"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "col": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "maximum": 255
        },
        "bestFit": {
          "type": "boolean"
        }
      },
      "anyOf": [
        {
          "required": [
            "width"
          ]
        },
        {
          "required": [
            "bestFit"
          ]
        }
      ]
    },
    "setRowHeightOp": {
      "description": "写行高。",
      "limits": "单位磅，对应 row/@ht。不算自动换行后的高度。",
      "type": "object",
      "required": [
        "op",
        "id",
        "row",
        "height"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setRowHeight"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "row": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "toRow": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "height": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "maximum": 409
        }
      }
    },
    "mergeRangeOp": {
      "description": "合并工作表单元格。",
      "limits": "不要跟 Word 表的 mergeCells 混用。",
      "type": "object",
      "required": [
        "op",
        "id",
        "range"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "mergeRange"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "range": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "unmergeRangeOp": {
      "description": "取消合并。",
      "limits": "不恢复合并时清掉的值。",
      "type": "object",
      "required": [
        "op",
        "id",
        "range"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "unmergeRange"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "range": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "insertCellStyleOp": {
      "description": "往 styles.xml 追加一条命名单元格样式。",
      "limits": "不套到任何格子上。",
      "type": "object",
      "required": [
        "op",
        "id",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "insertCellStyle"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "numFmt": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "font": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "sz": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 409
            },
            "bold": {
              "type": "boolean"
            },
            "italic": {
              "type": "boolean"
            },
            "underline": {
              "type": [
                "boolean",
                "string",
                "null"
              ]
            },
            "color": {
              "$ref": "#/$defs/cellColor"
            }
          }
        },
        "fill": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "pattern": {
              "type": "string",
              "minLength": 1
            },
            "fg": {
              "$ref": "#/$defs/cellColor"
            },
            "bg": {
              "$ref": "#/$defs/cellColor"
            }
          }
        },
        "border": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "style": {
              "type": "string",
              "minLength": 1
            },
            "color": {
              "$ref": "#/$defs/cellColor"
            },
            "left": {
              "$ref": "#/$defs/cellBorderSide"
            },
            "right": {
              "$ref": "#/$defs/cellBorderSide"
            },
            "top": {
              "$ref": "#/$defs/cellBorderSide"
            },
            "bottom": {
              "$ref": "#/$defs/cellBorderSide"
            },
            "diagonal": {
              "$ref": "#/$defs/cellBorderSide"
            },
            "diagonalUp": {
              "type": "boolean"
            },
            "diagonalDown": {
              "type": "boolean"
            }
          }
        },
        "align": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "horizontal": {
              "type": "string",
              "minLength": 1
            },
            "vertical": {
              "type": "string",
              "minLength": 1
            },
            "wrap": {
              "type": "boolean"
            },
            "indent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 250
            },
            "rotation": {
              "type": "integer",
              "minimum": 0,
              "maximum": 180
            },
            "shrink": {
              "type": "boolean"
            }
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "numFmt"
          ]
        },
        {
          "required": [
            "font"
          ]
        },
        {
          "required": [
            "fill"
          ]
        },
        {
          "required": [
            "border"
          ]
        },
        {
          "required": [
            "align"
          ]
        }
      ]
    },
    "deleteCellStyleOp": {
      "description": "删掉一条命名单元格样式。",
      "limits": "不删 cellStyleXfs，不改格子上已有 s。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "deleteCellStyle"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "setCellNamedStyleOp": {
      "description": "把单元格的 s 指到一条引用该命名样式 xfId 的 cellXfs。",
      "type": "object",
      "required": [
        "op",
        "id",
        "style"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setCellNamedStyle"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "style": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
