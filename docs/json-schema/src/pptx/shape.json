{
  "$comment": "编辑用分块，由 build.py 拼进 request.schema.json。",
  "formats": {
    "insertShapeOp": [
      "xlsx",
      "docx",
      "pptx"
    ],
    "insertConnectorOp": [
      "xlsx",
      "docx",
      "pptx"
    ],
    "deleteConnectorOp": [
      "xlsx",
      "docx",
      "pptx"
    ],
    "groupShapesOp": [
      "xlsx",
      "docx",
      "pptx"
    ],
    "ungroupOp": [
      "xlsx",
      "docx",
      "pptx"
    ],
    "deleteShapeOp": [
      "xlsx",
      "docx",
      "pptx"
    ],
    "setShapePosOp": [
      "docx",
      "pptx"
    ],
    "setShapeSizeOp": [
      "docx",
      "pptx"
    ],
    "setShapeFillOp": [
      "docx",
      "pptx"
    ],
    "setShapeFormatOp": [
      "xlsx",
      "pptx"
    ],
    "setShapeLineOp": [
      "docx",
      "pptx"
    ],
    "setShapeGeomOp": [
      "pptx"
    ],
    "setConnectorOp": [
      "pptx"
    ]
  },
  "$defs": {
    "drawingTextFill": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "none"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "stops"
          ],
          "properties": {
            "type": {
              "const": "gradient"
            },
            "ang": {
              "type": "integer",
              "minimum": 0,
              "maximum": 21600000
            },
            "stops": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "required": [
                  "pos",
                  "color"
                ],
                "additionalProperties": false,
                "properties": {
                  "pos": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  "color": {
                    "type": "string",
                    "minLength": 6,
                    "maxLength": 6
                  }
                }
              }
            }
          }
        }
      ]
    },
    "drawingTextOutline": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "color",
            "width"
          ],
          "properties": {
            "color": {
              "type": "string",
              "minLength": 6,
              "maxLength": 6
            },
            "width": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "drawingTextSpacing": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "val"
          ],
          "properties": {
            "type": {
              "const": "pts"
            },
            "val": {
              "type": "integer",
              "minimum": 0,
              "maximum": 158400
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "val"
          ],
          "properties": {
            "type": {
              "const": "pct"
            },
            "val": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "insertShapeOp": {
      "description": "往幻灯片、备注页、母版或版式插入一个带 p:txBody 的形状。",
      "descriptionEn": "Insert a shape that has p:txBody on a slide, notes page, master, or layout.",
      "limits": "缺省 prst 为矩形文本框。不抄版式占位符，不写 <p:timing>。往母版 / 版式插时写出没有 p:ph 的装饰形，不把该 p:sp 抄进各页。插占位符请用 insertPlaceholder。",
      "limitsEn": "The default prst is a rectangle text box. Layout placeholders are not copied, and <p:timing> is not written. Inserting on a master or layout writes a decorative shape with no p:ph, and that p:sp is not copied onto slides. To insert a placeholder, use insertPlaceholder.",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "insertShape"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        },
        "cx": {
          "type": "integer",
          "minimum": 1
        },
        "cy": {
          "type": "integer",
          "minimum": 1
        },
        "prst": {
          "$ref": "#/$defs/shapePrst"
        },
        "sz": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 100,
          "maximum": 400000
        },
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "textFill": {
          "$ref": "#/$defs/drawingTextFill"
        },
        "textOutline": {
          "$ref": "#/$defs/drawingTextOutline"
        },
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "underline": {
          "$ref": "#/$defs/drawingUnderline"
        },
        "font": {
          "type": "string",
          "minLength": 1
        },
        "eastAsiaFont": {
          "type": "string",
          "minLength": 1
        },
        "align": {
          "$ref": "#/$defs/drawingAlign"
        },
        "textAnchor": {
          "$ref": "#/$defs/drawingTextAnchor"
        },
        "spcBef": {
          "$ref": "#/$defs/drawingTextSpacing"
        },
        "spcAft": {
          "$ref": "#/$defs/drawingTextSpacing"
        },
        "lnSpc": {
          "$ref": "#/$defs/drawingTextSpacing"
        },
        "spc": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": -400000,
          "maximum": 400000
        },
        "kern": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 400000
        },
        "geom": {
          "$ref": "#/$defs/shapeGeom"
        },
        "fill": {
          "$ref": "#/$defs/shapePaint"
        },
        "line": {
          "$ref": "#/$defs/shapeLine"
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "before": {
          "type": "string",
          "minLength": 1
        },
        "after": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "anchor": {
          "enum": [
            "oneCell",
            "twoCell"
          ]
        },
        "fromOffX": {
          "type": "integer",
          "minimum": 0
        },
        "fromOffY": {
          "type": "integer",
          "minimum": 0
        },
        "toOffX": {
          "type": "integer",
          "minimum": 0
        },
        "toOffY": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "insertConnectorOp": {
      "description": "往幻灯片、备注页、母版或版式插入一条连接线（p:cxnSp）。",
      "descriptionEn": "Insert a connector (p:cxnSp) on a slide, notes page, master, or layout.",
      "limits": "不算自动绕障碍。省略 start / end 时不写 a:stCxn / a:endCxn。",
      "limitsEn": "Does not route around obstacles automatically. When start / end are omitted, a:stCxn / a:endCxn are not written.",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "insertConnector"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "prst": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "cx": {
          "type": "integer",
          "minimum": 1
        },
        "cy": {
          "type": "integer",
          "minimum": 1
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "anchor": {
          "enum": [
            "oneCell",
            "twoCell"
          ]
        },
        "fromOffX": {
          "type": "integer",
          "minimum": 0
        },
        "fromOffY": {
          "type": "integer",
          "minimum": 0
        },
        "toOffX": {
          "type": "integer",
          "minimum": 0
        },
        "toOffY": {
          "type": "integer",
          "minimum": 0
        },
        "start": {
          "$ref": "#/$defs/connectorEnd"
        },
        "end": {
          "$ref": "#/$defs/connectorEnd"
        }
      }
    },
    "deleteConnectorOp": {
      "description": "删掉一条连接线。",
      "descriptionEn": "Delete a connector.",
      "limits": "找不到该连接线报 IdNotFound。id 不是连接线 id 报 InvalidId。删掉对应 p:cxnSp。 若在 mc:AlternateContent 的 Choice 里，整段 AlternateContent 删掉。删组合内连接线后若组合空了，把空 p:grpSp 一并摘掉。不改其它对象的 cNvPr/@id。 按被删连接线的 cNvPr/@id 清掉本页 <p:timing> 里对应的 p:tgtEl。docx 见 [docx 分册](json-contract-docx.md#deleteconnector)。",
      "limitsEn": "A missing connector returns IdNotFound. An id that is not a connector id returns InvalidId. Delete the matching p:cxnSp. If it sits in the Choice of an mc:AlternateContent, delete the whole AlternateContent. After deleting a connector inside a group, if the group is empty, remove the empty p:grpSp too. cNvPr/@id of other objects is unchanged. Clear the matching p:tgtEl in this slide's <p:timing> for the deleted connector's cNvPr/@id. For docx, see json-contract-docx.md#deleteconnector.",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "deleteConnector"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "groupShapesOp": {
      "description": "把同一页 spTree 上至少两个直接子对象包进一个新 p:grpSp。",
      "descriptionEn": "Wrap at least two direct children of the same slide's spTree into a new p:grpSp.",
      "limits": "组合本身不进 inspect 树。",
      "limitsEn": "The group itself is not placed in the inspect tree.",
      "type": "object",
      "required": [
        "op",
        "id",
        "ids"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "groupShapes"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "ids": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "ungroupOp": {
      "description": "解开某个成员所在的 p:grpSp，子节点抬回父节点。",
      "descriptionEn": "Ungroup the p:grpSp that contains a member, and lift the children back onto the parent.",
      "limits": "组合本身没有 inspect id。",
      "limitsEn": "The group itself has no inspect id.",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "ungroup"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "deleteShapeOp": {
      "description": "删掉一个形状。",
      "descriptionEn": "Delete a shape.",
      "limits": "找不到该形状报 IdNotFound。id 不是形状 id 报 InvalidId。对母版、版式、备注母版或讲义占位符 id 发本 op 报 InvalidId。 插删占位符请用 insertPlaceholder / deletePlaceholder。对备注页、备注母版或讲义上占位符 p:ph/@type 为 sldImg 的形状发本 op 报 InvalidField，不写文件。 删掉对应 p:sp。若在 mc:AlternateContent 的 Choice 里，整段 AlternateContent 删掉。",
      "limitsEn": "A missing shape returns IdNotFound. An id that is not a shape id returns InvalidId. A master, layout, notes-master, or handout placeholder id returns InvalidId for this op. To insert or delete a placeholder, use insertPlaceholder / deletePlaceholder. This op on a shape whose placeholder p:ph/@type is sldImg, on a notes page, notes master, or handout, returns InvalidField, and the file is not written. Delete the matching p:sp. If it sits in the Choice of an mc:AlternateContent, delete the whole AlternateContent.",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "deleteShape"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "setShapePosOp": {
      "description": "写入该 p:sp 或 p:cxnSp 的 p:spPr/a:xfrm/a:off。",
      "descriptionEn": "Writes p:spPr/a:xfrm/a:off on that p:sp or p:cxnSp.",
      "limits": "没有 xfrm 则补。找不到报 IdNotFound。id 不是形状 id 也不是连接线 id 报 InvalidId。x 与 y 一个都不给报 InvalidField。对 sldImg 占位符报 InvalidField。母版 / 版式占位符与装饰形只改对应 slideMaster / slideLayout 部件，不改各页 XML。备注母版只改 notesMaster 部件。讲义只改 handoutMaster 部件。",
      "limitsEn": "If xfrm is missing, add one. A missing id returns IdNotFound. An id that is neither a shape id nor a connector id returns InvalidId. Giving neither x nor y returns InvalidField. An sldImg placeholder returns InvalidField. Master and layout placeholders and decorative shapes are changed only in the matching slideMaster or slideLayout part, not in each slide's XML. The notes master changes only the notesMaster part. Handouts change only the handoutMaster part.",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setShapePos"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        }
      },
      "anyOf": [
        {
          "required": [
            "x"
          ]
        },
        {
          "required": [
            "y"
          ]
        }
      ]
    },
    "setShapeSizeOp": {
      "description": "写入该 p:sp 或 p:cxnSp 的 p:spPr/a:xfrm/a:ext。",
      "descriptionEn": "Writes p:spPr/a:xfrm/a:ext on that p:sp or p:cxnSp.",
      "limits": "没有 xfrm 则补。找不到报 IdNotFound。id 不是形状 id 也不是连接线 id 报 InvalidId。cx 与 cy 一个都不给报 InvalidField。对 sldImg 占位符报 InvalidField。母版 / 版式占位符与装饰形只改对应 slideMaster / slideLayout 部件。备注母版只改 notesMaster 部件。讲义只改 handoutMaster 部件。对已组合的子对象只改该子 xfrm，不重算父组合框。",
      "limitsEn": "If xfrm is missing, add one. A missing id returns IdNotFound. An id that is neither a shape id nor a connector id returns InvalidId. Giving neither cx nor cy returns InvalidField. An sldImg placeholder returns InvalidField. Master and layout placeholders and decorative shapes are changed only in the matching slideMaster or slideLayout part. The notes master changes only the notesMaster part. Handouts change only the handoutMaster part. For a child that is already grouped, change only that child's xfrm. Do not recompute the parent group box.",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setShapeSize"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "cx": {
          "type": "integer",
          "minimum": 1
        },
        "cy": {
          "type": "integer",
          "minimum": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "cx"
          ]
        },
        {
          "required": [
            "cy"
          ]
        }
      ]
    },
    "shapePaint": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{6}$"
        },
        {
          "$ref": "#/$defs/shapePaintObject"
        }
      ]
    },
    "shapePaintObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "solid",
            "grad",
            "blip"
          ]
        },
        "color": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{6}$"
        },
        "alpha": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "ang": {
          "type": "integer",
          "minimum": 0,
          "maximum": 21600000
        },
        "stops": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pos",
              "color"
            ],
            "properties": {
              "pos": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000
              },
              "color": {
                "type": "string",
                "pattern": "^[0-9A-Fa-f]{6}$"
              }
            }
          }
        },
        "file": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "shapeLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "color"
      ],
      "properties": {
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "setShapeFillOp": {
      "description": "写入形状填充：纯色、无填充、渐变或图片。",
      "descriptionEn": "Writes a shape fill: solid, none, gradient, or picture.",
      "limits": "color 与 fill 恰好一个。alpha 为 0 到 100000。blip 不能带 alpha。找不到报 IdNotFound。docx / xlsx 上发此 op 报 InvalidField。",
      "limitsEn": "color and fill are mutually exclusive and one is required. alpha is 0 to 100000. blip cannot take alpha. A missing id returns IdNotFound. This op on docx / xlsx returns InvalidField.",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setShapeFill"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "alpha": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "fill": {
          "$ref": "#/$defs/shapePaint"
        }
      }
    },
    "setShapeFormatOp": {
      "description": "改 DrawingML 文本框的字号、字色、字填充、字轮廓、加粗、斜体、下划线、中英文字体、水平对齐、框内垂直锚点、段落间距与字符间距。",
      "descriptionEn": "Change a DrawingML text box's font size, font color, text fill, text outline, bold, italic, underline, Latin and East Asian fonts, horizontal alignment, vertical anchor inside the box, paragraph spacing, and character spacing.",
      "limits": "不改可见字。不要用 Word 的半磅字号。",
      "limitsEn": "Visible text is not changed. Do not use Word's half-point font size.",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setShapeFormat"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sz": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 100,
          "maximum": 400000
        },
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "textFill": {
          "$ref": "#/$defs/drawingTextFill"
        },
        "textOutline": {
          "$ref": "#/$defs/drawingTextOutline"
        },
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "underline": {
          "$ref": "#/$defs/drawingUnderline"
        },
        "font": {
          "type": "string",
          "minLength": 1
        },
        "eastAsiaFont": {
          "type": "string",
          "minLength": 1
        },
        "align": {
          "$ref": "#/$defs/drawingAlign"
        },
        "textAnchor": {
          "$ref": "#/$defs/drawingTextAnchor"
        },
        "spcBef": {
          "$ref": "#/$defs/drawingTextSpacing"
        },
        "spcAft": {
          "$ref": "#/$defs/drawingTextSpacing"
        },
        "lnSpc": {
          "$ref": "#/$defs/drawingTextSpacing"
        },
        "spc": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": -400000,
          "maximum": 400000
        },
        "kern": {
          "type": [
