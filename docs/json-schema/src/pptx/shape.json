{
  "$comment": "编辑用分块，由 build.py 拼进 request.schema.json。",
  "formats": {
    "insertShapeOp": [
      "xlsx",
      "docx",
      "pptx"
    ],
    "insertConnectorOp": [
      "xlsx",
      "docx",
      "pptx"
    ],
    "deleteConnectorOp": [
      "xlsx",
      "docx",
      "pptx"
    ],
    "groupShapesOp": [
      "xlsx",
      "docx",
      "pptx"
    ],
    "ungroupOp": [
      "xlsx",
      "docx",
      "pptx"
    ],
    "deleteShapeOp": [
      "xlsx",
      "docx",
      "pptx"
    ],
    "setShapePosOp": [
      "docx",
      "pptx"
    ],
    "setShapeSizeOp": [
      "docx",
      "pptx"
    ],
    "setShapeFillOp": [
      "docx",
      "pptx"
    ],
    "setShapeFormatOp": [
      "xlsx",
      "pptx"
    ],
    "setShapeLineOp": [
      "docx",
      "pptx"
    ],
    "setShapeGeomOp": [
      "pptx"
    ],
    "setConnectorOp": [
      "pptx"
    ]
  },
  "$defs": {
    "drawingTextFill": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "none"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "stops"
          ],
          "properties": {
            "type": {
              "const": "gradient"
            },
            "ang": {
              "type": "integer",
              "minimum": 0,
              "maximum": 21600000
            },
            "stops": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "required": [
                  "pos",
                  "color"
                ],
                "additionalProperties": false,
                "properties": {
                  "pos": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  "color": {
                    "type": "string",
                    "minLength": 6,
                    "maxLength": 6
                  }
                }
              }
            }
          }
        }
      ]
    },
    "drawingTextOutline": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "color",
            "width"
          ],
          "properties": {
            "color": {
              "type": "string",
              "minLength": 6,
              "maxLength": 6
            },
            "width": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "drawingTextSpacing": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "val"
          ],
          "properties": {
            "type": {
              "const": "pts"
            },
            "val": {
              "type": "integer",
              "minimum": 0,
              "maximum": 158400
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "val"
          ],
          "properties": {
            "type": {
              "const": "pct"
            },
            "val": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "insertShapeOp": {
      "description": "往幻灯片、备注页、母版或版式插入一个带 p:txBody 的形状。",
      "limits": "缺省 prst 为矩形文本框。不抄版式占位符，不写 <p:timing>。往母版 / 版式插时写出没有 p:ph 的装饰形，不把该 p:sp 抄进各页。插占位符请用 insertPlaceholder。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "insertShape"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "cx": {
          "type": "integer",
          "minimum": 1
        },
        "cy": {
          "type": "integer",
          "minimum": 1
        },
        "prst": {
          "type": "string",
          "minLength": 1
        },
        "sz": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 100,
          "maximum": 400000
        },
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "textFill": {
          "$ref": "#/$defs/drawingTextFill"
        },
        "textOutline": {
          "$ref": "#/$defs/drawingTextOutline"
        },
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "underline": {
          "type": [
            "string",
            "null"
          ]
        },
        "font": {
          "type": "string",
          "minLength": 1
        },
        "eastAsiaFont": {
          "type": "string",
          "minLength": 1
        },
        "align": {
          "type": [
            "string",
            "null"
          ]
        },
        "textAnchor": {
          "type": [
            "string",
            "null"
          ]
        },
        "spcBef": {
          "$ref": "#/$defs/drawingTextSpacing"
        },
        "spcAft": {
          "$ref": "#/$defs/drawingTextSpacing"
        },
        "lnSpc": {
          "$ref": "#/$defs/drawingTextSpacing"
        },
        "spc": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": -400000,
          "maximum": 400000
        },
        "kern": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 400000
        },
        "geom": {
          "$ref": "#/$defs/shapeGeom"
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "anchor": {
          "enum": [
            "oneCell",
            "twoCell"
          ]
        },
        "fromOffX": {
          "type": "integer",
          "minimum": 0
        },
        "fromOffY": {
          "type": "integer",
          "minimum": 0
        },
        "toOffX": {
          "type": "integer",
          "minimum": 0
        },
        "toOffY": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "insertConnectorOp": {
      "description": "往幻灯片、备注页、母版或版式插入一条连接线（p:cxnSp）。",
      "limits": "不算自动绕障碍。省略 start / end 时不写 a:stCxn / a:endCxn。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "insertConnector"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "prst": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "cx": {
          "type": "integer",
          "minimum": 1
        },
        "cy": {
          "type": "integer",
          "minimum": 1
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "anchor": {
          "enum": [
            "oneCell",
            "twoCell"
          ]
        },
        "fromOffX": {
          "type": "integer",
          "minimum": 0
        },
        "fromOffY": {
          "type": "integer",
          "minimum": 0
        },
        "toOffX": {
          "type": "integer",
          "minimum": 0
        },
        "toOffY": {
          "type": "integer",
          "minimum": 0
        },
        "start": {
          "$ref": "#/$defs/connectorEnd"
        },
        "end": {
          "$ref": "#/$defs/connectorEnd"
        }
      }
    },
    "deleteConnectorOp": {
      "description": "删掉一条连接线。",
      "limits": "找不到该连接线报 IdNotFound。id 不是连接线 id 报 InvalidId。删掉对应 p:cxnSp。 若在 mc:AlternateContent 的 Choice 里，整段 AlternateContent 删掉。删组合内连接线后若组合空了，把空 p:grpSp 一并摘掉。不改其它对象的 cNvPr/@id。 按被删连接线的 cNvPr/@id 清掉本页 <p:timing> 里对应的 p:tgtEl。docx 见 [docx 分册](json-contract-docx.md#deleteconnector)。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "deleteConnector"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "groupShapesOp": {
      "description": "把同一页 spTree 上至少两个直接子对象包进一个新 p:grpSp。",
      "limits": "组合本身不进 inspect 树。",
      "type": "object",
      "required": [
        "op",
        "id",
        "ids"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "groupShapes"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "ids": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "ungroupOp": {
      "description": "解开某个成员所在的 p:grpSp，子节点抬回父节点。",
      "limits": "组合本身没有 inspect id。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "ungroup"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "deleteShapeOp": {
      "description": "删掉一个形状。",
      "limits": "找不到该形状报 IdNotFound。id 不是形状 id 报 InvalidId。对母版、版式、备注母版或讲义占位符 id 发本 op 报 InvalidId。 插删占位符请用 insertPlaceholder / deletePlaceholder。对备注页、备注母版或讲义上占位符 p:ph/@type 为 sldImg 的形状发本 op 报 InvalidField，不写文件。 删掉对应 p:sp。若在 mc:AlternateContent 的 Choice 里，整段 AlternateContent 删掉。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "deleteShape"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "setShapePosOp": {
      "description": "写入该 p:sp 或 p:cxnSp 的 p:spPr/a:xfrm/a:off。",
      "limits": "没有 xfrm 则补。找不到报 IdNotFound。id 不是形状 id 也不是连接线 id 报 InvalidId。x 与 y 一个都不给报 InvalidField。对 sldImg 占位符报 InvalidField。母版 / 版式占位符与装饰形只改对应 slideMaster / slideLayout 部件，不改各页 XML。备注母版只改 notesMaster 部件。讲义只改 handoutMaster 部件。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setShapePos"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        }
      },
      "anyOf": [
        {
          "required": [
            "x"
          ]
        },
        {
          "required": [
            "y"
          ]
        }
      ]
    },
    "setShapeSizeOp": {
      "description": "写入该 p:sp 或 p:cxnSp 的 p:spPr/a:xfrm/a:ext。",
      "limits": "没有 xfrm 则补。找不到报 IdNotFound。id 不是形状 id 也不是连接线 id 报 InvalidId。cx 与 cy 一个都不给报 InvalidField。对 sldImg 占位符报 InvalidField。母版 / 版式占位符与装饰形只改对应 slideMaster / slideLayout 部件。备注母版只改 notesMaster 部件。讲义只改 handoutMaster 部件。对已组合的子对象只改该子 xfrm，不重算父组合框。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setShapeSize"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "cx": {
          "type": "integer",
          "minimum": 1
        },
        "cy": {
          "type": "integer",
          "minimum": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "cx"
          ]
        },
        {
          "required": [
            "cy"
          ]
        }
      ]
    },
    "setShapeFillOp": {
      "description": "写入 p:spPr 的 a:solidFill/a:srgbClr；null 则写成 a:noFill，并去掉原有填充。",
      "limits": "缺 color 或非法十六进制报 InvalidField。找不到报 IdNotFound。id 不是形状 id 报 InvalidId。对母版或版式占位符 id 发本 op 报 InvalidId。对 sldImg 占位符报 InvalidField。母版 / 版式装饰形只改对应 slideMaster / slideLayout 部件，不改各页 XML。docx / xlsx 上发此 op 报 InvalidField。",
      "type": "object",
      "required": [
        "op",
        "id",
        "color"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setShapeFill"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "color": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "setShapeFormatOp": {
      "description": "改 DrawingML 文本框的字号、字色、字填充、字轮廓、加粗、斜体、下划线、中英文字体、水平对齐、框内垂直锚点、段落间距与字符间距。",
      "limits": "不改可见字。不要用 Word 的半磅字号。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setShapeFormat"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sz": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 100,
          "maximum": 400000
        },
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "textFill": {
          "$ref": "#/$defs/drawingTextFill"
        },
        "textOutline": {
          "$ref": "#/$defs/drawingTextOutline"
        },
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "underline": {
          "type": [
            "string",
            "null"
          ]
        },
        "font": {
          "type": "string",
          "minLength": 1
        },
        "eastAsiaFont": {
          "type": "string",
          "minLength": 1
        },
        "align": {
          "type": [
            "string",
            "null"
          ]
        },
        "textAnchor": {
          "type": [
            "string",
            "null"
          ]
        },
        "spcBef": {
          "$ref": "#/$defs/drawingTextSpacing"
        },
        "spcAft": {
          "$ref": "#/$defs/drawingTextSpacing"
        },
        "lnSpc": {
          "$ref": "#/$defs/drawingTextSpacing"
        },
        "spc": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": -400000,
          "maximum": 400000
        },
        "kern": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 400000
        }
      },
      "anyOf": [
        {
          "required": [
            "sz"
          ]
        },
        {
          "required": [
            "color"
          ]
        },
        {
          "required": [
            "bold"
          ]
        },
        {
          "required": [
            "italic"
          ]
        },
        {
          "required": [
            "underline"
          ]
        },
        {
          "required": [
            "font"
          ]
        },
        {
          "required": [
            "eastAsiaFont"
          ]
        },
        {
          "required": [
            "align"
          ]
        },
        {
          "required": [
            "textAnchor"
          ]
        },
        {
          "required": [
            "spcBef"
          ]
        },
        {
          "required": [
            "spcAft"
          ]
        },
        {
          "required": [
            "lnSpc"
          ]
        },
        {
          "required": [
            "spc"
          ]
        },
        {
          "required": [
            "kern"
          ]
        },
        {
          "required": [
            "textFill"
          ]
        },
        {
          "required": [
            "textOutline"
          ]
        }
      ]
    },
    "setShapeLineOp": {
      "description": "写入 p:spPr/a:ln。",
      "limits": "color 为 null 时写成 a:ln/a:noFill；此时出现 width 报 InvalidField。缺 color 或非法十六进制报 InvalidField。找不到报 IdNotFound。id 不是形状 id 也不是连接线 id 报 InvalidId。对母版或版式占位符 id 发本 op 报 InvalidId。对 sldImg 占位符报 InvalidField。母版 / 版式装饰形只改对应 slideMaster / slideLayout 部件，不改各页 XML。",
      "type": "object",
      "required": [
        "op",
        "id",
        "color"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setShapeLine"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "shapeGeom": {
      "type": "object",
      "required": [
        "paths"
      ],
      "additionalProperties": false,
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/shapeGeomPath"
          }
        }
      }
    },
    "shapeGeomPath": {
      "type": "object",
      "required": [
        "w",
        "h",
        "ops"
      ],
      "additionalProperties": false,
      "properties": {
        "w": {
          "type": "integer",
          "minimum": 1
        },
        "h": {
          "type": "integer",
          "minimum": 1
        },
        "ops": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/shapeGeomPathOp"
          }
        }
      }
    },
    "shapeGeomPathOp": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "moveTo",
            "lnTo",
            "close"
          ]
        },
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "connectorEnd": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "site": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "setShapeGeomOp": {
      "description": "把带 p:txBody 的 p:sp 的 a:prstGeom 或已有 a:custGeom 整份换成自定义路径。",
      "limits": "不重算组合框。",
      "type": "object",
      "required": [
        "op",
        "id",
        "paths"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setShapeGeom"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/shapeGeomPath"
          }
        }
      }
    },
    "setConnectorOp": {
      "description": "改一条已有连接线的起点 / 终点绑定。",
      "limits": "不算自动绕障碍。不改画布坐标。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setConnector"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "$ref": "#/$defs/connectorEnd"
        },
        "end": {
          "$ref": "#/$defs/connectorEnd"
        }
      }
    }
  }
}
