  "$defs": {
    "drawingTextFill": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "none"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "stops"
          ],
          "properties": {
            "type": {
              "const": "gradient"
            },
            "ang": {
              "type": "integer",
              "minimum": 0,
              "maximum": 21600000
            },
            "stops": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "required": [
                  "pos",
                  "color"
                ],
                "additionalProperties": false,
                "properties": {
                  "pos": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  "color": {
                    "type": "string",
                    "minLength": 6,
                    "maxLength": 6
                  }
                }
              }
            }
          }
        }
      ]
    },
    "drawingTextOutline": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "color",
            "width"
          ],
          "properties": {
            "color": {
              "type": "string",
              "minLength": 6,
              "maxLength": 6
            },
            "width": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "drawingTextSpacing": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "val"
          ],
          "properties": {
            "type": {
              "const": "pts"
            },
            "val": {
              "type": "integer",
              "minimum": 0,
              "maximum": 158400
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "val"
          ],
          "properties": {
            "type": {
              "const": "pct"
            },
            "val": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "insertShapeOp": {
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "insertShape"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "cx": {
          "type": "integer",
          "minimum": 1
        },
        "cy": {
          "type": "integer",
          "minimum": 1
        },
        "prst": {
          "type": "string",
          "minLength": 1
        },
        "sz": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 100,
          "maximum": 400000
        },
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "textFill": {
          "$ref": "#/$defs/drawingTextFill"
        },
        "textOutline": {
          "$ref": "#/$defs/drawingTextOutline"
        },
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "underline": {
          "type": [
            "string",
            "null"
          ]
        },
        "font": {
          "type": "string",
          "minLength": 1
        },
        "eastAsiaFont": {
          "type": "string",
          "minLength": 1
        },
        "align": {
          "type": [
            "string",
            "null"
          ]
        },
        "textAnchor": {
          "type": [
            "string",
            "null"
          ]
        },
        "spcBef": {
          "$ref": "#/$defs/drawingTextSpacing"
        },
        "spcAft": {
          "$ref": "#/$defs/drawingTextSpacing"
        },
        "lnSpc": {
          "$ref": "#/$defs/drawingTextSpacing"
        },
        "spc": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": -400000,
          "maximum": 400000
