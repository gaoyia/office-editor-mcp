{
  "$comment": "编辑用分块，由 build.py 拼进 request.schema.json。",
  "formats": {
    "setTableCellTextOp": [
      "pptx"
    ],
    "setTablePosOp": [
      "pptx"
    ],
    "setTableSizeOp": [
      "pptx"
    ],
    "setTableColWidthsOp": [
      "pptx"
    ],
    "setTableTrHeightOp": [
      "pptx"
    ],
    "setTableCellFillOp": [
      "pptx"
    ],
    "setTableCellBordersOp": [
      "pptx"
    ],
    "setTableCellInsetOp": [
      "pptx"
    ],
    "setTableCellPrOp": [
      "pptx"
    ],
    "setTableStyleRefOp": [
      "pptx"
    ]
  },
  "$defs": {
    "pptxTableCreate": {
      "type": "object",
      "required": [
        "rows",
        "cols"
      ],
      "additionalProperties": false,
      "properties": {
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "cols": {
          "type": "integer",
          "minimum": 1,
          "maximum": 75
        },
        "cells": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/pptxTableCellCreate"
            }
          }
        },
        "hyperlink": {
          "$ref": "#/$defs/pptxObjectHyperlinkCreate"
        },
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "cx": {
          "type": "integer",
          "minimum": 1
        },
        "cy": {
          "type": "integer",
          "minimum": 1
        },
        "colWidths": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "rowHeights": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "tableStyleId": {
          "type": [
            "string",
            "null"
          ]
        },
        "tblLook": {
          "oneOf": [
            {
              "$ref": "#/$defs/pptxTblLook"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "pptxTableCellCreate": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "minLength": 1
            },
            "file": {
              "type": "string",
              "minLength": 1
            },
            "slide": {
              "type": "integer",
              "minimum": 1
            },
            "tooltip": {
              "type": "string"
            },
            "event": {
              "enum": [
                "click",
                "hover"
              ]
            },
            "fill": {
              "$ref": "#/$defs/pptxTableCellFill"
            },
            "borders": {
              "$ref": "#/$defs/tableCellBorders"
            },
            "cellMar": {
              "$ref": "#/$defs/tableCellMar"
            },
            "vert": {
              "$ref": "#/$defs/pptxTextVerticalType"
            },
            "anchorCtr": {
              "type": "boolean"
            },
            "horzOverflow": {
              "enum": [
                "overflow",
                "clip"
              ]
            },
            "cell3D": {
              "$ref": "#/$defs/pptxTableCell3D"
            },
            "headers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "setTableCellTextOp": {
      "type": "object",
      "required": [
        "op",
        "id",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setTableCellText"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        }
      }
    },
    "setTablePosOp": {
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setTablePos"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "setTableSizeOp": {
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setTableSize"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "cx": {
          "type": "integer",
          "minimum": 1
        },
        "cy": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "setTableColWidthsOp": {
      "type": "object",
      "required": [
        "op",
        "id",
        "cols"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setTableColWidths"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "cols": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "setTableTrHeightOp": {
      "type": "object",
      "required": [
        "op",
        "id",
        "h"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setTableTrHeight"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "h": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "tableCellBorderSide": {
      "type": "object",
      "required": [
        "color",
        "width"
      ],
      "additionalProperties": false,
      "properties": {
        "color": {
          "type": "string",
          "minLength": 6,
          "maxLength": 6
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "dash": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "tableCellBorders": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "left": {
          "oneOf": [
            {
              "$ref": "#/$defs/tableCellBorderSide"
            },
            {
              "type": "null"
            }
          ]
        },
        "right": {
          "oneOf": [
            {
              "$ref": "#/$defs/tableCellBorderSide"
            },
            {
              "type": "null"
            }
          ]
        },
        "top": {
          "oneOf": [
            {
              "$ref": "#/$defs/tableCellBorderSide"
            },
            {
              "type": "null"
            }
          ]
        },
        "bottom": {
          "oneOf": [
            {
              "$ref": "#/$defs/tableCellBorderSide"
            },
            {
              "type": "null"
            }
          ]
        },
        "tl2br": {
          "oneOf": [
            {
              "$ref": "#/$defs/tableCellBorderSide"
            },
            {
              "type": "null"
            }
          ]
        },
        "bl2tr": {
          "oneOf": [
            {
              "$ref": "#/$defs/tableCellBorderSide"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "setTableCellFillOp": {
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setTableCellFill"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "fill": {
          "$ref": "#/$defs/pptxTableCellFill"
        },
        "file": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "pptxTableCellFill": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 6,
          "maxLength": 6
        },
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "solid",
                "grad",
                "patt",
                "blip"
              ]
            },
            "color": {
              "type": "string",
              "minLength": 6,
              "maxLength": 6
            },
            "ang": {
              "type": "integer",
              "minimum": 0,
              "maximum": 21600000
            },
            "stops": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "required": [
                  "pos",
                  "color"
                ],
                "additionalProperties": false,
                "properties": {
                  "pos": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  "color": {
                    "type": "string",
                    "minLength": 6,
                    "maxLength": 6
                  }
                }
              }
            },
            "prst": {
              "$ref": "#/$defs/pptxPresetPatternVal"
            },
            "fg": {
              "type": "string",
              "minLength": 6,
              "maxLength": 6
            },
            "bg": {
              "type": "string",
              "minLength": 6,
              "maxLength": 6
            },
            "file": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "pptxPresetPatternVal": {
      "enum": [
        "pct5",
        "pct10",
        "pct20",
        "pct25",
        "pct30",
        "pct40",
        "pct50",
        "pct60",
        "pct70",
        "pct75",
        "pct80",
        "pct90",
        "horz",
        "vert",
        "ltHorz",
        "ltVert",
        "dkHorz",
        "dkVert",
        "narHorz",
        "narVert",
        "dashHorz",
        "dashVert",
        "cross",
        "dnDiag",
        "upDiag",
        "ltDnDiag",
        "ltUpDiag",
        "dkDnDiag",
        "dkUpDiag",
        "wdDnDiag",
        "wdUpDiag",
        "dashDnDiag",
        "dashUpDiag",
        "diagCross",
        "smCheck",
        "lgCheck",
        "smGrid",
        "lgGrid",
        "dotGrid",
        "smConfetti",
        "lgConfetti",
        "horzBrick",
        "diagBrick",
        "solidDmnd",
        "openDmnd",
        "dotDmnd",
        "plaid",
        "sphere",
        "weave",
        "divot",
        "shingle",
        "wave",
        "trellis",
        "zigZag"
      ]
    },
    "setTableCellBordersOp": {
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setTableCellBorders"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "left": {
          "oneOf": [
            {
              "$ref": "#/$defs/tableCellBorderSide"
            },
            {
              "type": "null"
            }
          ]
        },
        "right": {
          "oneOf": [
            {
              "$ref": "#/$defs/tableCellBorderSide"
            },
            {
              "type": "null"
            }
          ]
        },
        "top": {
          "oneOf": [
            {
              "$ref": "#/$defs/tableCellBorderSide"
            },
            {
              "type": "null"
            }
          ]
        },
        "bottom": {
          "oneOf": [
            {
              "$ref": "#/$defs/tableCellBorderSide"
            },
            {
              "type": "null"
            }
          ]
        },
        "tl2br": {
          "oneOf": [
            {
              "$ref": "#/$defs/tableCellBorderSide"
            },
            {
              "type": "null"
            }
          ]
        },
        "bl2tr": {
          "oneOf": [
            {
              "$ref": "#/$defs/tableCellBorderSide"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "tableCellMar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "top": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "left": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "bottom": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "right": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "setTableCellInsetOp": {
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setTableCellInset"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "top": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "left": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "bottom": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "right": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "setTableCellPrOp": {
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setTableCellPr"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "vert": {
          "oneOf": [
            {
              "$ref": "#/$defs/pptxTextVerticalType"
            },
            {
              "type": "null"
            }
          ]
        },
        "anchorCtr": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "horzOverflow": {
          "oneOf": [
            {
              "enum": [
                "overflow",
                "clip"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "cell3D": {
          "oneOf": [
            {
              "$ref": "#/$defs/pptxTableCell3D"
            },
            {
              "type": "null"
            }
          ]
        },
        "headers": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "setTableStyleRefOp": {
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setTableStyleRef"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "tableStyleId": {
          "type": [
            "string",
            "null"
          ]
        },
        "tblLook": {
          "oneOf": [
            {
              "$ref": "#/$defs/pptxTblLook"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "pptxTblLook": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "firstRow": {
          "type": "boolean"
        },
        "firstCol": {
          "type": "boolean"
        },
        "lastRow": {
          "type": "boolean"
        },
        "lastCol": {
          "type": "boolean"
        },
        "bandRow": {
          "type": "boolean"
        },
        "bandCol": {
          "type": "boolean"
        }
      }
    },
    "pptxTableCell3D": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prstMaterial": {
          "$ref": "#/$defs/pptxPresetMaterialType"
        },
        "bevel": {
          "$ref": "#/$defs/pptxBevel"
        }
      }
    },
    "pptxBevel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prst": {
          "$ref": "#/$defs/pptxBevelPresetType"
        },
        "w": {
          "type": "integer",
          "minimum": 1
        },
        "h": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "pptxTextVerticalType": {
      "enum": [
        "horz",
        "vert",
        "vert270",
        "wordArtVert",
        "eaVert",
        "mongolianVert",
        "wordArtVertRtl"
      ]
    },
    "pptxBevelPresetType": {
      "enum": [
        "relaxedInset",
        "circle",
        "slope",
        "cross",
        "angle",
        "softRound",
        "convex",
        "coolSlant",
        "divot",
        "riblet",
        "hardEdge",
        "artDeco"
      ]
    },
    "pptxPresetMaterialType": {
      "enum": [
        "legacyMatte",
        "legacyPlastic",
        "legacyMetal",
        "legacyWireframe",
        "matte",
        "plastic",
        "metal",
        "warmMatte",
        "translucentPowder",
        "powder",
        "dkEdge",
        "softEdge",
        "clear",
        "flat",
        "softmetal"
      ]
    }
  }
}
