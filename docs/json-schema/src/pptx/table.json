      "descriptionEn": "Change marT / marL / marB / marR on one cell's a:tcPr.",
      "limits": "不要用 docx 的 setTableCellMar 或 setCellFormat。",
      "limitsEn": "Do not use docx setTableCellMar or setCellFormat.",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
