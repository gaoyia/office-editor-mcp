{
  "$comment": "编辑用分块，由 build.py 拼进 request.schema.json。",
  "formats": {
    "setTableCellTextOp": [
      "pptx"
    ],
    "setTablePosOp": [
      "pptx"
    ],
    "setTableSizeOp": [
      "pptx"
    ],
    "setTableColWidthsOp": [
      "pptx"
    ],
    "setTableTrHeightOp": [
      "pptx"
    ],
    "setTableCellFillOp": [
      "pptx"
    ],
    "setTableCellBordersOp": [
      "pptx"
    ],
    "setTableCellInsetOp": [
      "pptx"
    ],
    "setTableCellPrOp": [
      "pptx"
    ],
    "setTableStyleRefOp": [
      "pptx"
    ]
  },
  "$defs": {
    "pptxTableCreate": {
      "type": "object",
      "required": [
        "rows",
        "cols"
      ],
      "additionalProperties": false,
      "properties": {
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "cols": {
          "type": "integer",
          "minimum": 1,
          "maximum": 75
        },
        "cells": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/pptxTableCellCreate"
            }
          }
        },
        "hyperlink": {
          "$ref": "#/$defs/pptxObjectHyperlinkCreate"
        },
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "cx": {
          "type": "integer",
          "minimum": 1
        },
        "cy": {
          "type": "integer",
          "minimum": 1
        },
        "colWidths": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "rowHeights": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "tableStyleId": {
          "type": [
            "string",
            "null"
          ]
        },
        "tblLook": {
          "oneOf": [
            {
              "$ref": "#/$defs/pptxTblLook"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "pptxTableCellCreate": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "minLength": 1
            },
            "file": {
              "type": "string",
              "minLength": 1
            },
            "slide": {
              "type": "integer",
              "minimum": 1
            },
            "tooltip": {
              "type": "string"
            },
            "event": {
              "enum": [
                "click",
                "hover"
              ]
            },
            "fill": {
              "$ref": "#/$defs/pptxTableCellFill"
            },
            "borders": {
              "$ref": "#/$defs/tableCellBorders"
            },
            "cellMar": {
              "$ref": "#/$defs/tableCellMar"
            },
            "vert": {
              "$ref": "#/$defs/pptxTextVerticalType"
            },
            "anchorCtr": {
              "type": "boolean"
            },
            "horzOverflow": {
              "enum": [
                "overflow",
                "clip"
              ]
            },
            "cell3D": {
              "$ref": "#/$defs/pptxTableCell3D"
            },
            "headers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "setTableCellTextOp": {
      "description": "改幻灯片 DrawingML 表某一格的可见文字。",
      "descriptionEn": "Change the visible text of one cell in a slide DrawingML table.",
      "limits": "手术刀规则与 setShapeText 相同，目标是该 a:tc 的 a:txBody，不整格重建。",
      "limitsEn": "The surgical-edit rule matches setShapeText. The target is that a:tc's a:txBody. The cell is not rebuilt as a whole.",
      "type": "object",
      "required": [
        "op",
        "id",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setTableCellText"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        }
      }
    },
    "setTablePosOp": {
      "description": "写入该 p:graphicFrame 的 p:xfrm/a:off。",
      "descriptionEn": "Writes p:xfrm/a:off on that p:graphicFrame.",
      "limits": "没有 xfrm 则补。只改画布坐标，不重分配 gridCol/@w 与 tr/@h。找不到报表 IdNotFound。id 不是表 id 报 InvalidId。x 与 y 一个都不给报 InvalidField。docx / xlsx 上发此 op 报 InvalidField。",
      "limitsEn": "If xfrm is missing, add one. Only canvas coordinates change. gridCol/@w and tr/@h are not redistributed. A missing table returns IdNotFound. An id that is not a table id returns InvalidId. Giving neither x nor y returns InvalidField. This op on docx / xlsx returns InvalidField.",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setTablePos"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "setTableSizeOp": {
      "description": "写入该 p:graphicFrame 的 p:xfrm/a:ext。",
      "descriptionEn": "Writes p:xfrm/a:ext on that p:graphicFrame.",
      "limits": "没有 xfrm 则补。只改框尺寸，不算自动列宽，不重分配 a:gridCol/@w 与 a:tr/@h。找不到报表 IdNotFound。id 不是表 id 报 InvalidId。cx 与 cy 一个都不给报 InvalidField。docx / xlsx 上发此 op 报 InvalidField。",
      "limitsEn": "If xfrm is missing, add one. Only the frame size changes. Column width is not calculated automatically, and a:gridCol/@w and a:tr/@h are not redistributed. A missing table returns IdNotFound. An id that is not a table id returns InvalidId. Giving neither cx nor cy returns InvalidField. This op on docx / xlsx returns InvalidField.",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setTableSize"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "cx": {
          "type": "integer",
          "minimum": 1
        },
        "cy": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "setTableColWidthsOp": {
      "description": "只写 a:tblGrid 的 a:gridCol/@w。",
      "descriptionEn": "Write only a:gridCol/@w on a:tblGrid.",
      "limits": "没有网格则补 a:tblGrid。不改 p:xfrm。不改各格 tcW。找不到报表 IdNotFound。id 不是表 id 报 InvalidId。缺 cols、不是数组、长度对不上 colCount、或某项不是正整数报 InvalidField。docx / xlsx 上发此 op 报 InvalidField。不要复用 Word 的 setTableWidth（单位是 twip）。不要复用 xlsx 的 setColWidth。",
      "limitsEn": "If there is no grid, add a:tblGrid. p:xfrm is unchanged. Each cell's tcW is unchanged. A missing table returns IdNotFound. An id that is not a table id returns InvalidId. A missing cols, a value that is not an array, a length that does not match colCount, or an item that is not a positive integer returns InvalidField. This op on docx / xlsx returns InvalidField. Do not reuse Word setTableWidth (the unit is twip). Do not reuse xlsx setColWidth.",
      "type": "object",
      "required": [
        "op",
        "id",
        "cols"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setTableColWidths"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "cols": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "setTableTrHeightOp": {
      "description": "只改该行 @h。",
      "descriptionEn": "Change only that row's @h.",
      "limits": "不改框 p:xfrm。找不到该行报 IdNotFound。id 不是行 id 报 InvalidId。缺 h、或不是正整数报 InvalidField。a:tr/@h 必填，h: null 报 InvalidField。inspect 缺 @h 仍报 null。docx / xlsx 上发此 op 报 InvalidField。不要复用 Word 的 setTableRowHeight（单位是 twip）。不要复用 xlsx 的 setRowHeight。",
      "limitsEn": "The frame's p:xfrm is unchanged. A missing row returns IdNotFound. An id that is not a row id returns InvalidId. A missing h, or a value that is not a positive integer, returns InvalidField. a:tr/@h is required. h: null returns InvalidField. When inspect finds no @h, it still reports null. This op on docx / xlsx returns InvalidField. Do not reuse Word setTableRowHeight (the unit is twip). Do not reuse xlsx setRowHeight.",
      "type": "object",
      "required": [
        "op",
        "id",
        "h"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setTableTrHeight"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "h": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "tableCellBorderSide": {
      "type": "object",
      "required": [
        "color",
        "width"
      ],
      "additionalProperties": false,
      "properties": {
        "color": {
          "type": "string",
          "minLength": 6,
          "maxLength": 6
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "dash": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "tableCellBorders": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "left": {
          "oneOf": [
            {
              "$ref": "#/$defs/tableCellBorderSide"
            },
            {
              "type": "null"
            }
          ]
        },
        "right": {
          "oneOf": [
            {
              "$ref": "#/$defs/tableCellBorderSide"
            },
            {
              "type": "null"
            }
          ]
        },
        "top": {
          "oneOf": [
            {
              "$ref": "#/$defs/tableCellBorderSide"
            },
            {
              "type": "null"
            }
          ]
        },
        "bottom": {
          "oneOf": [
            {
              "$ref": "#/$defs/tableCellBorderSide"
            },
            {
              "type": "null"
            }
          ]
        },
        "tl2br": {
          "oneOf": [
            {
              "$ref": "#/$defs/tableCellBorderSide"
            },
            {
              "type": "null"
            }
          ]
        },
        "bl2tr": {
          "oneOf": [
            {
              "$ref": "#/$defs/tableCellBorderSide"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "setTableCellFillOp": {
      "description": "改某一格 a:tcPr 的填充（EG_FillProperties）。",
      "descriptionEn": "Change the fill on one cell's a:tcPr (EG_FillProperties).",
      "limits": "不要用 setShapeFill。不要用 docx 的 setCellFormat。theme 色仍不展开成 RGB。备注表、母版表同样认。",
      "limitsEn": "Do not use setShapeFill. Do not use docx setCellFormat. Theme colors are still not expanded to RGB. Notes tables and master tables are accepted the same way.",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setTableCellFill"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "fill": {
          "$ref": "#/$defs/pptxTableCellFill"
        },
        "file": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "pptxTableCellFill": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 6,
          "maxLength": 6
        },
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "solid",
                "grad",
                "patt",
                "blip"
              ]
            },
            "color": {
              "type": "string",
              "minLength": 6,
              "maxLength": 6
            },
            "ang": {
              "type": "integer",
              "minimum": 0,
              "maximum": 21600000
            },
            "stops": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "required": [
                  "pos",
                  "color"
                ],
                "additionalProperties": false,
                "properties": {
                  "pos": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  "color": {
                    "type": "string",
                    "minLength": 6,
                    "maxLength": 6
                  }
                }
              }
            },
            "prst": {
              "$ref": "#/$defs/pptxPresetPatternVal"
            },
            "fg": {
              "type": "string",
              "minLength": 6,
              "maxLength": 6
            },
            "bg": {
              "type": "string",
              "minLength": 6,
              "maxLength": 6
            },
            "file": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
