        "ltDnDiag",
        "ltUpDiag",
        "dkDnDiag",
        "dkUpDiag",
        "wdDnDiag",
        "wdUpDiag",
        "dashDnDiag",
        "dashUpDiag",
        "diagCross",
        "smCheck",
        "lgCheck",
        "smGrid",
        "lgGrid",
        "dotGrid",
        "smConfetti",
        "lgConfetti",
        "horzBrick",
        "diagBrick",
        "solidDmnd",
        "openDmnd",
        "dotDmnd",
        "plaid",
        "sphere",
        "weave",
        "divot",
        "shingle",
        "wave",
        "trellis",
        "zigZag"
      ]
    },
    "setTableCellBordersOp": {
      "description": "改某一格 a:tcPr 的六边。",
      "descriptionEn": "Change the six edges of one cell's a:tcPr.",
      "limits": "未点名的边留下。不要用 setShapeLine。",
      "limitsEn": "Edges you did not name stay. Do not use setShapeLine.",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setTableCellBorders"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "left": {
          "oneOf": [
            {
              "$ref": "#/$defs/tableCellBorderSide"
            },
            {
              "type": "null"
            }
          ]
        },
        "right": {
          "oneOf": [
            {
              "$ref": "#/$defs/tableCellBorderSide"
            },
            {
              "type": "null"
            }
          ]
        },
        "top": {
          "oneOf": [
            {
              "$ref": "#/$defs/tableCellBorderSide"
            },
            {
              "type": "null"
            }
          ]
        },
        "bottom": {
          "oneOf": [
            {
              "$ref": "#/$defs/tableCellBorderSide"
            },
            {
              "type": "null"
            }
          ]
        },
        "tl2br": {
          "oneOf": [
            {
              "$ref": "#/$defs/tableCellBorderSide"
            },
            {
              "type": "null"
            }
          ]
        },
        "bl2tr": {
          "oneOf": [
            {
              "$ref": "#/$defs/tableCellBorderSide"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "tableCellMar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "top": {
          "type": [
