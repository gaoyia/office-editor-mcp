            "integer",
            "null"
          ],
          "minimum": 0
        },
        "right": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "setTableCellPrOp": {
      "description": "改某一格 a:tcPr 上 44 / 45 / 50 未覆盖的属性与子元：vert、anchorCtr、horzOverflow、cell3D、headers。",
      "descriptionEn": "Change attributes and child elements of one cell's a:tcPr that 44 / 45 / 50 do not cover: vert, anchorCtr, horzOverflow, cell3D, and headers.",
      "limits": "不要改 C9 的 textAnchor。不要写 tcPr/@anchor。不要用 setShapeFormat。备注表、母版表同样认。",
      "limitsEn": "Do not change C9 textAnchor. Do not write tcPr/@anchor. Do not use setShapeFormat. Notes tables and master tables are accepted the same way.",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setTableCellPr"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "vert": {
          "oneOf": [
            {
              "$ref": "#/$defs/pptxTextVerticalType"
            },
            {
              "type": "null"
            }
          ]
        },
        "anchorCtr": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "horzOverflow": {
          "oneOf": [
            {
              "enum": [
                "overflow",
                "clip"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "cell3D": {
          "oneOf": [
            {
              "$ref": "#/$defs/pptxTableCell3D"
            },
            {
              "type": "null"
            }
          ]
        },
        "headers": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "setTableStyleRefOp": {
      "description": "改某一张 DrawingML 表上的样式 GUID 与 a:tblPr 行列开关。",
      "descriptionEn": "Change the style GUID and the a:tblPr row and column switches on one DrawingML table.",
      "limits": "不要用 docx 的 setTableStyle。不要读写 /ppt/tableStyles.xml。备注表、母版表同样认。",
      "limitsEn": "Do not use docx setTableStyle. Do not read or write /ppt/tableStyles.xml. Notes tables and master tables are accepted the same way.",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setTableStyleRef"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "tableStyleId": {
          "type": [
            "string",
            "null"
          ]
        },
        "tblLook": {
          "oneOf": [
            {
              "$ref": "#/$defs/pptxTblLook"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "pptxTblLook": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "firstRow": {
          "type": "boolean"
        },
        "firstCol": {
          "type": "boolean"
        },
        "lastRow": {
          "type": "boolean"
        },
        "lastCol": {
          "type": "boolean"
        },
