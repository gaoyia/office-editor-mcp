{
  "$comment": "编辑用分块，由 build.py 拼进 request.schema.json。",
  "formats": {
    "setPicturePosOp": [
      "pptx"
    ],
    "setChartPosOp": [
      "pptx"
    ],
    "setSmartArtPosOp": [
      "pptx"
    ],
    "pptxInsertModel3dOp": [
      "pptx"
    ],
    "pptxReplaceModel3dOp": [
      "pptx"
    ],
    "pptxDeleteModel3dOp": [
      "pptx"
    ],
    "setModel3dPosOp": [
      "pptx"
    ],
    "pptxInsertInkOp": [
      "pptx"
    ],
    "pptxReplaceInkOp": [
      "pptx"
    ],
    "pptxDeleteInkOp": [
      "pptx"
    ],
    "pptxSetInkSizeOp": [
      "pptx"
    ],
    "pptxInsertOleOp": [
      "pptx"
    ],
    "pptxDeleteOleOp": [
      "pptx"
    ],
    "pptxSetOleSizeOp": [
      "pptx"
    ],
    "setInkPosOp": [
      "pptx"
    ],
    "pptxInsertMathOp": [
      "pptx"
    ],
    "pptxSetMathOp": [
      "pptx"
