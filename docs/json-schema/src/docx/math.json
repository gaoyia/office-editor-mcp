{
  "$comment": "编辑用分块，由 build.py 拼进 request.schema.json。",
  "formats": {
    "docxInsertMathOp": [
      "docx"
    ],
    "docxSetMathOp": [
      "docx"
    ],
    "insertRubyOp": [
      "docx"
    ],
    "setRubyOp": [
      "docx"
    ],
    "deleteRubyOp": [
      "docx"
    ],
    "setEastAsianSettingsOp": [
      "docx"
    ],
    "docxDeleteMathOp": [
      "docx"
    ]
  },
  "$defs": {
    "mathNode": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "text",
            "frac",
            "rad",
            "sSub",
            "sSup",
            "sSubSup",
            "sPre",
            "nary",
            "delim",
            "func",
            "mat",
            "acc",
            "bar",
            "limLow",
            "limUpp",
            "eqArr",
            "phant",
            "borderBox"
          ]
        }
      }
    },
    "docxInsertMathOp": {
      "description": "在 Word 段落里插入公式。",
      "limits": "text 和 expr 恰好给一个，不能同时给。kind 缺省是 inline，display 才单独成段。不要套用 xlsx 或 pptx 的坐标字段。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "insertMath"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "expr": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/mathNode"
          }
        },
        "kind": {
          "enum": [
            "inline",
            "display"
          ]
        },
        "jc": {
          "enum": [
            "center",
            "centerGroup",
            "left",
            "right"
          ]
        }
      }
    },
    "docxSetMathOp": {
      "description": "改 Word 段落里已有的公式。",
      "limits": "text 和 expr 恰好给一个；只改对齐时可以只给 jc。不改 kind。不要套用 xlsx 或 pptx 的公式框字段。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setMath"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "expr": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/mathNode"
          }
        },
        "jc": {
          "anyOf": [
            {
              "enum": [
                "center",
                "centerGroup",
                "left",
                "right"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "eastAsianLayout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer"
        },
        "combine": {
          "type": "boolean"
        },
        "combineBrackets": {
          "enum": [
            "none",
            "round",
            "square",
            "angle",
            "curly"
          ]
        },
        "vert": {
          "type": "boolean"
        },
        "vertCompress": {
          "type": "boolean"
        }
      }
    },
    "kinsokuChars": {
      "type": "object",
      "required": [
        "lang",
        "chars"
      ],
      "additionalProperties": false,
      "properties": {
        "lang": {
          "type": "string",
          "minLength": 1
        },
        "chars": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "insertRubyOp": {
      "description": "在点名段末尾追加一个 w:r，里面是 w:ruby（rubyPr + rt + rubyBase）。",
      "limits": "id 为 docx:document 时在正文末尾、sectPr 之前新插一个只含该拼音的 w:p。框内、注内、批注内的段落，以及拼音 id、容器 id、表 id、run id、section:{n}，一律报 InvalidId。找不到段落报 IdNotFound。空 base / rt、空 lid、不认识的 align、或 hps / hpsRaise / hpsBaseText 越界，报 InvalidField。",
      "type": "object",
      "required": [
        "op",
        "id",
        "base",
        "rt"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "insertRuby"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "base": {
          "type": "string",
          "minLength": 1
        },
        "rt": {
          "type": "string",
          "minLength": 1
        },
        "align": {
          "enum": [
            "center",
            "distributeLetter",
            "distributeSpace",
            "left",
            "right",
            "rightVertical"
          ]
        },
        "hps": {
          "type": "integer",
          "minimum": 2,
          "maximum": 3276
        },
        "hpsRaise": {
          "type": "integer",
          "minimum": 2,
          "maximum": 3276
        },
        "hpsBaseText": {
          "type": "integer",
          "minimum": 2,
          "maximum": 3276
        },
        "lid": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "setRubyOp": {
      "description": "改一处拼音。",
      "limits": "base、rt、align、hps、hpsRaise、hpsBaseText、lid 至少给一个。只改被点名的那一个 w:ruby。 空 base / rt / lid、不认识的 align、或字号越界报 InvalidField。找不到报 IdNotFound。 id 不是拼音 id 报 InvalidId。xlsx / pptx 上发此 op 报 InvalidField。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setRuby"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "base": {
          "type": "string",
          "minLength": 1
        },
        "rt": {
          "type": "string",
          "minLength": 1
        },
        "align": {
          "enum": [
            "center",
            "distributeLetter",
            "distributeSpace",
            "left",
            "right",
            "rightVertical"
          ]
        },
        "hps": {
          "type": "integer",
          "minimum": 2,
          "maximum": 3276
        },
        "hpsRaise": {
          "type": "integer",
          "minimum": 2,
          "maximum": 3276
        },
        "hpsBaseText": {
          "type": "integer",
          "minimum": 2,
          "maximum": 3276
        },
        "lid": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "deleteRubyOp": {
      "description": "删掉该 w:ruby。",
      "limits": "若宿主 w:r 里除 w:rPr 外只剩这一份拼音，连该 run 一起删。不因此删掉空段。找不到报 IdNotFound。id 不是拼音 id 报 InvalidId。xlsx / pptx 上发此 op 报 InvalidField。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "deleteRuby"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "setEastAsianSettingsOp": {
      "description": "改文档的东亚排版设置。",
      "limits": "五个字段至少给一个。禁则对象必须同时有非空 lang 与非空 chars。 themeFontLang 对象只认 val / eastAsia / bidi，值为字符串或 null。空串报 InvalidField。写入时整份替换该元素，只写出非 null 的属性。 不认识的 characterSpacingControl 报 InvalidField。 id 不是 docx:document 报 InvalidId。没有 settings 且要写入时新建 /word/settings.xml 与主文档 settings 关系。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setEastAsianSettings"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "characterSpacingControl": {
          "oneOf": [
            {
              "enum": [
                "doNotCompress",
                "compressPunctuation",
                "compressPunctuationAndJapaneseKana"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "strictFirstAndLastChars": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "noLineBreaksBefore": {
          "oneOf": [
            {
              "$ref": "#/$defs/kinsokuChars"
            },
            {
              "type": "null"
            }
          ]
        },
        "noLineBreaksAfter": {
          "oneOf": [
            {
              "$ref": "#/$defs/kinsokuChars"
            },
            {
              "type": "null"
            }
          ]
        },
        "themeFontLang": {
          "oneOf": [
            {
              "$ref": "#/$defs/themeFontLang"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "docxDeleteMathOp": {
      "description": "删掉该 oMath；若父 oMathPara 里已经没有 oMath，连 oMathPara 一起删。",
      "limits": "因此变空且无 sectPr 的正文段可删掉。表格单元格内的空段留下。删完后若 w:body 里没有 w:p，在 sectPr 之前补一个空段。某段带分节符且不能整段删掉时，报 NotImplemented。找不到报 IdNotFound。id 不是公式 id 报 InvalidId。xlsx / pptx 的 drawing 公式框见各自分册。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "deleteMath"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
