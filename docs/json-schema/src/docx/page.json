{
  "$comment": "编辑用分块，由 build.py 拼进 request.schema.json。",
  "formats": {
    "setHeaderFooterDistanceOp": [
      "docx"
    ],
    "setHeaderFooterLinkOp": [
      "docx"
    ],
    "insertHeaderFooterOp": [
      "docx"
    ],
    "insertSectionOp": [
      "docx"
    ],
    "deleteSectionOp": [
      "docx"
    ],
    "setTitlePageOp": [
      "docx"
    ],
    "setEvenAndOddHeadersOp": [
      "docx"
    ],
    "setPageMarginOp": [
      "docx"
    ],
    "setPageSizeOp": [
      "docx"
    ],
    "setColumnsOp": [
      "docx"
    ],
    "setVerticalAlignOp": [
      "docx"
    ],
    "setLineNumberingOp": [
      "docx"
    ],
    "setDocGridOp": [
      "docx"
    ],
    "setRtlGutterOp": [
      "docx"
    ],
    "setMirrorMarginsOp": [
      "docx"
    ],
    "setGutterAtTopOp": [
      "docx"
    ]
  },
  "$defs": {
    "setHeaderFooterDistanceOp": {
      "description": "改页眉页脚到页边的距离。",
      "limits": "两个距离至少给一个，否则报 InvalidField。节不存在报 IdNotFound。id 不是 section:{n} 报 InvalidId。xlsx / pptx 上发此 op 报 InvalidField。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setHeaderFooterDistance"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "headerDistance": {
          "type": "integer",
          "minimum": 0
        },
        "footerDistance": {
          "type": "integer",
          "minimum": 0
        }
      },
      "anyOf": [
        {
          "required": [
            "headerDistance"
          ]
        },
        {
          "required": [
            "footerDistance"
          ]
        }
      ]
    },
    "setHeaderFooterLinkOp": {
      "description": "改这一节的页眉页脚是否沿用上一节。",
      "limits": "第一节上 linked: true 报 InvalidField。该类型对本节不生效时报 InvalidField（不替用户打开首页不同或奇偶页）。节不存在报 IdNotFound。 id 不是 section:{n} 报 InvalidId。xlsx / pptx 上发此 op 报 InvalidField。已经是目标状态则空操作，仍计入 opsApplied，不脏任何部件。",
      "type": "object",
      "required": [
        "op",
        "id",
        "kind",
        "type",
        "linked"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setHeaderFooterLink"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "header",
            "footer"
          ]
        },
        "type": {
          "enum": [
            "default",
            "even",
            "first"
          ]
        },
        "linked": {
          "type": "boolean"
        }
      }
    },
    "insertHeaderFooterOp": {
      "description": "给这一节加上页眉或页脚。",
      "limits": "该类型对本节不生效时报 InvalidField（不替用户打开首页不同或奇偶页）。 本节该类型已经链接前节（inspect 的 headerLink / footerLink 为 true）时报 InvalidField； 要独立部件走 setHeaderFooterLink 且 linked: false。 节不存在报 IdNotFound。id 不是 section:{n} 报 InvalidId。xlsx / pptx 上发此 op 报 InvalidField。",
      "type": "object",
      "required": [
        "op",
        "id",
        "kind",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "insertHeaderFooter"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "header",
            "footer"
          ]
        },
        "type": {
          "enum": [
            "default",
            "even",
            "first"
          ]
        }
      }
    },
    "insertSectionOp": {
      "description": "插在点名段之后：该段成为当前节的最后一段。",
      "limits": "该段还没有 pPr/sectPr 时，把分节符写在该段上。该段已经带 sectPr 时，在它后面插入一个空的 w:p（新 w14:paraId），把新分节符放在这个空段上。不要拆 run，不要拆段落中间。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "insertSection"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "nextPage",
            "continuous",
            "evenPage",
            "oddPage",
            "nextColumn"
          ]
        }
      }
    },
    "deleteSectionOp": {
      "description": "删掉结束第 n 节的那个 w:sectPr（一定在某段 pPr 上，不会是 w:body 末尾那一份）。",
      "limits": "第 n 节的正文并进第 n+1 节，沿用第 n+1 节的节属性。这与 Word 删除分节符的方向相同。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "deleteSection"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "setTitlePageOp": {
      "description": "不新建 first 页眉页脚。",
      "limits": "关掉时不删除已有 first 部件。已经是目标状态则空操作，仍计入 opsApplied，不脏任何部件。节不存在报 IdNotFound。id 不是 section:{n} 报 InvalidId。xlsx / pptx 上发此 op 报 InvalidField。",
      "type": "object",
      "required": [
        "op",
        "id",
        "titlePage"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setTitlePage"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "titlePage": {
          "type": "boolean"
        }
      }
    },
    "setEvenAndOddHeadersOp": {
      "description": "整篇一份，不按节。",
      "limits": "不新建 even 页眉页脚。关掉时不删除已有 even 部件。已经是目标状态则空操作，仍计入 opsApplied，不脏任何部件。没有 settings.xml 时报 OpcPartMissing。id 不是 docx:document 报 InvalidId。xlsx / pptx 上发此 op 报 InvalidField。",
      "type": "object",
      "required": [
        "op",
        "id",
        "evenAndOdd"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setEvenAndOddHeaders"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "evenAndOdd": {
          "type": "boolean"
        }
      }
    },
    "setPageMarginOp": {
      "description": "改页边距。",
      "limits": "五个边距至少给一个，否则报 InvalidField。不要出现 headerDistance / footerDistance。节不存在报 IdNotFound。 id 不是 section:{n} 报 InvalidId。xlsx / pptx 上发此 op 报 InvalidField。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setPageMargin"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "top": {
          "type": "integer"
        },
        "bottom": {
          "type": "integer"
        },
        "left": {
          "type": "integer",
          "minimum": 0
        },
        "right": {
          "type": "integer",
          "minimum": 0
        },
        "gutter": {
          "type": "integer",
          "minimum": 0
        }
      },
      "anyOf": [
        {
          "required": [
            "top"
          ]
        },
        {
          "required": [
            "bottom"
          ]
        },
        {
          "required": [
            "left"
          ]
        },
        {
          "required": [
            "right"
          ]
        },
        {
          "required": [
            "gutter"
          ]
        }
      ]
    },
    "setPageSizeOp": {
      "description": "改纸张大小。",
      "limits": "三个字段至少给一个，否则报 InvalidField。不认识的 orient 报 InvalidField。只改被点名的属性。没有 w:pgSz 时插入一个，只写本次给出的字段，不补宽高，也不猜纵向。 改 orient 时不自动对调 pageWidth / pageHeight。不读写 w:code。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setPageSize"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "pageWidth": {
          "type": "integer",
          "minimum": 0
        },
        "pageHeight": {
          "type": "integer",
          "minimum": 0
        },
        "orient": {
          "enum": [
            "portrait",
            "landscape"
          ]
        }
      },
      "anyOf": [
        {
          "required": [
            "pageWidth"
          ]
        },
        {
          "required": [
            "pageHeight"
          ]
        },
        {
          "required": [
            "orient"
          ]
        }
      ]
    },
    "setColumnsOp": {
      "description": "改这一节的分栏。",
      "limits": "enabled: false 与其它字段不能同时出现，否则报 InvalidField。其余字段至少给一个，否则报 InvalidField。num 小于 1 报 InvalidField。只改被点名的属性。 没有 w:cols 且不是删除时插入一个。给了 cols 却同时 equalWidth 为 true 报 InvalidField。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setColumns"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "num": {
          "type": "integer",
          "minimum": 1
        },
        "space": {
          "type": "integer",
          "minimum": 0
        },
        "equalWidth": {
          "type": "boolean"
        },
        "sep": {
          "type": "boolean"
        },
        "cols": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 0
              },
              "space": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "enabled": {
          "const": false
        }
      }
    },
    "setVerticalAlignOp": {
      "description": "必填。",
      "limits": "不认识的字符串报 InvalidField。",
      "type": "object",
      "required": [
        "op",
        "id",
        "vAlign"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setVerticalAlign"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "vAlign": {
          "anyOf": [
            {
              "enum": [
                "top",
                "center",
                "both",
                "bottom"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "setLineNumberingOp": {
      "description": "改这一节的行号。",
      "limits": "enabled: false 与其它字段不能同时出现。其余字段至少给一个。没有 w:lnNumType 且不是删除时插入一个，只写本次给出的属性。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setLineNumbering"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "countBy": {
          "type": "integer",
          "minimum": 0
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "distance": {
          "type": "integer",
          "minimum": 0
        },
        "restart": {
          "enum": [
            "newPage",
            "newSection",
            "continuous"
          ]
        },
        "enabled": {
          "const": false
        }
      }
    },
    "setDocGridOp": {
      "description": "改文档网格。",
      "limits": "enabled: false 与其它字段不能同时出现。其余字段至少给一个。没有 w:docGrid 且不是删除时插入一个。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setDocGrid"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "default",
            "lines",
            "linesAndChars",
            "snapToChars"
          ]
        },
        "linePitch": {
          "type": "integer"
        },
        "charSpace": {
          "type": "integer"
        },
        "enabled": {
          "const": false
        }
      }
    },
    "setRtlGutterOp": {
      "description": "必填。",
      "limits": "规则与 setTitlePage 相同。",
      "type": "object",
      "required": [
        "op",
        "id",
        "rtlGutter"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setRtlGutter"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "rtlGutter": {
          "type": "boolean"
        }
      }
    },
    "setMirrorMarginsOp": {
      "description": "开关对称页边距。",
      "limits": "id 不是 docx:document 报 InvalidId。没有 settings.xml 报 OpcPartMissing。xlsx / pptx 上发此 op 报 InvalidField。",
      "type": "object",
      "required": [
        "op",
        "id",
        "mirrorMargins"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setMirrorMargins"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "mirrorMargins": {
          "type": "boolean"
        }
      }
    },
    "setGutterAtTopOp": {
      "description": "id 与缺 settings 的报错与 setMirrorMargins 相同。",
      "limits": "关掉本标志不改各节 w:pgMar/@w:gutter。",
      "type": "object",
      "required": [
        "op",
        "id",
        "gutterAtTop"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setGutterAtTop"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "gutterAtTop": {
          "type": "boolean"
        }
      }
    }
  }
}
