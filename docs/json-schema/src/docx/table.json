{
  "$comment": "编辑用分块，由 build.py 拼进 request.schema.json。",
  "formats": {
    "mergeCellsOp": [
      "docx"
    ],
    "splitCellsOp": [
      "docx"
    ],
    "setTableStyleOp": [
      "docx"
    ],
    "setTableFloatOp": [
      "docx"
    ],
    "setTableWidthOp": [
      "docx"
    ],
    "setTableAlignOp": [
      "docx"
    ],
    "setTableRowHeightOp": [
      "docx"
    ],
    "setTableCellMarOp": [
      "docx"
    ],
    "setTableBordersOp": [
      "docx"
    ],
    "setCellBordersOp": [
      "docx"
    ],
    "setCellFormatOp": [
      "docx"
    ]
  },
  "$defs": {
    "mergeCellsOp": {
      "description": "把 Word 表格里的几格并成一格。",
      "limits": "范围内已有合并、或格子对不上网格时报 NotImplemented。幸存格是左上角：水平方向写 gridSpan，垂直方向左上为 vMerge=restart、其余行为 continue。 被吃掉的格子里的段落（遇嵌套表停住）按先行后列挪进幸存格，然后删掉那些 w:tc。continue 格留下一个空的 w:p。xlsx / pptx 上发此 op 报 InvalidField。",
      "type": "object",
      "required": [
        "op",
        "id",
        "startRow",
        "startCol",
        "endRow",
        "endCol"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "mergeCells"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "startRow": {
          "type": "integer",
          "minimum": 1
        },
        "startCol": {
          "type": "integer",
          "minimum": 1
        },
        "endRow": {
          "type": "integer",
          "minimum": 1
        },
        "endCol": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "splitCellsOp": {
      "description": "把 Word 表格里并过的格子拆开。",
      "limits": "gridSpan 为 1 且没有 vMerge 时报 InvalidField。对 continue 格发此 op 报 InvalidField，必须点名 restart 那一格。 水平拆分后补出的新格各有一段空文本；垂直拆分去掉该列向下连续的 vMerge。xlsx / pptx 上发此 op 报 InvalidField。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "splitCells"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tableLook": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "firstRow": {
          "type": "boolean"
        },
        "lastRow": {
          "type": "boolean"
        },
        "firstColumn": {
          "type": "boolean"
        },
        "lastColumn": {
          "type": "boolean"
        },
        "bandedRows": {
          "type": "boolean"
        },
        "bandedColumns": {
          "type": "boolean"
        }
      }
    },
    "setTableStyleOp": {
      "description": "改 Word 表格的样式。",
      "limits": "style 与 look 至少给一个。style 为样式 id 时目标必须是表格样式。段落 / 字符 / 编号样式报 InvalidField。找不到该样式报 IdNotFound。 look 对象字段：firstRow、lastRow、firstColumn、lastColumn、bandedRows、bandedColumns，均为可选布尔。未点名的开关与已有 tblLook 合并。 没有已有 tblLook 时缺省约 Word 的 04A0：首行开、末行关、首列开、末列关、行带开、列带关。 写出六个属性与 val（四位大写十六进制）。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setTableStyle"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "style": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "look": {
          "oneOf": [
            {
              "$ref": "#/$defs/tableLook"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "tableFloatPos": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "horzAnchor": {
          "enum": [
            "margin",
            "page",
            "text"
          ]
        },
        "vertAnchor": {
          "enum": [
            "margin",
            "page",
            "text"
          ]
        },
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        },
        "leftFromText": {
          "type": "integer",
          "minimum": 0
        },
        "rightFromText": {
          "type": "integer",
          "minimum": 0
        },
        "topFromText": {
          "type": "integer",
          "minimum": 0
        },
        "bottomFromText": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "setTableFloatOp": {
      "description": "让 Word 表格浮在文字旁边。",
      "limits": "不要复用 pptx 的 setTablePos（单位是 EMU）。",
      "type": "object",
      "required": [
        "op",
        "id",
        "pos"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setTableFloat"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "pos": {
          "oneOf": [
            {
              "$ref": "#/$defs/tableFloatPos"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "setTableWidthOp": {
      "description": "改 Word 表格的宽度。",
      "limits": "不要复用 pptx 的 setTableSize（单位是 EMU）。不要复用 xlsx 的 setColWidth。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setTableWidth"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "auto",
            "dxa",
            "pct"
          ]
        },
        "w": {
          "type": "integer",
          "minimum": 0
        },
        "cols": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "setTableAlignOp": {
      "description": "行内表的水平对齐与左缩进。",
      "limits": "浮动位置请用 setTableFloat。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setTableAlign"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "align": {
          "oneOf": [
            {
              "enum": [
                "left",
                "center",
                "right"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "indent": {
          "$ref": "#/$defs/twipOrNull"
        }
      }
    },
    "setTableRowHeightOp": {
      "description": "改 Word 表格的行高。",
      "limits": "不要复用 xlsx 的 setRowHeight（单位是磅）。",
      "type": "object",
      "required": [
        "op",
        "id",
        "h"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setTableRowHeight"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "h": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "rule": {
          "enum": [
            "auto",
            "atLeast",
            "exact"
          ]
        }
      }
    },
    "twipOrNull": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "setTableCellMarOp": {
      "description": "改 Word 表格单元格的内边距。",
      "limits": "至少给一边。写入表级 tblCellMar，type=\"dxa\"。四边都删光后去掉空的 tblCellMar。 找不到表报 IdNotFound。id 不是表 id 报 InvalidId。xlsx / pptx 上发此 op 报 InvalidField。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setTableCellMar"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "top": {
          "$ref": "#/$defs/twipOrNull"
        },
        "left": {
          "$ref": "#/$defs/twipOrNull"
        },
        "bottom": {
          "$ref": "#/$defs/twipOrNull"
        },
        "right": {
          "$ref": "#/$defs/twipOrNull"
        }
      }
    },
    "tableBorders": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "top": {
          "anyOf": [
            {
              "$ref": "#/$defs/pageBorderSide"
            },
            {
              "type": "null"
            }
          ]
        },
        "left": {
          "anyOf": [
            {
              "$ref": "#/$defs/pageBorderSide"
            },
            {
              "type": "null"
            }
          ]
        },
        "bottom": {
          "anyOf": [
            {
              "$ref": "#/$defs/pageBorderSide"
            },
            {
              "type": "null"
            }
          ]
        },
        "right": {
          "anyOf": [
            {
              "$ref": "#/$defs/pageBorderSide"
            },
            {
              "type": "null"
            }
          ]
        },
        "insideH": {
          "anyOf": [
            {
              "$ref": "#/$defs/pageBorderSide"
            },
            {
              "type": "null"
            }
          ]
        },
        "insideV": {
          "anyOf": [
            {
              "$ref": "#/$defs/pageBorderSide"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "setTableBordersOp": {
      "description": "表级 w:tblBorders 的四边与内外框。",
      "limits": "不要和格斜线、页面边框、段边框混。不算自动套表样式。",
      "type": "object",
      "required": [
        "op",
        "id",
        "borders"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setTableBorders"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "borders": {
          "anyOf": [
            {
              "$ref": "#/$defs/tableBorders"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "setCellBordersOp": {
      "description": "格级 w:tcBorders 的正交四边与格内 insideH / insideV。",
      "limits": "不要和 setCellFormat 的 tcMar、斜线、表级 setTableBorders 混。不算自动套表样式。",
      "type": "object",
      "required": [
        "op",
        "id",
        "borders"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setCellBorders"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "borders": {
          "anyOf": [
            {
              "$ref": "#/$defs/tableBorders"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "setCellFormatOp": {
      "description": "改 Word 表格单元格的填充、边框和对齐。",
      "limits": "fill、四边、两条斜线、vAlign、noWrap、textDirection、fitText、hideMark、headers 至少给一个。 fill 写入 shd val=\"clear\" color=\"auto\"，并去掉 theme 填充属性。不是六位十六进制报 InvalidField。 vAlign 写入 tcPr/w:vAlign/@w:val。不认识报 InvalidField。不要和节上 setVerticalAlign 混。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setCellFormat"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "fill": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9A-Fa-f]{6}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "top": {
          "$ref": "#/$defs/twipOrNull"
        },
        "left": {
          "$ref": "#/$defs/twipOrNull"
        },
        "bottom": {
          "$ref": "#/$defs/twipOrNull"
        },
        "right": {
          "$ref": "#/$defs/twipOrNull"
        },
        "tl2br": {
          "oneOf": [
            {
              "$ref": "#/$defs/docxDiagonalBorder"
            },
            {
              "type": "null"
            }
          ]
        },
        "tr2bl": {
          "oneOf": [
            {
              "$ref": "#/$defs/docxDiagonalBorder"
            },
            {
              "type": "null"
            }
          ]
        },
        "vAlign": {
          "oneOf": [
            {
              "enum": [
                "top",
                "center",
                "both",
                "bottom"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "noWrap": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "textDirection": {
          "oneOf": [
            {
              "enum": [
                "lrTb",
                "tbRl",
                "btLr",
                "lrTbV",
                "tbRlV",
                "tbLrV"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "fitText": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "hideMark": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "headers": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
