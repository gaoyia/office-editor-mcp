{
  "$comment": "编辑用分块，由 build.py 拼进 request.schema.json。",
  "formats": {
    "replacePictureOp": [
      "xlsx",
      "docx",
      "pptx"
    ],
    "insertPictureOp": [
      "xlsx",
      "docx",
      "pptx"
    ],
    "deletePictureOp": [
      "xlsx",
      "docx",
      "pptx"
    ],
    "setPictureSizeOp": [
      "xlsx",
      "docx",
      "pptx"
    ]
  },
  "$defs": {
    "replacePictureOp": {
      "description": "把一张图换成另一张。",
      "limits": "找不到该图报 IdNotFound。读不到 file 报 Io。文件不是该格式认的图片报 InvalidField。",
      "type": "object",
      "required": [
        "op",
        "id",
        "file"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "replacePicture"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "insertPictureOp": {
      "description": "插入一张图片。",
      "limits": "docx：找不到该段落报 IdNotFound。id 不是段落 id 报 InvalidId。 cx / cy 都省略时，位图按像素尺寸、96 dpi 换算成 EMU（px × 914400 / 96）；读不出尺寸则用 1 英寸见方（914400）。 SVG 按根元素 width / height（无单位或 px 当 CSS 像素，同样 96 dpi）；没有则用 viewBox；再没有则 1 英寸见方。 EMF 优先用 rclFrame（单位 0.01 mm）换 EMU；读不到再用 rclBounds 当像素、96 dpi。",
      "type": "object",
      "required": [
        "op",
        "id",
        "file"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "insertPicture"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "cx": {
          "type": "integer",
          "minimum": 1
        },
        "cy": {
          "type": "integer",
          "minimum": 1
        },
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "anchor": {
          "enum": [
            "oneCell",
            "twoCell"
          ]
        },
        "fromOffX": {
          "type": "integer",
          "minimum": 0
        },
        "fromOffY": {
          "type": "integer",
          "minimum": 0
        },
        "toOffX": {
          "type": "integer",
          "minimum": 0
        },
        "toOffY": {
          "type": "integer",
          "minimum": 0
        },
        "fromX": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fromY": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "toX": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "toY": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "deletePictureOp": {
      "description": "删掉一张图片。",
      "limits": "找不到该图报 IdNotFound。docx：按图 id 删掉对应的 w:drawing。 若该图在 mc:AlternateContent 的 Choice 里，整段 AlternateContent 删掉（避免 Fallback 的 VML 把图留住）。 所在 w:r 若删完后只剩 w:rPr 或空，把该 run 也删掉。xlsx：按图 id 删掉包含该 xdr:pic 的整个锚点。工作表 drawing 删空后去掉该部件、工作表上的 <drawing> 和对应关系。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "deletePicture"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "setPictureSizeOp": {
      "description": "改图片的大小。",
      "limits": "cx 与 cy 至少给一个，否则报 InvalidField（xlsx twoCell 见下）。cx / cy 与 to 不能同时出现。只改被点名的那一侧，另一侧保持原值。 docx：写入 wp:extent；若 pic:spPr/a:xfrm/a:ext 存在，一并改。 xlsx：oneCell 或 absolute 时写入 xdr:ext；若 xdr:spPr/a:xfrm/a:ext 存在，一并改。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setPictureSize"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "cx": {
          "type": "integer",
          "minimum": 1
        },
        "cy": {
          "type": "integer",
          "minimum": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "toOffX": {
          "type": "integer",
          "minimum": 0
        },
        "toOffY": {
          "type": "integer",
          "minimum": 0
        }
      },
      "anyOf": [
        {
          "required": [
            "cx"
          ]
        },
        {
          "required": [
            "cy"
          ]
        },
        {
          "required": [
            "to"
          ]
        }
      ]
    }
  }
}
