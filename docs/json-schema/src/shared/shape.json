{
  "$comment": "编辑用分块，由 build.py 拼进 request.schema.json。",
  "formats": {
    "setShapeTextOp": [
      "xlsx",
      "pptx"
    ],
    "setShapeRunsOp": [
      "xlsx",
      "pptx"
    ]
  },
  "$defs": {
    "setShapeTextOp": {
      "description": "改形状里的文字。",
      "descriptionEn": "Change the text inside a shape.",
      "limits": "找不到该形状报 IdNotFound。对 slide:{n} 或 slide:{n}/notes（没有 /shape:）发本 op 报 InvalidId。 对备注页、备注母版或讲义上占位符 p:ph/@type 为 sldImg 的形状发本 op 报 InvalidField，不写文件。 xlsx 改工作表文本框或无 txBox 形状的 xdr:txBody，规则与 pptx 相同（把下文的 p:sp / p:txBody 换成 xdr:sp / xdr:txBody）。",
      "limitsEn": "A missing shape returns IdNotFound. This op on slide:{n} or slide:{n}/notes (no /shape:) returns InvalidId. This op on a shape on a notes page, notes master, or handout whose placeholder p:ph/@type is sldImg returns InvalidField and writes nothing. xlsx changes xdr:txBody of a worksheet text box or a shape without txBox, with the same rules as pptx (read p:sp / p:txBody below as xdr:sp / xdr:txBody).",
      "type": "object",
      "required": [
        "op",
        "id",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setShapeText"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        }
      }
    },
    "setShapeRunsOp": {
      "description": "按原文把形状或文本框里的文字拆成多个 run。短的用 match。中间很长时只写 after 和 before 两个切点。",
      "descriptionEn": "Split the text in a shape or text box into runs. Use match for a short span. For a long span, give only the after and before cut points.",
      "limits": "不改没点名的字，不重建形状。id 与 setShapeText 相同。不写 match 时，after 是左切点，before 是右切点，中间原文单独成一截，中间不用抄。text 连起来必须和现在的可见文字相同。单元格、备注整段、讲义槽位、图表标题和 SmartArt 不走这条。",
      "limitsEn": "Does not change unnamed words and does not rebuild the shape. id matches setShapeText. Without match, after is the left cut and before is the right cut; the text between them becomes the run and is not copied into the request. text pieces must join to the current visible text. Cells, whole notes, handout slots, chart titles, and SmartArt do not use this op.",
      "type": "object",
      "required": ["op", "id", "runs"],
      "additionalProperties": false,
      "properties": {
        "op": { "const": "setShapeRuns" },
        "id": { "type": "string", "minLength": 1 },
        "runs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": ["text"],
                "additionalProperties": false,
                "properties": {
                  "text": { "type": "string" },
                  "bold": { "type": "boolean" },
                  "italic": { "type": "boolean" },
                  "color": { "type": "string", "pattern": "^[0-9A-Fa-f]{6}$" },
                  "underline": { "type": "string" },
                  "sz": { "type": "integer", "minimum": 100, "maximum": 400000 },
                  "font": { "type": "string", "minLength": 1 },
                  "eastAsiaFont": { "type": "string", "minLength": 1 }
                }
              },
              {
                "type": "object",
                "required": ["match"],
                "additionalProperties": false,
                "properties": {
                  "match": { "type": "string", "minLength": 1 },
                  "after": { "type": "string", "minLength": 1 },
                  "before": { "type": "string", "minLength": 1 },
                  "nth": { "type": "integer", "minimum": 1 },
                  "bold": { "type": "boolean" },
                  "italic": { "type": "boolean" },
                  "color": { "type": "string", "pattern": "^[0-9A-Fa-f]{6}$" },
                  "underline": { "type": "string" },
                  "sz": { "type": "integer", "minimum": 100, "maximum": 400000 },
                  "font": { "type": "string", "minLength": 1 },
                  "eastAsiaFont": { "type": "string", "minLength": 1 }
                }
              },
              {
                "type": "object",
                "required": ["after", "before"],
                "additionalProperties": false,
                "properties": {
                  "after": { "type": "string", "minLength": 1 },
                  "before": { "type": "string", "minLength": 1 },
                  "nth": { "type": "integer", "minimum": 1 },
                  "bold": { "type": "boolean" },
                  "italic": { "type": "boolean" },
                  "color": { "type": "string", "pattern": "^[0-9A-Fa-f]{6}$" },
                  "underline": { "type": "string" },
                  "sz": { "type": "integer", "minimum": 100, "maximum": 400000 },
                  "font": { "type": "string", "minLength": 1 },
                  "eastAsiaFont": { "type": "string", "minLength": 1 }
                }
              },
              {
                "type": "object",
                "required": ["start", "end"],
                "additionalProperties": false,
                "properties": {
                  "start": { "type": "integer", "minimum": 0 },
                  "end": { "type": "integer", "minimum": 0 },
                  "bold": { "type": "boolean" },
                  "italic": { "type": "boolean" },
                  "color": { "type": "string", "pattern": "^[0-9A-Fa-f]{6}$" },
                  "underline": { "type": "string" },
                  "sz": { "type": "integer", "minimum": 100, "maximum": 400000 },
                  "font": { "type": "string", "minLength": 1 },
                  "eastAsiaFont": { "type": "string", "minLength": 1 }
                }
              }
            ]
          }
        }
      }
    }
  }
}
