{
  "$comment": "编辑用分块，由 build.py 拼进 request.schema.json。",
  "formats": {
    "setModel3dSizeOp": [
      "xlsx",
      "docx",
      "pptx"
    ],
    "setModel3dCameraOp": [
      "xlsx",
      "docx",
      "pptx"
    ]
  },
  "$defs": {
    "setModel3dSizeOp": {
      "description": "字段与 setPictureSize 的 xlsx 一侧相同。",
      "limits": "id 必须是 3D 模型 id。oneCell / absolute 改外层 xdr:ext。twoCell 不认 cx / cy（出现报 InvalidField），必须给 to。不按列宽行高去换算 EMU。留下 AlternateContent 与 xdr:clientData。对图 id 发此 op、对 3D id 发 setPictureSize 仍报 InvalidId。docx / pptx 见各自分册。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setModel3dSize"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "cx": {
          "type": "integer",
          "minimum": 1
        },
        "cy": {
          "type": "integer",
          "minimum": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "toOffX": {
          "type": "integer",
          "minimum": 0
        },
        "toOffY": {
          "type": "integer",
          "minimum": 0
        }
      },
      "anyOf": [
        {
          "required": [
            "cx"
          ]
        },
        {
          "required": [
            "cy"
          ]
        },
        {
          "required": [
            "to"
          ]
        }
      ]
    },
    "setModel3dCameraOp": {
      "description": "字段与 [docx setModel3dCamera](json-contract-docx.md#setmodel3dcamera) 相同。",
      "limits": "id 必须是 xlsx 3D 模型 id。改 Choice 里 am3d:camera、am3d:rot 与 am3d:spPr 里的 a:scene3d/a:lightRig。不换 GLB。不改锚点。docx / pptx 上同一套字段。示例见 docs/examples/xlsx-apply-model3d-camera.json。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setModel3dCamera"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pos": {
              "$ref": "#/$defs/model3dXyz"
            },
            "up": {
              "$ref": "#/$defs/model3dUp"
            },
            "lookAt": {
              "$ref": "#/$defs/model3dXyz"
            },
            "fov": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "rot": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ax": {
              "type": "integer"
            },
            "ay": {
              "type": "integer"
            },
            "az": {
              "type": "integer"
            }
          }
        },
        "lightRig": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "rig": {
              "type": "string"
            },
            "dir": {
              "type": "string"
            },
            "lat": {
              "type": "integer"
            },
            "lon": {
              "type": "integer"
            },
            "rev": {
              "type": "integer"
            }
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "camera"
          ]
        },
        {
          "required": [
            "rot"
          ]
        },
        {
          "required": [
            "lightRig"
          ]
        }
      ]
    },
    "model3dXyz": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        },
        "z": {
          "type": "integer"
        }
      }
    },
    "model3dUp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dx": {
          "type": "integer"
        },
        "dy": {
          "type": "integer"
        },
        "dz": {
          "type": "integer"
        }
      }
    }
  }
}
