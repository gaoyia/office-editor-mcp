{
  "$comment": "编辑用分块，由 build.py 拼进 request.schema.json。",
  "formats": {
    "setProtectionOp": [
      "xlsx",
      "docx",
      "pptx"
    ],
    "setPropsOp": [
      "xlsx",
      "docx",
      "pptx"
    ],
    "setCustomPropOp": [
      "xlsx",
      "docx",
      "pptx"
    ],
    "deleteCustomPropOp": [
      "xlsx",
      "docx",
      "pptx"
    ]
  },
  "$defs": {
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "createProps": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "$ref": "#/$defs/nullableString"
        },
        "subject": {
          "$ref": "#/$defs/nullableString"
        },
        "creator": {
          "$ref": "#/$defs/nullableString"
        },
        "description": {
          "$ref": "#/$defs/nullableString"
        },
        "keywords": {
          "$ref": "#/$defs/nullableString"
        },
        "category": {
          "$ref": "#/$defs/nullableString"
        },
        "company": {
          "$ref": "#/$defs/nullableString"
        },
        "manager": {
          "$ref": "#/$defs/nullableString"
        },
        "custom": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/createCustomProp"
          }
        }
      }
    },
    "createCustomProp": {
      "type": "object",
      "required": [
        "name",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "type": {
          "enum": [
            "lpwstr",
            "i4",
            "r8",
            "bool"
          ]
        }
      }
    },
    "setProtectionOp": {
      "description": "docx 改 /word/settings.xml 的限制编辑；xlsx 改工作表 sheetProtection 或工作簿 workbookProtection； pptx 改 presentation.xml 的 p:modifyVerifier。",
      "descriptionEn": "docx updates restricted editing in /word/settings.xml; xlsx updates a worksheet's sheetProtection or the workbook's workbookProtection; pptx updates p:modifyVerifier in presentation.xml.",
      "limits": "pptx 的放映设置用 setShowPr，不要塞进本 op。",
      "limitsEn": "For pptx slide-show settings, use setShowPr. Do not put them in this op.",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setProtection"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "enforced": {
          "type": "boolean"
        },
        "edit": {
          "enum": [
            "readOnly",
            "comments",
            "trackedChanges",
            "forms"
          ]
        },
        "formatting": {
          "type": "boolean"
        },
        "readOnlyRecommended": {
          "type": "boolean"
        },
        "objects": {
          "type": "boolean"
        },
        "scenarios": {
          "type": "boolean"
        },
        "formatCells": {
          "type": "boolean"
        },
        "formatColumns": {
          "type": "boolean"
        },
        "formatRows": {
          "type": "boolean"
        },
        "insertColumns": {
          "type": "boolean"
        },
        "insertRows": {
          "type": "boolean"
        },
        "insertHyperlinks": {
          "type": "boolean"
        },
        "deleteColumns": {
          "type": "boolean"
        },
        "deleteRows": {
          "type": "boolean"
        },
        "selectLockedCells": {
          "type": "boolean"
        },
        "sort": {
          "type": "boolean"
        },
        "autoFilter": {
          "type": "boolean"
        },
        "pivotTables": {
          "type": "boolean"
        },
        "selectUnlockedCells": {
          "type": "boolean"
        },
        "lockStructure": {
          "type": "boolean"
        },
        "lockWindows": {
          "type": "boolean"
        },
        "lockRevision": {
          "type": "boolean"
        },
        "password": {
          "type": "string",
          "minLength": 1
        },
        "writePassword": {
          "type": "string",
          "minLength": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "enforced"
          ]
        },
        {
          "required": [
            "edit"
          ]
        },
        {
          "required": [
            "formatting"
          ]
        },
        {
          "required": [
            "readOnlyRecommended"
          ]
        },
        {
          "required": [
            "objects"
          ]
        },
        {
          "required": [
