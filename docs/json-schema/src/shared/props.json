          ]
        },
        {
          "required": [
            "insertColumns"
          ]
        },
        {
          "required": [
            "insertRows"
          ]
        },
        {
          "required": [
            "insertHyperlinks"
          ]
        },
        {
          "required": [
            "deleteColumns"
          ]
        },
        {
          "required": [
            "deleteRows"
          ]
        },
        {
          "required": [
            "selectLockedCells"
          ]
        },
        {
          "required": [
            "sort"
          ]
        },
        {
          "required": [
            "autoFilter"
          ]
        },
        {
          "required": [
            "pivotTables"
          ]
        },
        {
          "required": [
            "selectUnlockedCells"
          ]
        },
        {
          "required": [
            "lockStructure"
          ]
        },
        {
          "required": [
            "lockWindows"
          ]
        },
        {
          "required": [
            "lockRevision"
          ]
        },
        {
