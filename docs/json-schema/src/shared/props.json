    "createProtection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enforced": {
          "type": "boolean"
        },
        "edit": {
          "enum": [
            "readOnly",
            "comments",
            "trackedChanges",
            "forms"
          ]
        },
