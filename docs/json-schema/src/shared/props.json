    "setPropsOp": {
      "description": "改标题、作者这类文档属性。",
      "descriptionEn": "Change document properties such as title and author.",
      "limits": "这八个字段至少给一个，否则报 InvalidField。未点名的字段留下，含 Application、页数/字数、HeadingPairs、TitlesOfParts、Slides，以及未点名的公司名。 不要写 DigSig。不要改 lastModifiedBy、created、modified。出现这些只读键报 UnknownField。id 不是格式根报 InvalidId。 缺 core.xml 或 app.xml 时，只要这条 op 点到了对应部件里的字段，就按需新建部件、根关系和 Content Type Override。",
      "limitsEn": "Give at least one of these eight fields, or InvalidField is returned. Fields that were not named stay, including Application, page and word counts, HeadingPairs, TitlesOfParts, Slides, and a company name that was not named. Do not write DigSig. Do not change lastModifiedBy, created, or modified. Those read-only keys return UnknownField. An id that is not the format root returns InvalidId. If core.xml or app.xml is missing, and this op names a field in the corresponding part, create the part, the root relationship, and the Content Type Override as needed.",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setProps"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "$ref": "#/$defs/nullableString"
        },
        "subject": {
          "$ref": "#/$defs/nullableString"
        },
        "creator": {
          "$ref": "#/$defs/nullableString"
        },
        "description": {
          "$ref": "#/$defs/nullableString"
        },
        "keywords": {
          "$ref": "#/$defs/nullableString"
        },
        "category": {
          "$ref": "#/$defs/nullableString"
        },
        "company": {
          "$ref": "#/$defs/nullableString"
        },
        "manager": {
          "$ref": "#/$defs/nullableString"
        }
      },
      "anyOf": [
        {
          "required": [
            "title"
          ]
        },
        {
          "required": [
            "subject"
          ]
        },
        {
          "required": [
            "creator"
          ]
        },
        {
          "required": [
            "description"
          ]
        },
        {
          "required": [
            "keywords"
          ]
        },
        {
          "required": [
            "category"
          ]
        },
        {
          "required": [
            "company"
          ]
        },
        {
          "required": [
            "manager"
          ]
        }
      ]
    },
    "setCustomPropOp": {
      "description": "按名 upsert：已有同名 property 时命中文档顺序第一处，保留原来的 pid / fmtid，只换值子元素。",
      "descriptionEn": "Upsert by name: when a property with the same name already exists, hit the first one in document order, keep its pid / fmtid, and replace only the value child.",
      "limits": "没有则追加，fmtid 固定 {D5CDD505-2E9C-101B-9397-08002B2CF9AE}，pid 取已有最大整数加 1，至少为 2。name 为空、type 不认识，或 type 与 value 对不上（例如 i4 却给了字符串或带小数的数字），报 InvalidField。id 不是格式根报 InvalidId。缺 custom.xml 则新建部件、根关系和 Override。",
      "limitsEn": "If there is no match, append one. fmtid is fixed to {D5CDD505-2E9C-101B-9397-08002B2CF9AE}. pid is the largest existing integer plus 1, and at least 2. An empty name, an unrecognized type, or a type that does not match value (for example i4 given a string or a number with a fractional part) returns InvalidField. An id that is not the format root returns InvalidId. If custom.xml is missing, create the part, the root relationship, and the Override.",
      "type": "object",
      "required": [
        "op",
        "id",
        "name",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setCustomProp"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "type": {
          "enum": [
            "lpwstr",
            "i4",
            "r8",
            "bool"
          ]
        }
      }
    },
    "deleteCustomPropOp": {
      "description": "删掉一个自定义文档属性。",
      "descriptionEn": "Delete a custom document property.",
      "limits": "找不到该名报 IdNotFound。id 不是 prop:{name} 报 InvalidId。删光后去掉 custom 部件、根关系和 Override。",
      "limitsEn": "A missing name returns IdNotFound. An id that is not prop:{name} returns InvalidId. When none remain, remove the custom part, the root relationship, and the Override.",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "deleteCustomProp"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
