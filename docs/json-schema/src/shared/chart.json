{
  "$comment": "编辑用分块，由 build.py 拼进 request.schema.json。",
  "formats": {
    "insertChartOp": [
      "xlsx",
      "docx",
      "pptx"
    ],
    "deleteChartOp": [
      "xlsx",
      "docx",
      "pptx"
    ],
    "setChartTitleOp": [
      "xlsx",
      "docx",
      "pptx"
    ],
    "setChartSeriesOp": [
      "xlsx",
      "docx",
      "pptx"
    ],
    "addChartSeriesOp": [
      "xlsx",
      "docx",
      "pptx"
    ],
    "deleteChartSeriesOp": [
      "xlsx",
      "docx",
      "pptx"
    ],
    "setChartTypeOp": [
      "xlsx",
      "docx",
      "pptx"
    ],
    "setChartAxisTitleOp": [
      "xlsx",
      "docx",
      "pptx"
    ],
    "setChartLegendOp": [
      "xlsx",
      "docx",
      "pptx"
    ],
    "setChartDataLabelsOp": [
      "xlsx",
      "docx",
      "pptx"
    ],
    "insertTrendlineOp": [
      "xlsx",
      "docx",
      "pptx"
    ],
    "setTrendlineOp": [
      "xlsx",
      "docx",
      "pptx"
    ],
    "deleteTrendlineOp": [
      "xlsx",
      "docx",
      "pptx"
    ],
    "insertErrorBarsOp": [
      "xlsx",
      "docx",
      "pptx"
    ],
    "setErrorBarsOp": [
      "xlsx",
      "docx",
      "pptx"
    ],
    "deleteErrorBarsOp": [
      "xlsx",
      "docx",
      "pptx"
    ],
    "setChartSeriesAxisOp": [
      "xlsx",
      "docx",
      "pptx"
    ],
    "setChartSizeOp": [
      "xlsx",
      "docx",
      "pptx"
    ]
  },
  "$defs": {
    "chartType": {
      "enum": [
        "bar",
        "col",
        "line",
        "pie",
        "area",
        "scatter",
        "doughnut",
        "radar",
        "bubble",
        "stock",
        "surface",
        "ofPie"
      ]
    },
    "insertChartType": {
      "enum": [
        "bar",
        "col",
        "line",
        "pie",
        "area",
        "scatter",
        "doughnut",
        "radar",
        "bubble",
        "combo",
        "stock",
        "surface",
        "ofPie",
        "chartex"
      ]
    },
    "stockKind": {
      "enum": [
        "hlc",
        "ohlc",
        "vhlc",
        "vohlc"
      ]
    },
    "surfaceKind": {
      "enum": [
        "surface3d",
        "wireframe",
        "contour",
        "contourWire"
      ]
    },
    "chartexLayoutId": {
      "enum": [
        "waterfall",
        "treemap",
        "sunburst",
        "funnel",
        "clusteredColumn",
        "boxWhisker",
        "pareto"
      ]
    },
    "comboSeriesType": {
      "enum": [
        "bar",
        "col",
        "line",
        "area",
        "scatter"
      ]
    },
    "chartSeriesData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/comboSeriesType"
        },
        "categories": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "sizes": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number"
            ]
          }
        }
      }
    },
    "insertChartOp": {
      "description": "插入一个图表。",
      "limits": "docx：在该段末插入 w:drawing，默认浮动。新建 /word/charts/chartN.xml（N 从 1 起尚未占用）、chart 的 .rels、一份最小 embedding xlsx（工作表名 Sheet1， 分类从 A2 起，系列名在第 1 行，数值从 B2 起向右），以及宿主部件关系（主文档、页眉页脚、comments.xml、footnotes.xml 或 endnotes.xml）、[Content_Types].xml Override。 chart 部件仍写在 /word/charts/。",
      "type": "object",
      "required": [
        "op",
        "id",
        "type",
        "series"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "insertChart"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/insertChartType"
        },
        "ofPieType": {
          "enum": [
            "pie",
            "bar"
          ]
        },
        "stockKind": {
          "$ref": "#/$defs/stockKind"
        },
        "surfaceKind": {
          "$ref": "#/$defs/surfaceKind"
        },
        "layoutId": {
          "$ref": "#/$defs/chartexLayoutId"
        },
        "title": {
          "type": "string"
        },
        "series": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/chartSeriesData"
              },
              {
                "required": [
                  "values"
                ]
              }
            ]
          }
        },
        "kind": {
          "enum": [
            "inline",
            "anchor"
          ]
        },
        "wrap": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "square",
            "tight",
            "through",
            "topAndBottom",
            "none",
            null
          ]
        },
        "cx": {
          "type": "integer",
          "minimum": 1
        },
        "cy": {
          "type": "integer",
          "minimum": 1
        },
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "anchor": {
          "enum": [
            "oneCell",
            "twoCell"
          ]
        },
        "fromOffX": {
          "type": "integer",
          "minimum": 0
        },
        "fromOffY": {
          "type": "integer",
          "minimum": 0
        },
        "toOffX": {
          "type": "integer",
          "minimum": 0
        },
        "toOffY": {
          "type": "integer",
          "minimum": 0
        },
        "dataFrom": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "deleteChartOp": {
      "description": "删掉一个图表。",
      "limits": "docx：删掉对应 w:drawing。若在 mc:AlternateContent 的 Choice 里，整段 AlternateContent 删掉。 所在 w:r 若删完后只剩 w:rPr 或空，把该 run 也删掉。重新解析关系之后，若该 chart 部件、专属 colors / style、embedding 再无人引用，删掉这些部件、关系条目和对应内容类型。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "deleteChart"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "setChartTitleOp": {
      "description": "改图表标题。",
      "limits": "找不到该图报表 IdNotFound。id 不是图表 id 报 InvalidId。",
      "type": "object",
      "required": [
        "op",
        "id",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setChartTitle"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        }
      }
    },
    "setChartSeriesOp": {
      "description": "改图表里一个系列的数据。",
      "limits": "name、categories、values、sizes 至少给一个，否则报 InvalidField。只给的字段改，其余保留。categories 与 values 都给时长度可以不同。 对非气泡系列给 sizes 报 InvalidField。找不到该系列报 IdNotFound。id 不是系列 id 报 InvalidId。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setChartSeries"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "categories": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "values": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "sizes": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number"
            ]
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "name"
          ]
        },
        {
          "required": [
            "categories"
          ]
        },
        {
          "required": [
            "values"
          ]
        },
        {
          "required": [
            "sizes"
          ]
        }
      ]
    },
    "addChartSeriesOp": {
      "description": "在 chart 部件末尾追加一条 c:ser，c:idx / c:order 取尚未占用的最小值。",
      "limits": "样式能从最后一条系列抄则抄，抄不了就用最小默认。docx 有 embedding 则在工作表右侧追加一列。xlsx 能从已有系列的 c:f 推出右侧相邻空列则写入；推不出报 NotImplemented。不能用本 op 把单类型图加成组合图。id 不是图表 id 报 InvalidId。",
      "type": "object",
      "required": [
        "op",
        "id",
        "values"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "addChartSeries"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "categories": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "sizes": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "type": {
          "$ref": "#/$defs/comboSeriesType"
        }
      }
    },
    "deleteChartSeriesOp": {
      "description": "删掉该 c:ser。",
      "limits": "docx 若能从公式定位则同步 embedding 里对应列。xlsx 不删单元格。删完后一条都不剩时报 InvalidField（要整张去掉请用 deleteChart）。找不到报 IdNotFound。id 不是系列 id 报 InvalidId。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "deleteChartSeries"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "setChartTypeOp": {
      "description": "改图表类型。",
      "limits": "不认识的枚举、或值为 combo、chartex，报 InvalidField。当前 type 为 other 或 chartex 时报 NotImplemented，不写文件。 转成 stock 必须恰好三条（hlc）或四条（ohlc）系列，否则 NotImplemented。从组合图转成股价报 NotImplemented。 转成 surface 必须恰好三条系列，否则 NotImplemented。 转成 ofPie / pie / doughnut 必须恰好一条系列，否则 NotImplemented。",
      "type": "object",
      "required": [
        "op",
        "id",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setChartType"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/chartType"
        },
        "ofPieType": {
          "enum": [
            "pie",
            "bar"
          ]
        },
        "stockKind": {
          "$ref": "#/$defs/stockKind"
        },
        "surfaceKind": {
          "$ref": "#/$defs/surfaceKind"
        }
      }
    },
    "setChartAxisTitleOp": {
      "description": "改图表坐标轴的标题。",
      "limits": "axis 不认识报 InvalidField。找不到对应主轴报 InvalidField。id 不是图表 id 报 InvalidId。找不到图报表 IdNotFound。",
      "type": "object",
      "required": [
        "op",
        "id",
        "axis",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setChartAxisTitle"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "axis": {
          "enum": [
            "cat",
            "val"
          ]
        },
        "title": {
          "type": "string"
        }
      }
    },
    "setChartLegendOp": {
      "description": "show 为 false 时忽略 pos。",
      "limits": "不认识的 pos 报 InvalidField。id 不是图表 id 报 InvalidId。",
      "type": "object",
      "required": [
        "op",
        "id",
        "show"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setChartLegend"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "show": {
          "type": "boolean"
        },
        "pos": {
          "enum": [
            "b",
            "t",
            "l",
            "r",
            "tr"
          ]
        }
      }
    },
    "setChartDataLabelsOp": {
      "description": "true：在 plotArea 写 c:dLbls，c:showVal 为 1，不调标签坐标。",
      "limits": "false：去掉 plotArea 与各系列上的 c:dLbls。id 不是图表 id 报 InvalidId。",
      "type": "object",
      "required": [
        "op",
        "id",
        "show"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setChartDataLabels"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "show": {
          "type": "boolean"
        }
      }
    },
    "trendlineType": {
      "enum": [
        "linear",
        "exp",
        "log",
        "poly",
        "power",
        "movingAvg"
      ]
    },
    "insertTrendlineOp": {
      "description": "在该 c:ser 末尾追加一条 c:trendline（插在 c:cat / c:val / c:errBars / c:extLst 之前）。",
      "limits": "poly 以外给 order、或 movingAvg 以外给 period，报 InvalidField。饼、圆环、复合饼、曲面、other、chartex 上报 InvalidField。id 不是系列 id 报 InvalidId。找不到系列报 IdNotFound。",
      "type": "object",
      "required": [
        "op",
        "id",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "insertTrendline"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/trendlineType"
        },
        "order": {
          "type": "integer",
          "minimum": 2,
          "maximum": 6
        },
        "period": {
          "type": "integer",
          "minimum": 2
        },
        "displayRSquared": {
          "type": "boolean"
        },
        "displayEquation": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "setTrendlineOp": {
      "description": "改一条趋势线。",
      "limits": "至少给一个可写字段，否则报 InvalidField。只改被点名的字段。把 type 改成非 poly 时去掉 c:order；改成非 movingAvg 时去掉 c:period。 id 不是趋势线 id 报 InvalidId。找不到报 IdNotFound。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setTrendline"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "$ref": "#/$defs/trendlineType"
        },
        "order": {
          "type": "integer",
          "minimum": 2,
          "maximum": 6
        },
        "period": {
          "type": "integer",
          "minimum": 2
        },
        "displayRSquared": {
          "type": "boolean"
        },
        "displayEquation": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "required": [
            "type"
          ]
        },
        {
          "required": [
            "order"
          ]
        },
        {
          "required": [
            "period"
          ]
        },
        {
          "required": [
            "displayRSquared"
          ]
        },
        {
          "required": [
            "displayEquation"
          ]
        },
        {
          "required": [
            "name"
          ]
        }
      ]
    },
    "deleteTrendlineOp": {
      "description": "删掉该 c:trendline。",
      "limits": "id 不是趋势线 id 报 InvalidId。找不到报 IdNotFound。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "deleteTrendline"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "insertErrorBarsOp": {
      "description": "写出一条 c:errBars。",
      "limits": "valType 为 cust 时必须给 plus 与 minus，写成 c:plus / c:minus 的 c:numLit，不必与系列点数相同。非 cust 时出现 plus / minus 报 InvalidField。lCaps 不是合法 valType，报 InvalidField。dir 为 y 或缺省时不写 c:errDir；dir 为 x 时写 c:errDir val=\"x\"。该系列已有同 dir 的误差线时报 InvalidField。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "insertErrorBars"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "dir": {
          "enum": [
            "x",
            "y"
          ]
        },
        "barType": {
          "enum": [
            "both",
            "plus",
            "minus"
          ]
        },
        "valType": {
          "enum": [
            "stdErr",
            "stdDev",
            "fixedVal",
            "percentage",
            "cust"
          ]
        },
        "value": {
          "type": "number"
        },
        "plus": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          }
        },
        "minus": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          }
        }
      }
    },
    "setErrorBarsOp": {
      "description": "改误差线。",
      "limits": "至少给一个可写字段。改成 stdErr 时去掉 c:val。改成 cust 时必须有 plus 与 minus（本 op 给的，或原节点已有）。 改成非 cust 时去掉 c:plus / c:minus。lCaps 报 InvalidField。id 不是误差线 id 报 InvalidId。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setErrorBars"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "dir": {
          "enum": [
            "x",
            "y"
          ]
        },
        "barType": {
          "enum": [
            "both",
            "plus",
            "minus"
          ]
        },
        "valType": {
          "enum": [
            "stdErr",
            "stdDev",
            "fixedVal",
            "percentage",
            "cust"
          ]
        },
        "value": {
          "type": "number"
        },
        "plus": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          }
        },
        "minus": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "dir"
          ]
        },
        {
          "required": [
            "barType"
          ]
        },
        {
          "required": [
            "valType"
          ]
        },
        {
          "required": [
            "plus"
          ]
        },
        {
          "required": [
            "minus"
          ]
        },
        {
          "required": [
            "value"
          ]
        }
      ]
    },
    "deleteErrorBarsOp": {
      "description": "删掉该 c:errBars。",
      "limits": "找不到报 IdNotFound。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "deleteErrorBars"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "setChartSeriesAxisOp": {
      "description": "把该系列所在包裹的数值轴 c:axId 指到主轴或次轴。",
      "limits": "没有次轴时按主数值轴复制一条，写 c:overlay val=\"1\"、c:crosses val=\"max\"、新的 c:axId。同一包裹里还有别的系列且目标轴不同时，把被点名系列拆到同类型的新包裹。已经是目标状态则空操作。饼、圆环、复合饼、曲面、股价、other、chartex 上报 InvalidField。axis 不认识报 InvalidField。id 不是系列 id 报 InvalidId。",
      "type": "object",
