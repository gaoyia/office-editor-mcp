{
  "$comment": "编辑用分块，由 build.py 拼进 request.schema.json。",
  "formats": {
    "insertCommentOp": [
      "xlsx",
      "docx",
      "pptx"
    ],
    "deleteCommentOp": [
      "xlsx",
      "docx",
      "pptx"
    ],
    "replyCommentOp": [
      "xlsx",
      "docx",
      "pptx"
    ],
    "setCommentTextOp": [
      "xlsx",
      "docx",
      "pptx"
    ],
    "setCommentMetaOp": [
      "xlsx",
      "docx",
      "pptx"
    ],
    "setCommentDoneOp": [
      "xlsx",
      "docx",
      "pptx"
    ]
  },
  "$defs": {
    "insertCommentOp": {
      "type": "object",
      "required": [
        "op"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "insertComment"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "string",
          "minLength": 1
        },
        "end": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "initials": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        }
      },
      "oneOf": [
        {
          "required": [
            "start",
            "end"
          ]
        },
        {
          "required": [
            "id"
          ]
        }
      ]
    },
    "deleteCommentOp": {
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "deleteComment"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "replyCommentOp": {
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "replyComment"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "initials": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "setCommentTextOp": {
      "type": "object",
      "required": [
        "op",
        "id",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setCommentText"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        }
      }
    },
    "setCommentMetaOp": {
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setCommentMeta"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string"
        },
        "initials": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "minLength": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "author"
          ]
        },
        {
          "required": [
            "initials"
          ]
        },
        {
          "required": [
            "date"
          ]
        }
      ]
    },
    "setCommentDoneOp": {
      "type": "object",
      "required": [
        "op",
        "id",
        "done"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setCommentDone"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "done": {
          "type": "boolean"
        }
      }
    }
  }
}
