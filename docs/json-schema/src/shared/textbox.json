{
  "$comment": "编辑用分块，由 build.py 拼进 request.schema.json。",
  "formats": {
    "insertTextBoxOp": [
      "xlsx",
      "docx"
    ],
    "deleteTextBoxOp": [
      "xlsx",
      "docx"
    ],
    "setTextBoxSizeOp": [
      "xlsx",
      "docx"
    ]
  },
  "$defs": {
    "insertTextBoxOp": {
      "description": "插入一个文本框。",
      "limits": "id 必须是段落 id，对图 id、框 id、容器 id、框内段落 id 或 section:{n} 报 InvalidId。找不到该段报 IdNotFound。 cx / cy 都省略时用 2 英寸宽、1 英寸高（1828800 / 914400）。只给一个时报 InvalidField。 插入浮动 anchor + wrapSquare，挂在该段末尾一个新的 w:r 里，写成 mc:AlternateContent（Choice 为 wps:wsp / wps:txbx，Fallback 为空白 w:pict，不编 VML 几何）。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "insertTextBox"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "cx": {
          "type": "integer",
          "minimum": 1
        },
        "cy": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string"
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "anchor": {
          "enum": [
            "oneCell",
            "twoCell"
          ]
        },
        "fromOffX": {
          "type": "integer",
          "minimum": 0
        },
        "fromOffY": {
          "type": "integer",
          "minimum": 0
        },
        "toOffX": {
          "type": "integer",
          "minimum": 0
        },
        "toOffY": {
          "type": "integer",
          "minimum": 0
        },
        "fromX": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fromY": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "toX": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "toY": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sz": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 100,
          "maximum": 400000
        },
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "textFill": {
          "$ref": "#/$defs/drawingTextFill"
        },
        "textOutline": {
          "$ref": "#/$defs/drawingTextOutline"
        },
        "bold": {
          "type": "boolean"
        },
        "italic": {
          "type": "boolean"
        },
        "underline": {
          "type": [
            "string",
            "null"
          ]
        },
        "font": {
          "type": "string",
          "minLength": 1
        },
        "eastAsiaFont": {
          "type": "string",
          "minLength": 1
        },
        "align": {
          "type": [
            "string",
            "null"
          ]
        },
        "textAnchor": {
          "type": [
            "string",
            "null"
          ]
        },
        "spcBef": {
          "$ref": "#/$defs/drawingTextSpacing"
        },
        "spcAft": {
          "$ref": "#/$defs/drawingTextSpacing"
        },
        "lnSpc": {
          "$ref": "#/$defs/drawingTextSpacing"
        },
        "spc": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": -400000,
          "maximum": 400000
        },
        "kern": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 400000
        }
      }
    },
    "deleteTextBoxOp": {
      "description": "删掉一个文本框。",
      "limits": "找不到该框报 IdNotFound。对段落 id、图 id、容器 id 或 section:{n} 报 InvalidId。 按框 id 删掉对应的 w:drawing；若在 mc:AlternateContent 的 Choice 里，整段 AlternateContent 删掉。 所在 w:r 若删完后只剩 w:rPr 或空，把该 run 也删掉。链接链从中间删时，把前一框的 next 接到后一框、后一框的 prev 接到前一框， 并改写 wps:txbx / linkedTxbx 的 id 与 seq。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "deleteTextBox"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "setTextBoxSizeOp": {
      "description": "字段与 setPictureSize 相同。",
      "limits": "docx 的 id 必须是框 id。xlsx 的 id 可以是文本框 id、形状 id 或连接线 id。docx 写入该框 wp:extent；若 wps:spPr/a:xfrm/a:ext 存在，一并改。xlsx 规则与图相同：oneCell / absolute 改 xdr:ext，twoCell 改右下角 to。pptx 上发此 op 报 InvalidField。",
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setTextBoxSize"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "cx": {
          "type": "integer",
          "minimum": 1
        },
        "cy": {
          "type": "integer",
          "minimum": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "toOffX": {
          "type": "integer",
          "minimum": 0
        },
        "toOffY": {
          "type": "integer",
          "minimum": 0
        }
      },
      "anyOf": [
        {
          "required": [
            "cx"
          ]
        },
        {
          "required": [
            "cy"
          ]
        },
        {
          "required": [
            "to"
          ]
        }
      ]
    }
  }
}
