{
  "$comment": "编辑用分块，由 build.py 拼进 request.schema.json。",
  "$defs": {
    "format": {
      "enum": [
        "xlsx",
        "xlsm",
        "docx",
        "pptx"
      ]
    },
    "inspectRequest": {
      "description": "按 scope 看文件的一部分。",
      "descriptionEn": "View part of the file according to scope.",
      "limits": "不要一次要整份文件。改内容用 apply，不要把这次看到的树整份送回去当修改。",
      "limitsEn": "Do not request the whole file at once. To change content, use apply. Do not send the whole tree you just saw back as the edit.",
      "type": "object",
      "required": [
        "action",
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "action": {
          "const": "inspect"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "$ref": "#/$defs/format"
        },
        "scope": {
          "$ref": "#/$defs/inspectScope"
        },
        "locale": {
          "type": "string"
        }
      }
    },
    "inspectScope": {
      "description": "查看范围。",
      "descriptionEn": "Scope to view.",
      "limits": "三种格式的键不能混用。xlsx 看格子要同时给 sheet 和 range。没列出的键不要写。",
      "limitsEn": "Do not mix keys from the three formats. To view xlsx cells, give both sheet and range. Do not write keys that are not listed.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sheet": {
          "type": "string",
          "minLength": 1
        },
        "range": {
          "type": "string",
          "minLength": 1
        },
        "maxCells": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "from": {
          "type": "integer",
          "minimum": 1
        },
        "maxParas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        },
        "headerFooter": {
          "type": "boolean"
        },
        "pictures": {
          "type": "boolean"
        },
        "textBoxes": {
          "type": "boolean"
        },
        "shapes": {
          "type": "boolean"
        },
        "textBoxContent": {
          "type": "boolean"
        },
        "notes": {
          "type": "boolean"
        },
        "comments": {
          "type": "boolean"
        },
        "charts": {
          "type": "boolean"
        },
        "smartArt": {
          "type": "boolean"
        },
        "slicers": {
          "type": "boolean"
        },
        "protectedRanges": {
          "type": "boolean"
        },
        "connections": {
          "type": "boolean"
        },
        "externalLinks": {
          "type": "boolean"
        },
        "customViews": {
          "type": "boolean"
        },
        "cellStyles": {
          "type": "boolean"
        },
        "oleObjects": {
          "type": "boolean"
        },
        "watermarks": {
          "type": "boolean"
        },
        "tables": {
          "type": "boolean"
        },
        "connectors": {
          "type": "boolean"
        },
        "inkCanvases": {
          "type": "boolean"
        },
        "model3ds": {
          "type": "boolean"
        },
        "inks": {
          "type": "boolean"
        },
        "timing": {
          "type": "boolean"
        },
        "masters": {
          "type": "boolean"
        },
        "notesMaster": {
          "type": "boolean"
        },
        "handout": {
          "type": "boolean"
        },
        "media": {
          "type": "boolean"
        },
        "sections": {
          "type": "boolean"
        },
        "customShows": {
          "type": "boolean"
        },
        "zooms": {
          "type": "boolean"
        },
        "revisions": {
          "type": "boolean"
        },
        "hyperlinks": {
          "type": "boolean"
        },
        "sparklines": {
          "type": "boolean"
        },
        "bookmarks": {
          "type": "boolean"
        },
        "editRanges": {
          "type": "boolean"
        },
        "fields": {
          "type": "boolean"
        },
        "tocs": {
          "type": "boolean"
        },
        "captions": {
          "type": "boolean"
        },
        "crossRefs": {
          "type": "boolean"
        },
        "indexes": {
          "type": "boolean"
        },
        "indexEntries": {
          "type": "boolean"
        },
        "sources": {
          "type": "boolean"
        },
        "citations": {
          "type": "boolean"
        },
        "bibliographies": {
          "type": "boolean"
        },
        "docParts": {
          "type": "boolean"
        },
        "embeddedFonts": {
          "type": "boolean"
        },
        "maths": {
          "type": "boolean"
        },
        "contentControls": {
          "type": "boolean"
        },
        "numbering": {
          "type": "boolean"
        },
        "styles": {
          "type": "boolean"
        },
        "runs": {
          "type": "boolean"
        },
        "rubies": {
          "type": "boolean"
        },
        "slide": {
          "type": "integer",
          "minimum": 1
        },
        "maxShapes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        }
      },
      "dependentRequired": {
        "range": [
          "sheet"
        ],
        "sheet": [
          "range"
        ],
        "from": [
          "maxParas"
        ],
        "maxParas": [
          "from"
        ],
        "maxShapes": [
          "slide"
        ],
        "textBoxContent": [
          "textBoxes"
        ]
      }
    },
    "createRequest": {
      "description": "只用于新建文件。",
      "descriptionEn": "Only for creating a new file.",
      "limits": "已经存在的文件用 apply。xlsx 用 workbook，docx 用 document，pptx 用 presentation，三者不要同时写。",
      "limitsEn": "A file that already exists uses apply. xlsx uses workbook, docx uses document, and pptx uses presentation. Do not write all three together.",
      "type": "object",
      "comment": "path 必填。xlsx 用 workbook，docx 用 document，pptx 用 presentation，三者不能同时出现。",
      "required": [
        "action"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "action": {
          "const": "create"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "$ref": "#/$defs/format"
        },
        "workbook": {
          "$ref": "#/$defs/xlsxWorkbook"
        },
        "document": {
          "$ref": "#/$defs/docxDocument"
        },
        "presentation": {
          "$ref": "#/$defs/pptxPresentation"
        },
        "locale": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "required": [
            "workbook"
          ]
        },
        {
          "required": [
            "document"
          ]
        },
        {
          "required": [
            "presentation"
          ]
        }
      ]
    },
    "exportMediaRequest": {
      "description": "按 id 把图或嵌入对象的原始字节写到本地。",
      "descriptionEn": "Write the original bytes of a picture or an embedded object to a local file, by id.",
      "limits": "不改源文件，字节也不进 inspect 树。",
      "limitsEn": "Does not modify the source file, and the bytes are not placed in the inspect tree.",
      "type": "object",
      "comment": "output 必填。不得默认写成源 path。",
      "required": [
        "action",
        "path",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "action": {
          "const": "exportMedia"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "$ref": "#/$defs/format"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "output": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "type": "string"
        }
      }
    },
    "applyRequest": {
      "description": "用 id 和 op 改文件里点名的内容。",
      "descriptionEn": "Use id and op to change the named content in the file.",
      "limits": "不要把整棵 inspect 树塞进请求。",
      "limitsEn": "Do not send the whole inspect tree back as the edit.",
      "type": "object",
      "required": [
        "action",
        "path",
        "ops"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "action": {
          "const": "apply"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "$ref": "#/$defs/format"
        },
        "output": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "type": "string"
        },
        "ops": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/anyApplyOp"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "format": {
                "enum": [
                  "xlsx",
                  "xlsm"
                ]
              }
            },
            "required": [
              "format"
            ]
          },
          "then": {
            "properties": {
              "ops": {
                "items": {
                  "$ref": "#/$defs/xlsxApplyOp"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "format": {
                "const": "docx"
              }
            },
            "required": [
              "format"
            ]
          },
          "then": {
            "properties": {
              "ops": {
                "items": {
                  "$ref": "#/$defs/docxApplyOp"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "format": {
                "const": "pptx"
              }
            },
            "required": [
              "format"
            ]
          },
          "then": {
            "properties": {
              "ops": {
                "items": {
                  "$ref": "#/$defs/pptxApplyOp"
                }
              }
            }
          }
        }
      ]
    },
    "exportChartDataRequest": {
      "description": "把图表背后的工作簿数据导出。",
      "descriptionEn": "Export the workbook data behind a chart.",
      "limits": "不改源文件，不算公式。",
      "limitsEn": "Does not modify the source file and does not evaluate formulas.",
      "type": "object",
      "comment": "output 必填。不得默认写成源 path。",
      "required": [
        "action",
        "path",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "action": {
          "const": "exportChartData"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "$ref": "#/$defs/format"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "output": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "type": "string"
        }
      }
    },
    "helpRequest": {
      "description": "查某个操作怎么填。",
      "descriptionEn": "Look up how to fill in an operation.",
      "limits": "先搜再打开。不要猜字段，也不要把别的格式的字段套过来。本工具不支持预览，也不把页面画成图。机器上有 Microsoft Office 或 WPS 时，可以自己导出后再查看：Word、Excel，以及 WPS 的 kwps、ket，用 ExportAsFixedFormat 写成 PDF；PowerPoint 和 WPS 的 kwpp 用幻灯片的 Export 写成 PNG。本工具不调用它们。",
      "limitsEn": "Search first, then open one operation. Do not guess fields, and do not reuse fields from another format. This tool does not preview a document and does not render pages as images. If Microsoft Office or WPS is installed, export and then look: Word, Excel, and WPS kwps and ket use ExportAsFixedFormat to write a PDF; PowerPoint and WPS kwpp use the slide Export method to write a PNG. This tool does not call them.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "action": {
          "const": "help"
        },
        "format": {
          "$ref": "#/$defs/format"
        },
        "q": {
          "type": "string",
          "minLength": 1
        },
        "op": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "not": {
            "required": [
              "op",
              "name"
            ]
          }
        },
        {
          "not": {
            "required": [
              "q",
              "op"
            ]
          }
        },
        {
          "not": {
            "required": [
              "q",
              "name"
            ]
          }
        }
      ]
    }
  }
}
