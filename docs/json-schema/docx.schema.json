{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ooxp.local/schema/v1/docx.schema.json",
  "title": "ooxp docx $defs",
  "$comment": "供 request.schema.json 引用，不是独立的完整请求 schema。",
  "$defs": {
    "docxDocument": {
      "type": "object",
      "required": [
        "paragraphs"
      ],
      "additionalProperties": false,
      "properties": {
        "paragraphs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/docxParaCreate"
          }
        },
        "tables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/docxTableCreate"
          }
        },
        "headers": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/docxHfCreate"
          }
        },
        "footers": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/docxHfCreate"
          }
        },
        "props": {
          "$ref": "request.schema.json#/$defs/createProps"
        },
        "protection": {
          "$ref": "request.schema.json#/$defs/createProtection"
        },
        "watermarks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/createWatermark"
          }
        }
      }
    },
    "docxHfCreate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "default",
            "even",
            "first"
          ]
        },
        "paragraphs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/docxHfParaCreate"
          }
        },
        "tables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/docxTableCreate"
          }
        }
      }
    },
    "docxTableCreate": {
      "type": "object",
      "required": [
        "cells"
      ],
      "additionalProperties": false,
      "properties": {
        "after": {
          "type": "integer",
          "minimum": 0
        },
        "cells": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 63,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "docxHfParaCreate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "pictures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/docxPictureCreate"
          }
        },
        "smartArts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/docxSmartArtCreate"
          }
        },
        "charts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/docxChartCreate"
          }
        },
        "oleObjects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/docxOleCreate"
          }
        },
        "footnote": {
          "type": "string"
        },
        "endnote": {
          "type": "string"
        },
        "comments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/docxCommentCreate"
          }
        }
      }
    },
    "docxParaCreate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "style": {
          "type": "string",
          "enum": [
            "Normal",
            "Heading1",
            "Heading2",
            "Heading3"
          ]
        },
        "sectionType": {
          "enum": [
            "nextPage",
            "continuous",
            "evenPage",
            "oddPage",
            "nextColumn"
          ]
        },
        "textBoxes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/docxTextBoxCreate"
          }
        },
        "pictures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/docxPictureCreate"
          }
        },
        "smartArts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/docxSmartArtCreate"
          }
        },
        "charts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/docxChartCreate"
          }
        },
        "oleObjects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/docxOleCreate"
          }
        },
        "footnote": {
          "type": "string"
        },
        "endnote": {
          "type": "string"
        },
        "comments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/docxCommentCreate"
          }
        }
      }
    },
    "docxOleCreate": {
      "type": "object",
      "required": [
        "file"
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "docxChartCreate": {
      "type": "object",
      "required": [
        "type",
        "series"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "request.schema.json#/$defs/insertChartType"
        },
        "ofPieType": {
          "enum": [
            "pie",
            "bar"
          ]
        },
        "title": {
          "type": "string"
        },
        "series": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              {
                "$ref": "request.schema.json#/$defs/chartSeriesData"
              },
              {
                "required": [
                  "values"
                ]
              }
            ]
          }
        },
        "kind": {
          "enum": [
            "inline",
            "anchor"
          ]
        },
        "wrap": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "square",
            "tight",
            "through",
            "topAndBottom",
            "none",
            null
          ]
        },
        "cx": {
          "type": "integer",
          "minimum": 1
        },
        "cy": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "docxCommentCreate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "initials": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "docxPictureCreate": {
      "type": "object",
      "required": [
        "file"
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "cx": {
          "type": "integer",
          "minimum": 1
        },
        "cy": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "enum": [
            "inline",
            "anchor"
          ]
        },
        "wrap": {
          "enum": [
            "square",
            "tight",
            "through",
            "topAndBottom",
            "none"
          ]
        },
        "alignH": {
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "alignV": {
          "enum": [
            "top",
            "center",
            "bottom"
          ]
        },
        "offsetX": {
          "type": "integer"
        },
        "offsetY": {
          "type": "integer"
        }
      }
    },
    "docxTextBoxCreate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "cx": {
          "type": "integer",
          "minimum": 1
        },
        "cy": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "docxSmartArtCreate": {
      "type": "object",
      "required": [
        "layout"
      ],
      "additionalProperties": false,
      "properties": {
        "layout": {
          "$ref": "request.schema.json#/$defs/smartArtLayout"
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "request.schema.json#/$defs/smartArtPointInput"
          }
        },
        "kind": {
          "enum": [
            "inline",
            "anchor"
          ]
        },
        "wrap": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "square",
            "tight",
            "through",
            "topAndBottom",
            "none",
            null
          ]
        },
        "cx": {
          "type": "integer",
          "minimum": 1
        },
        "cy": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "setParaTextOp": {
      "type": "object",
      "required": [
        "op",
        "id",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setParaText"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        }
      }
    },
    "setHeaderFooterDistanceOp": {
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setHeaderFooterDistance"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "headerDistance": {
          "type": "integer",
          "minimum": 0
        },
        "footerDistance": {
          "type": "integer",
          "minimum": 0
        }
      },
      "anyOf": [
        {
          "required": [
            "headerDistance"
          ]
        },
        {
          "required": [
            "footerDistance"
          ]
        }
      ]
    },
    "setHeaderFooterLinkOp": {
      "type": "object",
      "required": [
        "op",
        "id",
        "kind",
        "type",
        "linked"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setHeaderFooterLink"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "header",
            "footer"
          ]
        },
        "type": {
          "enum": [
            "default",
            "even",
            "first"
          ]
        },
        "linked": {
          "type": "boolean"
        }
      }
    },
    "insertHeaderFooterOp": {
      "type": "object",
      "required": [
        "op",
        "id",
        "kind",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "insertHeaderFooter"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "header",
            "footer"
          ]
        },
        "type": {
          "enum": [
            "default",
            "even",
            "first"
          ]
        }
      }
    },
    "insertSectionOp": {
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "insertSection"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "nextPage",
            "continuous",
            "evenPage",
            "oddPage",
            "nextColumn"
          ]
        }
      }
    },
    "deleteSectionOp": {
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "deleteSection"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "setTitlePageOp": {
      "type": "object",
      "required": [
        "op",
        "id",
        "titlePage"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setTitlePage"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "titlePage": {
          "type": "boolean"
        }
      }
    },
    "setEvenAndOddHeadersOp": {
      "type": "object",
      "required": [
        "op",
        "id",
        "evenAndOdd"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setEvenAndOddHeaders"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "evenAndOdd": {
          "type": "boolean"
        }
      }
    },
    "setPageMarginOp": {
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setPageMargin"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "top": {
          "type": "integer"
        },
        "bottom": {
          "type": "integer"
        },
        "left": {
          "type": "integer",
          "minimum": 0
        },
        "right": {
          "type": "integer",
          "minimum": 0
        },
        "gutter": {
          "type": "integer",
          "minimum": 0
        }
      },
      "anyOf": [
        {
          "required": [
            "top"
          ]
        },
        {
          "required": [
            "bottom"
          ]
        },
        {
          "required": [
            "left"
          ]
        },
        {
          "required": [
            "right"
          ]
        },
        {
          "required": [
            "gutter"
          ]
        }
      ]
    },
    "setPageSizeOp": {
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setPageSize"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "pageWidth": {
          "type": "integer",
          "minimum": 0
        },
        "pageHeight": {
          "type": "integer",
          "minimum": 0
        },
        "orient": {
          "enum": [
            "portrait",
            "landscape"
          ]
        }
      },
      "anyOf": [
        {
          "required": [
            "pageWidth"
          ]
        },
        {
          "required": [
            "pageHeight"
          ]
        },
        {
          "required": [
            "orient"
          ]
        }
      ]
    },
    "setColumnsOp": {
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setColumns"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "num": {
          "type": "integer",
          "minimum": 1
        },
        "space": {
          "type": "integer",
          "minimum": 0
        },
        "equalWidth": {
          "type": "boolean"
        },
        "sep": {
          "type": "boolean"
        },
        "cols": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 0
              },
              "space": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "enabled": {
          "const": false
        }
      }
    },
    "setVerticalAlignOp": {
      "type": "object",
      "required": [
        "op",
        "id",
        "vAlign"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setVerticalAlign"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "vAlign": {
          "anyOf": [
            {
              "enum": [
                "top",
                "center",
                "both",
                "bottom"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "setLineNumberingOp": {
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setLineNumbering"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "countBy": {
          "type": "integer",
          "minimum": 0
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "distance": {
          "type": "integer",
          "minimum": 0
        },
        "restart": {
          "enum": [
            "newPage",
            "newSection",
            "continuous"
          ]
        },
        "enabled": {
          "const": false
        }
      }
    },
    "setDocGridOp": {
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setDocGrid"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "default",
            "lines",
            "linesAndChars",
            "snapToChars"
          ]
        },
        "linePitch": {
          "type": "integer"
        },
        "charSpace": {
          "type": "integer"
        },
        "enabled": {
          "const": false
        }
      }
    },
    "setRtlGutterOp": {
      "type": "object",
      "required": [
        "op",
        "id",
        "rtlGutter"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setRtlGutter"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "rtlGutter": {
          "type": "boolean"
        }
      }
    },
    "setMirrorMarginsOp": {
      "type": "object",
      "required": [
        "op",
        "id",
        "mirrorMargins"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setMirrorMargins"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "mirrorMargins": {
          "type": "boolean"
        }
      }
    },
    "setGutterAtTopOp": {
      "type": "object",
      "required": [
        "op",
        "id",
        "gutterAtTop"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setGutterAtTop"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "gutterAtTop": {
          "type": "boolean"
        }
      }
    },
    "setPictureWrapOp": {
      "type": "object",
      "required": [
        "op",
        "id",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setPictureWrap"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "inline",
            "anchor"
          ]
        },
        "wrap": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "square",
            "tight",
            "through",
            "topAndBottom",
            "none",
            null
          ]
        },
        "alignH": {
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "alignV": {
          "enum": [
            "top",
            "center",
            "bottom"
          ]
        },
        "offsetX": {
          "type": "integer"
        },
        "offsetY": {
          "type": "integer"
        }
      }
    },
    "setTextBoxWrapOp": {
      "type": "object",
      "required": [
        "op",
        "id",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setTextBoxWrap"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "inline",
            "anchor"
          ]
        },
        "wrap": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "square",
            "tight",
            "through",
            "topAndBottom",
            "none",
            null
          ]
        },
        "alignH": {
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "alignV": {
          "enum": [
            "top",
            "center",
            "bottom"
          ]
        },
        "offsetX": {
          "type": "integer"
        },
        "offsetY": {
          "type": "integer"
        }
      }
    },
    "setTextBoxFillOp": {
      "type": "object",
      "required": [
        "op",
        "id",
        "color"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setTextBoxFill"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "color": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "setTextBoxLineOp": {
      "type": "object",
      "required": [
        "op",
        "id",
        "color"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setTextBoxLine"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "setTextBoxDirectionOp": {
      "type": "object",
      "required": [
        "op",
        "id",
        "direction"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setTextBoxDirection"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "horizontal",
            "vertical"
          ]
        }
      }
    },
    "insertParaOp": {
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "insertPara"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        }
      }
    },
    "deleteParaOp": {
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "deletePara"
        },
