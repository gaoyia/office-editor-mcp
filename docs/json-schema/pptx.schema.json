{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ooxp.local/schema/v1/pptx.schema.json",
  "title": "ooxp pptx $defs",
  "$comment": "供 request.schema.json 引用，不是独立的完整请求 schema。",
  "$defs": {
    "pptxPresentation": {
      "type": "object",
      "required": [
        "slides"
      ],
      "additionalProperties": false,
      "properties": {
        "slides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pptxSlideCreate"
          }
        },
        "props": {
          "$ref": "request.schema.json#/$defs/createProps"
        }
      }
    },
    "pptxSlideCreate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shapes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pptxShapeCreate"
          }
        },
        "pictures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pptxPictureCreate"
          }
        },
        "charts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pptxChartCreate"
          }
        },
        "smartArts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pptxSmartArtCreate"
          }
        },
        "tables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pptxTableCreate"
          }
        },
        "notes": {
          "type": "string"
        },
        "comments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pptxCommentCreate"
          }
        }
      }
    },
    "pptxSmartArtCreate": {
      "type": "object",
      "required": [
        "layout"
      ],
      "additionalProperties": false,
      "properties": {
        "layout": {
          "$ref": "request.schema.json#/$defs/smartArtLayout"
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "request.schema.json#/$defs/smartArtPointInput"
          }
        },
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "cx": {
          "type": "integer",
          "minimum": 1
        },
        "cy": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "pptxTableCreate": {
      "type": "object",
      "required": [
        "rows",
        "cols"
      ],
      "additionalProperties": false,
      "properties": {
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "cols": {
          "type": "integer",
          "minimum": 1,
          "maximum": 75
        },
        "cells": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "cx": {
          "type": "integer",
          "minimum": 1
        },
        "cy": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "pptxCommentCreate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "initials": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "pptxChartCreate": {
      "type": "object",
      "required": [
        "type",
        "series"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "request.schema.json#/$defs/insertChartType"
        },
        "title": {
          "type": "string"
        },
        "series": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              {
                "$ref": "request.schema.json#/$defs/chartSeriesData"
              },
              {
                "required": [
                  "values"
                ]
              }
            ]
          }
        },
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "cx": {
          "type": "integer",
          "minimum": 1
        },
        "cy": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "pptxPictureCreate": {
      "type": "object",
      "required": [
        "file"
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "cx": {
          "type": "integer",
          "minimum": 1
        },
        "cy": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "pptxShapeCreate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        }
      }
    },
    "setPicturePosOp": {
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setPicturePos"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        }
      },
      "anyOf": [
        {
          "required": [
            "x"
          ]
        },
        {
          "required": [
            "y"
          ]
        }
      ]
    },
    "setChartPosOp": {
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setChartPos"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        }
      },
      "anyOf": [
        {
          "required": [
            "x"
          ]
        },
        {
          "required": [
            "y"
          ]
        }
      ]
    },
    "setSmartArtPosOp": {
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setSmartArtPos"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        }
      },
      "anyOf": [
        {
          "required": [
            "x"
          ]
        },
        {
          "required": [
            "y"
          ]
        }
      ]
    },
    "setNotesTextOp": {
      "type": "object",
      "required": [
        "op",
        "id",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setNotesText"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        }
      }
    },
    "insertShapeOp": {
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "insertShape"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "cx": {
          "type": "integer",
          "minimum": 1
        },
        "cy": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "deleteShapeOp": {
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "deleteShape"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "setShapePosOp": {
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setShapePos"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        }
      },
      "anyOf": [
        {
          "required": [
            "x"
          ]
        },
        {
          "required": [
            "y"
          ]
        }
      ]
    },
    "setShapeSizeOp": {
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setShapeSize"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "cx": {
          "type": "integer",
          "minimum": 1
        },
        "cy": {
          "type": "integer",
          "minimum": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "cx"
          ]
        },
        {
          "required": [
            "cy"
          ]
        }
      ]
    },
    "setShapeFillOp": {
      "type": "object",
      "required": [
        "op",
        "id",
        "color"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setShapeFill"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "color": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "setShapeLineOp": {
      "type": "object",
      "required": [
        "op",
        "id",
        "color"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setShapeLine"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "color": {
          "type": [
            "string",
            "null"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "setTableCellTextOp": {
      "type": "object",
      "required": [
        "op",
        "id",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setTableCellText"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        }
      }
    },
    "setTablePosOp": {
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setTablePos"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "setTableSizeOp": {
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setTableSize"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "cx": {
          "type": "integer",
          "minimum": 1
        },
        "cy": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "insertSlideOp": {
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "insertSlide"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "after": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "deleteSlideOp": {
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "deleteSlide"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "moveSlideOp": {
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "moveSlide"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "after": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "setSlideHiddenOp": {
      "type": "object",
      "required": [
        "op",
        "id",
        "hidden"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setSlideHidden"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "hidden": {
          "type": "boolean"
        }
      }
    },
    "setTransitionOp": {
      "type": "object",
      "required": [
        "op",
        "id",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setTransition"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": [
            "string",
            "null"
          ]
        },
        "dur": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        }
      }
    },
    "insertAnimOp": {
      "type": "object",
      "required": [
        "op",
        "id",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "insertAnim"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "type": "string",
          "enum": [
            "click",
            "with",
            "after"
          ]
        }
      }
    },
    "deleteAnimOp": {
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "deleteAnim"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "setSlideLayoutOp": {
      "type": "object",
      "required": [
        "op",
        "id",
        "layout"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setSlideLayout"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "layout": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "setHandoutTextOp": {
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setHandoutText"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "header": {
          "type": "string"
        },
        "footer": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "sldNum": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "required": [
            "header"
          ]
        },
        {
          "required": [
            "footer"
          ]
        },
        {
          "required": [
            "date"
          ]
        },
        {
          "required": [
            "sldNum"
          ]
        }
      ]
    },
    "insertVideoOp": {
      "type": "object",
      "required": [
        "op",
        "id",
        "file"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "insertVideo"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "cx": {
          "type": "integer",
          "minimum": 1
        },
        "cy": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "insertAudioOp": {
      "type": "object",
      "required": [
        "op",
        "id",
        "file"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "insertAudio"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "cx": {
          "type": "integer",
          "minimum": 1
        },
        "cy": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "deleteMediaOp": {
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "deleteMedia"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "insertSlideSectionOp": {
      "type": "object",
      "required": [
        "op",
        "id",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "insertSlideSection"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "start": {
          "type": "string",
          "minLength": 1
        },
        "after": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "setSlideSectionNameOp": {
      "type": "object",
      "required": [
        "op",
        "id",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setSlideSectionName"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        }
      }
    },
    "deleteSlideSectionOp": {
      "type": "object",
      "required": [
        "op",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "deleteSlideSection"
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "setSlideSectionOp": {
      "type": "object",
      "required": [
        "op",
        "id",
        "section"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "setSlideSection"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
