{
  "schemaVersion": 1,
  "action": "create",
  "path": "book.xlsx",
  "format": "xlsx",
  "workbook": {
    "cellStyles": [
      {
        "name": "OoxpNamed",
        "font": { "bold": true },
        "fill": { "pattern": "solid", "fg": { "rgb": "FFFFFF00" } }
      }
    ],
    "sheets": [
      {
        "name": "Sheet1",
        "cells": [
          { "ref": "A1", "value": 1.2, "namedStyle": "OoxpNamed" },
          { "ref": "B1", "value": 3 }
        ],
        "comments": [
          {
            "cell": "A1",
            "text": "顶层批注",
            "replies": [{ "text": "一层回复", "author": "Bob" }]
          }
        ]
      }
    ]
  }
}
