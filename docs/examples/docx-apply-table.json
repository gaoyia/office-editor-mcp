{
  "schemaVersion": 1,
  "action": "apply",
  "path": "note.docx",
  "output": "note.table.docx",
  "ops": [
    {
      "op": "insertTable",
      "id": "docx:document",
      "rows": 2,
      "cols": 2,
      "cells": [
        ["A1", "B1"],
        ["A2", "B2"]
      ]
    },
    { "op": "insertRow", "id": "table:1" },
    { "op": "insertCol", "id": "table:1", "after": 1 },
    {
      "op": "mergeCells",
      "id": "table:1",
      "startRow": 1,
      "startCol": 1,
      "endRow": 1,
      "endCol": 2
    }
  ]
}
