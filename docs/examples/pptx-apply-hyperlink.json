{
  "schemaVersion": 1,
  "action": "apply",
  "path": "deck.pptx",
  "output": "deck.link.pptx",
  "ops": [
    {
      "op": "insertHyperlink",
      "id": "slide:1/shape:2",
      "url": "https://example.com"
    },
    {
      "op": "setHyperlink",
      "id": "slide:1/link:1",
      "url": "https://example.org"
    },
    {
      "op": "insertHyperlink",
      "id": "slide:1/shape:3",
      "slide": "slide:2"
    },
    {
      "op": "insertHyperlink",
      "id": "slide:1/shape:2",
      "on": "run",
      "url": "https://example.com/run"
    },
    {
      "op": "insertHyperlink",
      "id": "slide:1/shape:2",
      "event": "hover",
      "url": "https://example.com/hover"
    },
    {
      "op": "insertHyperlink",
      "id": "slide:1/pic:4",
      "url": "https://example.com/pic"
    },
    {
      "op": "deleteHyperlink",
      "id": "slide:1/link:1"
    }
  ]
}
